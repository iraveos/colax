// Cross-file data models shared by the engine bridge and the screens.
export enum Screen {
    Error,
    CreateChoose,
    CreatePassword,
    CreateConfirm,
    UnlockPassword,
    UnlockDevice,
    ImportPassword,
    Vault,
    /// Editing one login, or creating a new one (`edit-id == ""`).
    Editor,
}

/// Where the sidebar rail sits: `--sidebarPosition` in the preferences.
export enum RailPosition {
    Left,
    Right,
    Top,
    Bottom,
}

/// The four card layouts: `Flow` (animated list), `Orbit` (carousel),
/// `List` (basic), `Grid` — matching `VaultView` in storage.ts.
export enum ViewKind {
    Flow,
    Orbit,
    List,
    Grid,
}

/// One row of the vault list. Deliberately holds no secret: passwords stay
/// in the engine and are fetched by id when the user asks to copy one.
/// `tile` is the accent colour for the row's icon, computed in Rust.
export struct ItemRow {
    id: string,
    title: string,
    username: string,
    subtitle: string,
    initial: string,
    tile: color,
}

/// A health badge on a card: "weak", "stale", "reused", "secured".
/// `tone` picks the colour: 0 neutral, 1 warn, 2 danger, 3 good, 4 info.
export struct Badge {
    label: string,
    tone: int,
}

/// A tag pill. `compact` drops it to the one-line form used in list rows.
export struct TagChip {
    name: string,
    hue: color,
    compact: bool,
}

/// One colour preset in the editor's Appearance section, the `HUE_PRESETS`
/// of `ItemEditor.tsx` L879. `hue` is -1 for "Auto" — not a hue but the
/// choice to *derive* one from the title, so the Auto chip is a sweep of the
/// calm set rather than a single colour, and the row can still say which
/// entry the draft is on.
export struct HueSwatch {
    label: string,
    hue: float,
    from: color,
    to: color,
}

// One recovery question in the editor's Security section. The *answer* is
// never here: only its id, so a row can be removed or checked, and the
// prompt, so the row can be read. This mirrors `SecurityQuestion` in
// `colax-core::model`, minus the hash and salt, which the screen has no
// business holding.
export struct QuestionRow {
    id: string,
    prompt: string,
}

/// One *dark* module of the QR symbol in the editor's Security section, in
/// module units measured from the symbol's top-left. Only the dark half is
/// shipped -- a symbol is half light -- and row and column stay two fields
/// rather than one flat index because Slint has no `%`, and no integer
/// divide it will promise to truncate, to split an index back apart again.
export struct QrCell {
    col: int,
    row: int,
}

/// One tag as the editor's Organise picker draws it: what to call it, which
/// colour it wears, whether this login carries it.
///
/// Deliberately no width. Slint has no wrapping layout, so Rust splits the
/// catalogue into lines (`pack_tag_rows`) -- but only the *breaks* are Rust's:
/// each pill hugs its own label here, exactly as `Chip` already does in the
/// generator's row, and Rust packs against a per-character estimate that errs
/// long. An estimate that is too long ends a line a pill early; one that is
/// too short would run two pills together, which `clip` on the cloud turns
/// into a cut label rather than a collision.
export struct PickTag {
    id: string,
    name: string,
    hue: color,
    selected: bool,
}

/// One accent chip in the Appearance grid, and the same four in the channel
/// editor's Theme row. Built in Rust from the same `accent_hues` table that
/// paints the app (ADR-2), because Slint has no `hsl()` builtin and the TS
/// gradient `hsl(from 40% 56%)` has to be resolved somewhere that can do the
/// maths.
export struct AccentChip {
    id: string,
    label: string,
    from: color,
    to: color,
}

/// One row of Settings › Channels (ChannelManager.tsx L150-230): which channel,
/// what it is called, the colour its dot wears, how many logins its filter
/// returns, and the one-line detail under the name — the count followed by
/// either its kind's name or the names of the tags it watches.
///
/// `builtin` draws the "built-in" badge, `hidden` drives the eye and the
/// dimmed name; `locked` is what takes Delete off the shared editor, and it
/// is the *role* rather than the badge that decides (the TS gates on
/// `locked`, so a shipped Favorites can be deleted and a user's Dashboard
/// cannot).
export struct ChannelRow {
    id: string,
    name: string,
    hue: color,
    count: int,
    detail: string,
    builtin: bool,
    hidden: bool,
    locked: bool,
}

/// One row of the tags half of Settings › Channels: what the tag is called,
/// its colour, how much of the vault uses it, and the two transient states
/// the row itself owns — the name being edited in place, and the hue range
/// being open. Both are one-at-a-time in the TS (a `click` opens, a `blur`
/// commits), so Rust keeps the id that holds each and this row only asks.
export struct TagRow {
    id: string,
    name: string,
    hue: color,
    hue-value: int,
    usage: string,
    editing: bool,
    hue-open: bool,
}

/// One key of the channel editor's icon picker. Slint has no Lucide set, so
/// the "icon" is a text glyph from the port's own alphabet — including
/// `clock`, which the TS's own table has no entry for and draws as `layers`.
export struct IconOption {
    key: string,
    glyph: string,
}

/// One row of Settings › Optimize's saved profiles: which look it is, when
/// it was taken (`new Date(createdAt).toLocaleDateString()`, built in Rust
/// the way the history groups spell dates), and whether it is the look on
/// screen — the tick. The rename draft is the window's own property, so the
/// row asks nothing of the model while it is being retyped.
export struct OptProfileRow {
    id: string,
    name: string,
    meta: string,
    active: bool,
}

/// One row of a context menu (Task 8.1): `MenuItem` in context-menu.tsx,
/// flattened for the wire. `kind` picks the row shape -- 0 a selectable item,
/// 1 a separator, 2 a non-interactive heading inside a submenu. `id` names the
/// action (`menu-picked` dispatches on it), `shortcut` is the right-aligned
/// hint, and the four flags are exactly the TS's: `sub` draws the arrow and
/// arms the submenu, `checked` the tick, `danger` red, `disabled` grey. The
/// TS's per-row icons are not ported yet -- the renderer has no icon column
/// (see menus.rs) -- so the rows read on their labels alone.
export struct MenuRow {
    id: string,
    label: string,
    shortcut: string,
    kind: int,
    sub: bool,
    disabled: bool,
    danger: bool,
    checked: bool,
}

/// One row of the shortcuts sheet (Task 8.2): the sentence on the left and
/// the key caps on the right. `keys` is a list because the TS draws each
/// chord as its own `.kbd` chip ("Alt" and "1–9" are two caps, not one
/// string) -- the sheet walks them into a row of chips.
export struct ShortcutRow {
    label: string,
    keys: [string],
}

/// One login, ready to render. Built in Rust from a `VaultItem`, so the
/// plaintext password is *not* here: `masked-password` is dots, and reveal
/// asks the engine by id (Task 3.6 / Phase 6's SecurityGate).
export struct LoginCard {
    id: string,
    // labelOf: title || username || hostname || "Untitled"
    label: string,
    title: string,
    username: string,
    hostname: string,
    url: string,
    initial: string,
    // accent_of() over the title -> solid tile colour.
    tile: color,
    favorite: bool,
    needs-attention: bool,
    has-totp: bool,
    // Empty when the login has no TOTP; Rust owns the clock.
    totp-code: string,
    totp-remaining: int,
    badges: [Badge],
    tags: [TagChip],
    notes: string,
    // Always dots. The plaintext only crosses this boundary on reveal.
    masked-password: string,
    // "Password 2 days ago · Username last week"
    modified-note: string,
    // Gates reveal/edit behind the security gate.
    secured: bool,
    selected: bool,
    duplicate: bool,
    // Letter-group header for the list view: the letter to print above this
    // card, or empty when it starts no group. Rust fills it only where the
    // sort and the grouping agree (`group_by_letter` in items.rs).
    group: string,
    // Per-card accent hue, for the card's own gradient.
    hue: int,
    has-image: bool,
    image: image,
}

/// One sidebar row: a channel, a folder, or a separator between sections.
/// `kind` is 0 channel, 1 folder, 2 separator. Counts and selection are
/// computed in Rust so the sidebar never has to know the filtering rules.
export struct SidebarRow {
    id: string,
    kind: int,
    label: string,
    icon: string,
    hue: color,
    count: int,
    depth: int,
    expanded: bool,
    hidden: bool,
    locked: bool,
    selected: bool,
    is-builtin: bool,
}

/// One row of a Rust-built menu. The sort dropdown is the only one so far;
/// `id` is the pref value the row writes and `label` is what the TS menu
/// called it (`SORT_LABELS`, App.tsx L110-117), so the checkmark and the
/// validation in the handler read the same list.
export struct OptRow {
    id: string,
    label: string,
}

// ---- The dashboard (Task 7.1) ---------------------------------------------
// One struct per row shape the Command Center draws, mirroring the TS
// dashboard's own row types. Everything is precomputed in Rust
// (`dashboard.rs`): these structs are the handover, never the arithmetic.

/// One metric tile under the score ring. `channel` is the rail row the tile
/// opens when tapped.
export struct DashStat {
    value: int,
    label: string,
    note: string,
    channel: string,
}

/// One row of "Needs your attention". `severity` is 0 high, 1 medium, 2 low
/// — the order they sort in, and the colour they borrow.
export struct DashIssue {
    label: string,
    detail: string,
    count: int,
    severity: int,
    channel: string,
}

/// One list row: a login's name button, its meta line and a trailing slot
/// (relative time on Recent, the masked address on review lists).
export struct DashRow {
    name: string,
    meta: string,
    right: string,
    item: string,
}

/// One bar row (per-site counts, channel distribution). `share` is 0..1 of
/// the biggest row; `channel` is empty for rows that open nothing.
export struct DashBar {
    label: string,
    count: int,
    share: float,
    channel: string,
}

/// One reused-password cluster: how many logins share it, and their names.
export struct DashReuse {
    count: int,
    sites: string,
}

/// One most-used row: copy/edit count, name, and the login to open.
export struct DashUse {
    count: int,
    name: string,
    item: string,
}

/// One 30-day activity column. `fill` is the TS bar-height curve
/// (min(100, total*18 + (total ? 8 : 0))%) as 0..1.
export struct DashDay {
    label: string,
    added: int,
    changed: int,
    fill: float,
}

/// One strength-band legend row: label, count, and the band's colour index.
export struct DashKey {
    label: string,
    count: int,
    band: int,
}

/// One group inside a hover popover (`.dash-pop__group`): its title
/// (`Very weak · 2`, `Shared by 3`), the danger tint on that title, and the
/// logins it lists. An empty row list renders the TS's muted "None" line —
/// strength's bands can come up empty in a small vault.
export struct DashPopGroup {
    title: string,
    danger: bool,
    rows: [DashRow],
}

/// One card's whole hover popover (`.dash-pop`): grouped rows for strength,
/// sites and reuse, flat ranked rows for most-used (`right` holds the rank
/// the panel draws as a circle), the static copy top and bottom, and the
/// three heights Rust measured — the about block, the scroll content (the
/// inner Flickable's viewport), and the panel itself, capped at 320px (380
/// for the wide most-used one). `height` 0 means the card has no popover.
export struct DashPop {
    groups: [DashPopGroup],
    rows: [DashRow],
    about: string,
    empty: string,
    about-h: float,
    scroll-h: float,
    height: float,
}

/// The score ring's arc, as geometry Rust worked out for the 64-unit view
/// the TS ring drew: start at 3 o'clock, sweep clockwise, outer/inner radii
/// 29/23 around the 26 the track uses.
export struct DashRing {
    angle: float,      // degrees, 0..360
    end-outer-x: float,
    end-outer-y: float,
    end-inner-x: float,
    end-inner-y: float,
    large-arc: bool,
    closed: bool,      // score >= 100: colour the track, no arc
    score: int,
    label: string,     // Excellent / Good / Needs work / At risk
    band: int,         // 0 good, 1 fair, 2 poor — picks the ring's colour
    clear: int,        // logins with no password problem
    total: int,
}

// ---- The history channel (Task 7.2) ----------------------------------------

/// One row of the History log (`.history__row`): the event's own identity for
/// the callbacks, the action for the badge and the red border on deletions,
/// the name and meta line, and the three flags that say which actions this row
/// offers — Restore needs a stored version, the edit/copy group needs the
/// login to still exist, Forget is always there.
export struct HistoryRow {
    event-id: string,
    item-id: string,
    action: string,      // "added" | "edited" | "deleted"
    badge: string,       // "Added" / "Edited" / "Deleted"
    name: string,
    meta: string,
    restore: bool,       // the event carries a `before` snapshot
    live: bool,          // the login still exists in the vault
    copy-pw: bool,       // live and the snapshot has a password to copy
    copy-pw-value: string,
    copy-url: bool,      // live and there is an address to copy
    copy-url-value: string,
}

/// One day of the log (`.history__group`): `Today`, `Yesterday`, or the
/// long date the TS's `dayLabel` builds.
export struct HistoryGroup {
    label: string,
    rows: [HistoryRow],
}

/// The whole screen's data, pushed as one property so the count, the groups
/// and the empty state cannot disagree mid-keystroke: the count badge, the
/// day groups (empty ⇒ show the empty state), and the two empty states TS
/// switches between — nothing recorded yet, or nothing matching the query.
export struct HistoryData {
    count: string,
    groups: [HistoryGroup],
    empty-title: string,
    empty-hint: string,
    has-events: bool,    // Clear log stays live while the log has entries,
                         // even when the query filters every row away
}

// ---- Docks (Task 8.3) ----------------------------------------------------
// One resolved slot of a quick-launch bar, read off its `kind:ref` id the way
// `buildDockSlots` does (App.tsx L2505-2620). A slot whose target no longer
// exists is simply absent here, so a deleted channel leaves a gap rather than
// a dead button.
export struct DockSlotRow {
    id: string,          // `${kind}:${ref || kind}`
    kind: string,        // view | channel | folder | login | inbox | mailbox
    label: string,       // slot label, else the target's own name
    hint: string,        // "Folder: Work", the username, or the action hint
    glyph: string,       // the port's text-glyph stand-in for the Lucide icon
    dot: color,          // the channel/folder hue, resolved in Rust
    has-dot: bool,       // false for views, inbox and logins
    key: string,         // the bare key that jumps here, as the badge shows it
    active: bool,        // the view/channel/login this slot points at is showing
    family: string,      // views | go | logins | mail -- decides the divider
    divider: bool,       // a family boundary falls *before* this slot
    has-image: bool,     // an uploaded/remote icon overrides the glyph
    image: image,
}

// One stored bar with its slots resolved, plus the placement the bar is drawn
// at. `edge` decides row-vs-column; fx/fy are viewport fractions, 0-1.
export struct DockBarRow {
    id: string,
    edge: string,        // bottom | top | left | right
    fx: float,
    fy: float,
    slots: [DockSlotRow],
}

// One row of the Layout tab's dock manager. A flat list rather than a nested
// model, because Slint cannot group a model after the fact; `kind` says which
// shape the row is. `dock`/`slot` are the indices a click writes back.
export struct DockManagerRow {
    kind: string,        // dock | slot
    dock: int,
    slot: int,           // -1 on a dock header
    id: string,          // the slot's `kind:ref` id, else the dock id
    title: string,       // "Dock 1", or the slot's label
    hint: string,        // the slot's target/action hint, or the bar's spot
    glyph: string,
    dot: color,
    has-dot: bool,
    key: string,
    enabled: bool,       // dock headers only
    missing: bool,       // the slot's target is gone -- Remove is all that works
}
