// The item editor: one login, edited in place.
//
// Port of `src/ui/ItemEditor.tsx` (1,096 lines). The TS version has nine
// sections down its rail; this ships eight -- Identity, Credentials,
// Security, Reminders, Appearance, Notes, Inbox, Flags. Organise arrives
// with its own subsystem (the tag catalogue) and is still left off the rail:
// a tab that does nothing yet is worse than a tab that is not there yet,
// and adding one later is a one-line change. The *indices* below already
// reserve every slot in the TS order, so landing it does not renumber
// anything.
//
// The draft lives here, not in Rust. Every field is `in-out`, so the user
// can visit all seven tabs without anything being written, and `save` hands
// the whole object over once (`onSave(draft)` in the TS app).
//
// Everything with a *choice* in it is an index, not a label: `Segmented`
// counts in ints, so the label<->days table lives in exactly one place
// (Rust, beside the preference it feeds) rather than being duplicated in a
// `.slint` comparison chain that would drift.

import { Theme } from "../theme.slint";
import {
    Btn, Field, Alert, Toggle, Checkbox, Chip, Slider, Segmented,
    Label, Note, Area, StrengthMeter
} from "../widgets.slint";
import { HueSwatch, QuestionRow, QrCell } from "../models.slint";

export component Editor inherits VerticalLayout {
    // The login being edited, or "" for a new one. Decides the heading and
    // whether Delete exists at all.
    in property <string> edit-id;

    // The draft. `in-out` so Rust can fill it when the screen opens and read
    // all of it back on save. Nothing here is written until Save.
    in-out property <string> title;
    in-out property <string> url;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> notes;
    in-out property <bool> favorite;
    in-out property <bool> needs-attention;
    // Fractional days, as `reminderDays` in storage.ts: 15 minutes is
    // 15/1440, so every stale check in the app follows it with no conversion.
    in-out property <float> reminder-days;
    // The label for `reminder-days`, pushed from Rust alongside it. Having
    // Rust derive the label means the preset table cannot disagree with the
    // normaliser that consumes the number.
    in property <string> reminder-label: "Follow global";

    in property <string> section: "identity";
    in property <bool> reveal-password: false;

    // Strength of `password`, pushed by Rust on every edit. `-1` means
    // "nothing typed": a meter that rates an empty field is judging a form.
    in property <int> strength-score: -1;
    in property <string> strength-label;
    in property <string> strength-bits;
    in property <string> strength-crack;

    // The generator. The options are `in-out` so a chip can be toggled here
    // and Rust asked to regenerate within the same event, which is what the
    // TS `useEffect` on `[options, mode, words]` does.
    in property <bool> show-generator: false;
    in-out property <bool> gen-revealed: false;
    in property <string> gen-mode: "Random";
    in-out property <float> gen-length: 20;
    in-out property <float> gen-words: 5;
    // The two read-outs beside the sliders. Slint 1.18 has no way to turn a
    // number into part of a string at all (no interpolation, no `str`), so
    // the wording is composed in Rust, beside the number it describes.
    in property <string> gen-length-label;
    in property <string> gen-words-label;
    in-out property <bool> gen-lower: true;
    in-out property <bool> gen-upper: true;
    in-out property <bool> gen-digits: true;
    in-out property <bool> gen-symbols: true;
    in-out property <bool> gen-avoid: true;
    in property <string> generated;
    // The dots come from Rust: Slint's strings have no `repeat`, and a mask
    // whose length tracks the password leaks the password's length.
    in property <string> gen-mask;
    in property <int> generated-score: -1;
    in property <string> generated-label;
    in property <string> generated-bits;
    in property <string> generated-crack;

    in property <bool> busy: false;
    in property <string> error-text;
    in property <string> notice-text;

    // ---- Security -----------------------------------------------------
    // Port of `SecurityForm.tsx` (623 lines). The state lives in Rust: every
    // action here either asks Rust to compute something (a hash, a QR
    // matrix, a code check) or reports that the user pushed a button, and
    // Rust replies by pushing these properties back. Nothing is written to
    // the record until Save, exactly as the TS form only calls `onChange`
    // once a factor is proven to work.
    //
    // Which of the four factors is on show. Pure view state -- the TS
    // version uses four `useState` flags for it -- so it stays here and
    // resets when the editor element is recreated, instead of travelling to
    // Rust and back for no one to read it.
    property <string> sec-tab: "authenticator";
    // "none" / "partial" / "full", straight from `security_level()`.
    in property <string> sec-level: "none";
    // The recovery tile's note ("Not set" / "2 questions"). Composed in
    // Rust beside the list itself: Slint cannot put a number into a string.
    in property <string> sec-questions-note: "Not set";

    // --- Authenticator (TOTP) ---
    in property <bool> sec-totp: false;
    // The `otpauth://` URI, pushed from Rust with the login's name in it.
    in property <string> sec-otpauth;
    // The QR symbol as one entry per *dark* module, in module units. Rust
    // walks `qr_matrix()` and ships only the dark half (a symbol is half
    // light), and keeps row and column as two fields rather than one index:
    // Slint has neither `%` nor a trustworthy integer divide to recover them.
    in property <int> qr-size: 0;
    in property <[QrCell]> qr-cells;
    // A key the user has generated or pasted but has *not* confirmed. Saving
    // is what makes it real -- see the note on `stagedSeed` in
    // SecurityForm.tsx L47-58.
    in property <bool> sec-totp-staged: false;
    // The inline error under the code box: the TS `codeError`, and the
    // refusal when a pasted string is not a key. Successes are the notice,
    // as in TS -- an error slot is the wrong place to congratulate.
    in property <string> sec-totp-note;
    in-out property <string> sec-totp-seed;
    // The code to check. Rust reads it to verify and clears it after; Slint
    // only shows it. No digit filter here: `verify_totp` skips non-digits
    // itself, so "123 456" pasted from the phone app still works.
    in-out property <string> sec-totp-code;

    // --- Passcode ---
    in property <bool> sec-passcode: false;
    in-out property <string> sec-passcode-new;
    in-out property <string> sec-passcode-confirm;
    // The typed passcode being checked against the stored hash.
    in-out property <string> sec-passcode-input;
    in property <string> sec-passcode-error;

    // --- Recovery questions ---
    in property <[QuestionRow]> sec-questions;
    in property <string> sec-answer-error;
    // The question whose answer is being checked right now ("" = none). Two
    // rounds like the TS form: the row's button opens the box, the second
    // press verifies what is typed in it.
    in-out property <string> sec-checking-id;
    in-out property <string> sec-check-input;
    // The prompt the add row offers. Rust owns the list of eight -- they are
    // copy, and copy belongs in one place -- and steps it.
    in property <string> sec-new-prompt;
    in-out property <string> sec-new-answer;

    // ---- Appearance ---------------------------------------------------
    // The draft's accent. -1 is "auto": not a hue but the choice to derive
    // one from the title, exactly `accentHue: null` in the record.
    in-out property <float> accent-hue: -1;
    // What the hue slider shows — the chosen hue, or the auto one when the
    // draft is on auto. The slider cannot sit at -1, and dragging it commits
    // an explicit hue, which is what the TS range input does.
    in-out property <float> hue-slider: 212;
    // Numbers cannot become text in Slint at all (no `str`, no interpolation),
    // so the readouts beside the sliders are composed in Rust beside the
    // numbers they describe.
    in property <string> hue-readout;
    in property <string> blur-readout;
    // The preview's gradient and initial: resolved in Rust, because Slint
    // has no `hsl()` — same reason Theme's stops are resolved there too.
    in property <color> preview-from;
    in property <color> preview-to;
    in property <string> preview-initial: "?";
    in property <[HueSwatch]> hue-swatches;
    in-out property <string> bg-image;
    in-out property <float> bg-blur: 0;
    in-out property <string> avatar-image;

    // ---- Inbox --------------------------------------------------------
    in-out property <bool> show-mail: false;
    // The value and, beside it, the label `Segmented` shows: Rust owns both
    // halves of the mapping, so the screen only counts in indices.
    in property <string> mail-filter: "auto";
    in property <string> mail-filter-label: "Auto";
    property <int> mail-filter-index: root.mail-filter-label == "Matched only" ? 1
        : root.mail-filter-label == "Recent only" ? 2
        : 0;
    // Delete asks first when `confirmDeletes` is on. `can-delete` is false
    // for a login that has never been saved, so a half-typed new login
    // cannot offer to delete itself.
    in property <bool> confirm-delete: false;
    in property <bool> can-delete: false;

    callback cancel-clicked();
    callback save-clicked();
    callback delete-asked();
    callback delete-confirmed();
    // "Keep it": back out of the delete confirmation without closing the
    // editor. Separate from `delete-asked`, which *enters* it -- one button
    // opening a state and another closing it cannot share a callback.
    callback confirm-cancelled();
    callback reveal-clicked();
    // Fires on every keystroke in the password box so Rust can re-estimate the
    // strength. The value is not passed: it is already `<=>`-bound, and
    // shipping a copy would give the two a way to disagree.
    callback password-edited();
    callback section-selected(id: string);
    callback generator-toggled();
    callback regenerate();
    // Indices, not labels: see the note at the top of the file.
    callback gen-mode-picked(index: int);
    callback use-generated();
    callback copy-generated();
    callback reminder-picked(index: int);
    // Appearance. The image fields need no callback: they are `in-out`, the
    // preview shows the gradient rather than the photo (there is no image
    // decode on this screen yet), and nothing else derives from them.
    callback hue-picked(hue: float);
    // The name drives the auto hue, so the preview follows every keystroke.
    callback title-edited();
    callback bg-blur-changed(value: float);
    callback mail-filter-picked(index: int);
    // Security. The heavy lifting is Rust's: hashing a passcode or an answer
    // is PBKDF2, which must not be written twice, and checking a TOTP code is
    // a whole RFC. These callbacks say what the user did; the results come
    // back as the properties above.
    // Paste a seed (bare or otpauth://) and stage it.
    callback sec-totp-attach();
    // Mint a fresh seed and stage it -- staged, never saved, until a code
    // confirms it. See the note on `stagedSeed` in SecurityForm.tsx L47-58.
    callback sec-totp-generate();
    // Check the typed code against the staged-or-saved seed. `value` is not
    // passed: it is already `<=>`-bound, and a copy could disagree with it.
    callback sec-totp-check();
    callback sec-totp-discard();
    callback sec-totp-remove();
    callback sec-passcode-save();
    callback sec-passcode-check();
    callback sec-passcode-remove();
    callback sec-question-add();
    callback sec-question-remove(id: string);
    // Two-stage like the TS form: first press opens the answer box, second
    // verifies what is typed in it.
    callback sec-question-check(id: string);
    // Walk the fixed list of eight prompts. There is no `Select` in this
    // app and eight sentences will not fit a `Segmented`, so the add row
    // shows one prompt and steps through them with the two arrows.
    callback sec-prompt-step(delta: int);

    // The section rail. The hint repeats here so the panel header and the
    // rail cannot spell the same sentence two different ways. Organise is
    // still missing from the list -- see the note at the top -- which is why
    // the rail highlights by *id* below rather than by position: the two
    // lists are deliberately not parallel while one slot is unimplemented.
    property <[string]> section-ids: ["identity", "credentials", "security", "reminders", "appearance", "notes", "inbox", "flags"];
    property <[string]> section-labels: ["Identity", "Credentials", "Security", "Reminders", "Appearance", "Notes", "Inbox", "Flags"];

    // Keyed by *id*, not by position in the two lists above: the TS order is
    // identity, credentials, security, reminders, organise, appearance,
    // notes, inbox, flags, and the section not built yet (organise) still
    // holds its slot.
    property <int> section-index: root.section == "credentials" ? 1
        : root.section == "security" ? 2
        : root.section == "reminders" ? 3
        : root.section == "organise" ? 4
        : root.section == "appearance" ? 5
        : root.section == "notes" ? 6
        : root.section == "inbox" ? 7
        : root.section == "flags" ? 8
        : 0;

    property <string> active-title: root.section-index == 1 ? "Credentials"
        : root.section-index == 2 ? "Security"
        : root.section-index == 3 ? "Reminders"
        : root.section-index == 4 ? "Organise"
        : root.section-index == 5 ? "Appearance"
        : root.section-index == 6 ? "Notes"
        : root.section-index == 7 ? "Inbox"
        : root.section-index == 8 ? "Flags"
        : "Identity";
    property <string> active-hint: root.section-index == 1
            ? "The secrets. Nothing here leaves this device."
        : root.section-index == 2
            ? "Optional second factor for this login alone."
        : root.section-index == 3
            ? "When this login asks for a fresh password."
        : root.section-index == 4
            ? "Tags and the dates behind the health warnings."
        : root.section-index == 5
            ? "Icon, colours and images."
        : root.section-index == 6
            ? "Anything else worth remembering."
        : root.section-index == 7
            ? "Connect a mailbox and read recent mail here."
        : root.section-index == 8
            ? "Sorting, favourites and warnings."
        : "What this login is called and where it lives.";

    // `Segmented` counts in indices; these turn Rust's strings back into one.
    property <int> reminder-index: root.reminder-label == "15 min" ? 1
        : root.reminder-label == "1 hour" ? 2
        : root.reminder-label == "12 hours" ? 3
        : root.reminder-label == "1 day" ? 4
        : root.reminder-label == "7 days" ? 5
        : root.reminder-label == "30 days" ? 6
        : root.reminder-label == "90 days" ? 7
        : 0;

    property <string> heading: root.edit-id == "" ? "New login" : "Edit login";

    // This screen is sized by the window's root layout -- see the note in
    // main.slint. No width/height here on purpose: geometry written on a
    // component's root is not what decides its size.
    //
    // No gaps between the three bands: each one draws its own edge, and the
    // gaps would show the window's gradient through them.
    spacing: 0px;

    // ---- Top bar -----------------------------------------------------
    Rectangle {
        height: 58px;
        vertical-stretch: 0;
        background: Theme.bg-deep;

        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            spacing: 12px;

            Btn {
                label: "← Back";
                kind: 2;
                h: 34px;
                enabled: !root.busy;
                clicked => { root.cancel-clicked(); }
            }

            Rectangle { horizontal-stretch: 1; width: 1px; }

            Text {
                text: root.heading + (root.title == "" ? "" : " · " + root.title);
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; width: 1px; }

            if (root.can-delete && !root.confirm-delete) : Btn {
                label: "Delete";
                kind: 2;
                h: 34px;
                enabled: !root.busy;
                clicked => { root.delete-asked(); }
            }
        }
    }

    // ---- Body: section rail + panel ----------------------------------
    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 0px;

        // The rail. Same treatment as the vault's sidebar: a label and
        // nothing else, so nothing here looks like a control that hides
        // a login.
        Rectangle {
            width: 176px;
            vertical-stretch: 0;
            background: Theme.bg-deep;

            VerticalLayout {
                padding-top: 22px;
                padding-bottom: 18px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 3px;

                for label[i] in root.section-labels : Rectangle {
                    height: 34px;
                    vertical-stretch: 0;
                    border-radius: 9px;
                    background: root.section-ids[i] == root.section
                        ? (row-touch.pressed ? #ffffff1f : #ffffff12)
                        : #00000000;

                    row-touch := TouchArea {
                        clicked => { root.section-selected(root.section-ids[i]); }
                    }

                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: label;
                        color: root.section-ids[i] == root.section ? Theme.text : Theme.muted;
                        font-size: 13.5px;
                        font-weight: root.section-ids[i] == root.section ? 600 : 500;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // The panel. Pinned rather than left to the layout to settle:
        // its content includes wrapped text and multi-line notes, whose
        // *preferred* size is the unwrapped one, and letting that feed
        // back into the row's width closes a loop.
        Rectangle {
            width: parent.width - 176px;
            vertical-stretch: 1;
            clip: true;

            VerticalLayout {
                padding-top: 24px;
                padding-bottom: 24px;
                padding-left: 34px;
                padding-right: 34px;
                spacing: 14px;

                VerticalLayout {
                    spacing: 4px;
                    vertical-stretch: 0;

                    Text {
                        text: root.active-title;
                        color: Theme.text;
                        font-size: 19px;
                        font-weight: 700;
                    }

                    Text {
                        text: root.active-hint;
                        color: Theme.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }

                if (root.error-text != "") : Alert {
                    message: root.error-text;
                }

                if (root.notice-text != "") : Alert {
                    message: root.notice-text;
                    good: true;
                }

                // ---- Identity ------------------------------------------
                //
                // One section at a time, with `if` rather than `visible`.
                // `visible: false` still takes up layout space (the Slint
                // docs say so explicitly), so a hidden section would sit
                // between the header and the visible one, pushing every
                // later section out through the panel's clip and dragging
                // the footer off the bottom of the window. `if` removes
                // the element from the layout entirely -- which is also
                // why the generator's own controls are `if`-ed on the
                // mode instead of being stacked and hidden.
                if (root.section-index == 0) : VerticalLayout {
                    spacing: 16px;
                    vertical-stretch: 0;

                    VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        Label { text: "Name"; }
                        Field {
                            value <=> root.title;
                            placeholder: "GitHub";
                            autofocus: root.section-index == 0;
                            // The auto hue is derived from the name, so the
                            // Appearance preview follows it as it is typed.
                            edited => { root.title-edited(); }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        Label { text: "Website"; }
                        Field {
                            value <=> root.url;
                            placeholder: "github.com";
                            autofocus: false;
                        }
                        Note {
                            text: "The domain is what Open site uses, and it drives the icon and accent when those are left on automatic.";
                        }
                    }
                }

                // ---- Credentials ---------------------------------------
                if (root.section-index == 1) : VerticalLayout {
                    spacing: 14px;
                    vertical-stretch: 0;

                    VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        Label { text: "Email or username"; }
                        Field {
                            value <=> root.username;
                            placeholder: "you@example.com";
                            autofocus: false;
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        Label { text: "Password"; }

                        HorizontalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;

                            Field {
                                value <=> root.password;
                                password: !root.reveal-password;
                                autofocus: false;
                                edited => { root.password-edited(); }
                            }

                            Btn {
                                label: root.reveal-password ? "Hide" : "Show";
                                kind: 1;
                                h: 44px;
                                width: 68px;
                                clicked => { root.reveal-clicked(); }
                            }

                            Btn {
                                label: root.show-generator ? "Hide" : "Generate";
                                kind: 1;
                                h: 44px;
                                width: 92px;
                                clicked => { root.generator-toggled(); }
                            }
                        }
                    }

                    // Only once something is typed: `StrengthMeter` hides
                    // its readout at -1, and five empty segments beside an
                    // empty field are noise.
                    if (root.password != "") : StrengthMeter {
                        score: root.strength-score;
                        label: root.strength-label;
                        bits: root.strength-bits;
                        crack-time: root.strength-crack;
                    }

                    // Built only while the panel is open: a hidden block
                    // would still take the height of a visible one.
                    if (root.show-generator) : VerticalLayout {
                        spacing: 10px;
                        vertical-stretch: 0;
                        padding-top: 4px;

                        Segmented {
                            options: ["Random", "Words"];
                            selected: root.gen-mode == "Words" ? 1 : 0;
                            changed(i) => { root.gen-mode-picked(i); }
                        }

                        // The preview. Masked by default, like the field
                        // above it: a generated secret should not be on
                        // screen until it is asked for.
                        Rectangle {
                            height: 44px;
                            vertical-stretch: 0;
                            border-radius: 10px;
                            background: #ffffff0a;
                            border-width: 1px;
                            border-color: #ffffff14;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 6px;
                                spacing: 6px;

                                Text {
                                    text: root.generated == ""
                                        ? "—"
                                        : (root.gen-revealed ? root.generated : root.gen-mask);
                                    color: root.generated == "" ? Theme.faint : Theme.text;
                                    font-size: 13px;
                                    font-family: "Consolas";
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                Btn {
                                    label: root.gen-revealed ? "Hide" : "Show";
                                    kind: 2;
                                    h: 32px;
                                    width: 62px;
                                    enabled: root.generated != "";
                                    clicked => { root.gen-revealed = !root.gen-revealed; }
                                }

                                Btn {
                                    label: "Roll";
                                    kind: 1;
                                    h: 32px;
                                    width: 58px;
                                    clicked => { root.regenerate(); }
                                }

                                Btn {
                                    label: "Copy";
                                    kind: 1;
                                    h: 32px;
                                    width: 68px;
                                    enabled: root.generated != "";
                                    clicked => { root.copy-generated(); }
                                }
                            }
                        }

                        if (root.gen-mode == "Random") : Slider {
                            label: "Length";
                            formatted: root.gen-length-label;
                            minimum: 8;
                            maximum: 64;
                            value <=> root.gen-length;
                            changed(value) => { root.gen-length = round(value); root.regenerate(); }
                        }

                        if (root.gen-mode == "Words") : Slider {
                            label: "Words";
                            formatted: root.gen-words-label;
                            minimum: 3;
                            maximum: 10;
                            value <=> root.gen-words;
                            changed(value) => { root.gen-words = round(value); root.regenerate(); }
                        }

                        if (root.gen-mode == "Random") : VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;

                            HorizontalLayout {
                                spacing: 6px;
                                vertical-stretch: 0;
                                alignment: start;

                                Chip {
                                    label: "a-z";
                                    selected: root.gen-lower;
                                    toggled => { root.gen-lower = !root.gen-lower; root.regenerate(); }
                                }
                                Chip {
                                    label: "A-Z";
                                    selected: root.gen-upper;
                                    toggled => { root.gen-upper = !root.gen-upper; root.regenerate(); }
                                }
                                Chip {
                                    label: "0-9";
                                    selected: root.gen-digits;
                                    toggled => { root.gen-digits = !root.gen-digits; root.regenerate(); }
                                }
                                Chip {
                                    label: "!@#";
                                    selected: root.gen-symbols;
                                    toggled => { root.gen-symbols = !root.gen-symbols; root.regenerate(); }
                                }

                                Rectangle { horizontal-stretch: 1; width: 1px; }

                                Checkbox {
                                    label: "Avoid look-alikes (l, 1, I, O, 0, o)";
                                    checked <=> root.gen-avoid;
                                    toggled => { root.regenerate(); }
                                }
                            }
                        }

                        if (root.gen-mode == "Words") : Note {
                            text: "A passphrase from this list carries far more entropy than a short random string, and is easier to type.";
                        }

                        StrengthMeter {
                            score: root.generated-score;
                            label: root.generated-label;
                            bits: root.generated-bits;
                            crack-time: root.generated-crack;
                        }

                        // Turning off every character set leaves nothing
                        // to draw from. TS says so rather than silently
                        // generating from an empty pool.
                        if (root.gen-mode == "Random"
                            && !root.gen-lower && !root.gen-upper
                            && !root.gen-digits && !root.gen-symbols) : Alert {
                            message: "Turn on at least one character set.";
                        }

                        Btn {
                            label: "Use this password";
                            kind: 0;
                            h: 40px;
                            enabled: root.generated != "";
                            clicked => { root.use-generated(); }
                        }
                    }
                }

                // ---- Security ------------------------------------------
                // Port of `SecurityForm.tsx` (L230-580). Four factors, one
                // tile each: the tile is both the status and the tab, so the
                // common question ("is this login protected, and by what")
                // is answered by the row itself rather than by reading past a
                // QR code.
                if (root.section-index == 2) : VerticalLayout {
                    spacing: 14px;
                    vertical-stretch: 0;

                    // What is actually configured. `secured-note` is pushed
                    // from Rust beside `security_level()`, so the sentence and
                    // the factor count cannot drift apart.
                    Rectangle {
                        height: sec-state.preferred-height + 20px;
                        vertical-stretch: 0;
                        border-radius: 10px;
                        background: #ffffff0a;

                        sec-state := Text {
                            x: 14px;
                            y: 10px;
                            width: parent.width - 28px;
                            text: root.sec-level == "full"
                                ? "Protected. A code or a passcode stands between this login and anyone who opens it."
                                : root.sec-level == "partial"
                                    ? "Partly protected. One factor is set; a second one would mean a stolen password is not enough."
                                    : "No second factor. Everything below is optional -- with nothing set, this login works exactly as before.";
                            color: Theme.muted;
                            font-size: 12.5px;
                            wrap: word-wrap;
                        }
                    }

                    // The four tiles. One row, each a third of the panel.
                    HorizontalLayout {
                        spacing: 8px;
                        vertical-stretch: 0;

                        for tab in ["authenticator", "passcode", "recovery", "passkey"] : Rectangle {
                            vertical-stretch: 0;
                            height: 62px;
                            border-radius: 10px;
                            background: root.sec-tab == tab
                                ? (tile-touch.pressed ? #ffffff1f : #ffffff14)
                                : (tile-touch.has-hover ? #ffffff10 : #ffffff08);
                            border-width: 1px;
                            border-color: root.sec-tab == tab ? Theme.accent : Theme.border;

                            tile-touch := TouchArea {
                                // Passkey is shown as a fourth tile because the
                                // TS form shows it, and is not clickable for
                                // the same reason it is not wired there: see
                                // the note under the disabled panel.
                                enabled: tab != "passkey";
                                clicked => { root.sec-tab = tab; }
                            }

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 2px;

                                Text {
                                    text: tab == "authenticator" ? "Authenticator"
                                        : tab == "passcode" ? "Passcode"
                                        : tab == "recovery" ? "Recovery" : "Passkey";
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                // Each tile says its own status. The two
                                // bools are the very ones Rust counted for
                                // the level above, so the note and the
                                // sentence cannot disagree -- and the count
                                // is pushed from Rust, because Slint cannot
                                // put a number into a string.
                                Text {
                                    text: tab == "authenticator"
                                        ? (root.sec-totp ? "Key attached - a code is needed" : "Not set")
                                        : tab == "passcode"
                                            ? (root.sec-passcode ? "Set - it gates this login" : "Not set")
                                            : tab == "recovery"
                                                ? root.sec-questions-note
                                                : "Unavailable here";
                                    color: Theme.faint;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // ---- Authenticator --------------------------------
                    // Two states, exactly as the TS form branches on
                    // `activeSeed`: with a key (staged or saved) the symbol
                    // and the check; without one, the row that makes a key.
                    // The symbol and the controls sit side by side rather
                    // than stacked, because the panel clips: there is no
                    // Flickable in this app, and a QR, its caption, the code
                    // box and the errors stacked vertically do not fit the
                    // ~360px the section has left.
                    if (root.sec-tab == "authenticator") : VerticalLayout {
                        spacing: 12px;
                        vertical-stretch: 0;

                        if (root.sec-totp-staged || root.sec-totp) : HorizontalLayout {
                            spacing: 16px;
                            vertical-stretch: 0;

                            // The symbol. Painted as one dark rectangle per
                            // dark module over a light plate: no image
                            // decoding, no PNG round-trip, and it stays crisp
                            // at whatever size the window is dragged to. The
                            // 10px of white around the 200px symbol is the
                            // quiet zone a phone needs to lock on.
                            VerticalLayout {
                                width: 220px;
                                spacing: 6px;
                                vertical-stretch: 0;

                                Rectangle {
                                    height: 220px;
                                    vertical-stretch: 0;
                                    border-radius: 12px;
                                    background: #ffffff;
                                    clip: true;

                                    if (root.qr-size > 0) : Rectangle {
                                        x: 10px;
                                        y: 10px;
                                        width: 200px;
                                        height: 200px;

                                        for cell in root.qr-cells : Rectangle {
                                            x: cell.col * (200px / root.qr-size);
                                            y: cell.row * (200px / root.qr-size);
                                            width: 200px / root.qr-size;
                                            height: 200px / root.qr-size;
                                            background: #101319;
                                        }
                                    }
                                }

                                Text {
                                    text: "Scan this with your authenticator app, then confirm a code below.";
                                    color: Theme.faint;
                                    font-size: 11.5px;
                                    wrap: word-wrap;
                                    vertical-stretch: 0;
                                }
                            }

                            VerticalLayout {
                                spacing: 10px;
                                vertical-stretch: 0;

                                if (root.sec-totp-staged) : Text {
                                    text: "Not saved yet. Confirm a code below and the key is kept; leave without confirming and nothing changes.";
                                    color: Theme.warn;
                                    font-size: 12.5px;
                                    wrap: word-wrap;
                                    vertical-stretch: 0;
                                }

                                // The QRCode library refuses a URL that will
                                // not fit, and TS treats that as "no QR" and
                                // falls back to the setup key. Show it rather
                                // than hide it: the string still works.
                                if (root.qr-size == 0 && root.sec-otpauth != "") : Note {
                                    text: "This key is too long for a code the phone can scan. The setup key still works: " + root.sec-otpauth;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    vertical-stretch: 0;

                                    Field {
                                        value <=> root.sec-totp-code;
                                        placeholder: "Enter a code to check";
                                        autofocus: false;
                                    }
                                    Btn {
                                        label: "Check";
                                        kind: 1;
                                        h: 44px;
                                        width: 84px;
                                        enabled: !root.busy && root.sec-totp-code != "";
                                        clicked => { root.sec-totp-check(); }
                                    }
                                }

                                if (root.sec-totp-note != "") : Text {
                                    text: root.sec-totp-note;
                                    color: Theme.danger;
                                    font-size: 12.5px;
                                    wrap: word-wrap;
                                    vertical-stretch: 0;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    vertical-stretch: 0;

                                    if (root.sec-totp-staged) : Btn {
                                        label: "Discard";
                                        kind: 2;
                                        h: 38px;
                                        width: 90px;
                                        enabled: !root.busy;
                                        clicked => { root.sec-totp-discard(); }
                                    }

                                    if (root.sec-totp) : Btn {
                                        label: "Remove";
                                        kind: 2;
                                        h: 38px;
                                        width: 90px;
                                        enabled: !root.busy;
                                        clicked => { root.sec-totp-remove(); }
                                    }
                                }
                            }
                        }

                        if (!root.sec-totp-staged && !root.sec-totp) : VerticalLayout {
                            spacing: 12px;
                            vertical-stretch: 0;

                            Btn {
                                label: "Generate a key";
                                kind: 0;
                                h: 44px;
                                width: 170px;
                                enabled: !root.busy;
                                clicked => { root.sec-totp-generate(); }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                vertical-stretch: 0;

                                Field {
                                    value <=> root.sec-totp-seed;
                                    placeholder: "Or paste the setup key / otpauth:// link";
                                    autofocus: false;
                                }
                                Btn {
                                    label: "Attach";
                                    kind: 1;
                                    h: 44px;
                                    width: 84px;
                                    enabled: !root.busy && root.sec-totp-seed != "";
                                    clicked => { root.sec-totp-attach(); }
                                }
                            }

                            if (root.sec-totp-note != "") : Text {
                                text: root.sec-totp-note;
                                color: Theme.danger;
                                font-size: 12.5px;
                                wrap: word-wrap;
                                vertical-stretch: 0;
                            }

                            Note {
                                text: "Generating one here and scanning the QR code is the easiest path.";
                            }
                        }
                    }

                    // ---- Passcode -------------------------------------
                    if (root.sec-tab == "passcode") : VerticalLayout {
                        spacing: 12px;
                        vertical-stretch: 0;

                        // The TS `sec__head`: the factor's name and its own
                        // Remove. The tile above already says whether one is
                        // set, so this row only acts on it.
                        HorizontalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;

                            Text {
                                text: "Passcode";
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                            }

                            Rectangle { horizontal-stretch: 1; width: 1px; }

                            if (root.sec-passcode) : Btn {
                                label: "Remove";
                                kind: 2;
                                h: 32px;
                                width: 84px;
                                enabled: !root.busy;
                                clicked => { root.sec-passcode-remove(); }
                            }
                        }

                        Note {
                            text: "A password of your own that gates this login. Stored hashed, so it is never written to disk in the clear. It must not be the same as the login's own password.";
                        }

                        // Check the one that is set, or set one: the two
                        // halves of the TS form's single conditional.
                        if (root.sec-passcode) : HorizontalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;

                            Field {
                                value <=> root.sec-passcode-input;
                                placeholder: "Enter it to check";
                                password: true;
                                autofocus: false;
                            }
                            Btn {
                                label: "Check";
                                kind: 1;
                                h: 44px;
                                width: 84px;
                                enabled: !root.busy && root.sec-passcode-input != "";
                                clicked => { root.sec-passcode-check(); }
                            }
                        }

                        if (!root.sec-passcode) : HorizontalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;

                            Field {
                                value <=> root.sec-passcode-new;
                                placeholder: "New passcode";
                                password: true;
                                autofocus: false;
                            }
                            Field {
                                value <=> root.sec-passcode-confirm;
                                placeholder: "Repeat it";
                                password: true;
                                autofocus: false;
                                accepted => { root.sec-passcode-save(); }
                            }
                            Btn {
                                label: "Set";
                                kind: 0;
                                h: 44px;
                                width: 76px;
                                enabled: !root.busy
                                    && root.sec-passcode-new != ""
                                    && root.sec-passcode-confirm != "";
                                clicked => { root.sec-passcode-save(); }
                            }
                        }

                        if (root.sec-passcode-error != "") : Text {
                            text: root.sec-passcode-error;
                            color: Theme.danger;
                            font-size: 12.5px;
                            wrap: word-wrap;
                        }
                    }

                    // ---- Recovery questions ---------------------------
                    if (root.sec-tab == "recovery") : VerticalLayout {
                        spacing: 12px;
                        vertical-stretch: 0;

                        HorizontalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;

                            Text {
                                text: "Recovery questions";
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                            }

                            Rectangle { horizontal-stretch: 1; width: 1px; }

                            Text {
                                text: root.sec-questions-note;
                                color: Theme.faint;
                                font-size: 12px;
                            }
                        }

                        Note {
                            text: "Answers are hashed with a salt and never stored. Pick something you could reconstruct and nobody else could guess.";
                        }

                        VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;

                            for q in root.sec-questions : VerticalLayout {
                                spacing: 6px;
                                vertical-stretch: 0;

                                Rectangle {
                                    height: 46px;
                                    vertical-stretch: 0;
                                    border-radius: 10px;
                                    background: #ffffff08;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 6px;
                                        spacing: 6px;

                                        Text {
                                            text: q.prompt;
                                            color: Theme.text;
                                            font-size: 13px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "answer hashed";
                                            color: Theme.faint;
                                            font-size: 11.5px;
                                            vertical-alignment: center;
                                        }

                                        // Two rounds, as in `checkQuestion`:
                                        // the first press opens the box below,
                                        // the second verifies what is in it.
                                        Btn {
                                            label: root.sec-checking-id == q.id ? "Verify" : "Check answer";
                                            kind: 1;
                                            h: 32px;
                                            width: 116px;
                                            enabled: !root.busy;
                                            clicked => { root.sec-question-check(q.id); }
                                        }

                                        Btn {
                                            label: "Remove";
                                            kind: 2;
                                            h: 32px;
                                            width: 76px;
                                            enabled: !root.busy;
                                            clicked => { root.sec-question-remove(q.id); }
                                        }
                                    }
                                }

                                if (root.sec-checking-id == q.id) : HorizontalLayout {
                                    spacing: 8px;
                                    vertical-stretch: 0;

                                    Field {
                                        value <=> root.sec-check-input;
                                        placeholder: "Your answer";
                                        autofocus: true;
                                        accepted => { root.sec-question-check(q.id); }
                                    }
                                    Btn {
                                        label: "Cancel";
                                        kind: 2;
                                        h: 44px;
                                        width: 76px;
                                        enabled: !root.busy;
                                        clicked => {
                                            root.sec-checking-id = "";
                                            root.sec-check-input = "";
                                        }
                                    }
                                }
                            }
                        }

                        // Adding one. The prompts are a fixed list of eight
                        // held in Rust (they are copy), and there is no
                        // `Select` in this app -- eight sentences will not fit
                        // a `Segmented` -- so the row shows one and steps.
                        Label { text: "Add a question"; }

                        HorizontalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;

                            Btn {
                                label: "Prev";
                                kind: 1;
                                h: 44px;
                                width: 64px;
                                enabled: !root.busy;
                                clicked => { root.sec-prompt-step(-1); }
                            }

                            Rectangle {
                                vertical-stretch: 0;
                                height: 44px;
                                border-radius: 10px;
                                background: #ffffff0a;
                                border-width: 1px;
                                border-color: Theme.border;
                                clip: true;

                                Text {
                                    x: 12px;
                                    width: parent.width - 24px;
                                    height: parent.height;
                                    text: root.sec-new-prompt;
                                    color: Theme.text;
                                    font-size: 13px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }

                            Btn {
                                label: "Next";
                                kind: 1;
                                h: 44px;
                                width: 64px;
                                enabled: !root.busy;
                                clicked => { root.sec-prompt-step(1); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;

                            Field {
                                value <=> root.sec-new-answer;
                                placeholder: "Your answer";
                                autofocus: false;
                                accepted => { root.sec-question-add(); }
                            }
                            Btn {
                                label: "Add";
                                kind: 0;
                                h: 44px;
                                width: 76px;
                                enabled: !root.busy && root.sec-new-answer != "";
                                clicked => { root.sec-question-add(); }
                            }
                        }

                        if (root.sec-answer-error != "") : Text {
                            text: root.sec-answer-error;
                            color: Theme.danger;
                            font-size: 12.5px;
                            wrap: word-wrap;
                        }
                    }

                    // ---- Passkey --------------------------------------
                    // Shown, and honestly reported as unavailable. A stored
                    // field that claims to be a passkey but is not one is worse
                    // than no field, because the user would trust it.
                    if (root.sec-tab == "passkey") : VerticalLayout {
                        spacing: 8px;
                        vertical-stretch: 0;

                        Note {
                            text: "Passkeys need a server to register the credential against. This vault has no server, so a real passkey cannot be issued here.";
                        }
                    }
                }

                // ---- Reminders -----------------------------------------
                if (root.section-index == 3) : VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 0;

                    Label { text: "Rotation reminder"; }
                    Segmented {
                        options: ["Follow global", "15 min", "1 hour", "12 hours", "1 day", "7 days", "30 days", "90 days"];
                        selected: root.reminder-index;
                        changed(i) => { root.reminder-picked(i); }
                    }
                    Note {
                        text: "Overrides the global stale-password setting for this login only. The stale badge, the Weak channel and the dashboard all follow it.";
                    }
                }

                // ---- Appearance ----------------------------------------
                // Port of `ThemePicker` (ItemEditor.tsx L890): the preset
                // swatches, the custom hue, then the two image URLs. Uploads
                // are deliberately absent until `platform.rs` grows an open
                // dialog — a button that cannot open one is worse than no
                // button — and the preview shows the gradient rather than the
                // photo, because nothing on this screen decodes an image yet.
                if (root.section-index == 5) : VerticalLayout {
                    spacing: 16px;
                    vertical-stretch: 0;

                    VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        Label { text: "Colour theme"; }

                        HorizontalLayout {
                            spacing: 6px;
                            vertical-stretch: 0;
                            alignment: start;

                            for swatch in root.hue-swatches : Rectangle {
                                width: 66px;
                                height: 62px;
                                vertical-stretch: 0;
                                border-radius: 10px;
                                background: #ffffff0a;
                                border-width: 2px;
                                // -1 is Auto's own hue, so the check also
                                // lights up when the draft derives its colour.
                                border-color: root.accent-hue == swatch.hue ? Theme.accent : #00000000;

                                touch := TouchArea {
                                    clicked => { root.hue-picked(swatch.hue); }
                                }
                                Rectangle {
                                    x: (parent.width - 42px) / 2;
                                    y: 9px;
                                    width: 42px;
                                    height: 26px;
                                    border-radius: 8px;
                                    background: @linear-gradient(135deg, swatch.from, swatch.to);
                                    border-width: 1px;
                                    border-color: #ffffff26;
                                }
                                Text {
                                    y: 39px;
                                    width: parent.width;
                                    height: 16px;
                                    text: swatch.label;
                                    color: touch.has-hover ? Theme.text : Theme.muted;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Slider {
                        label: "Custom hue";
                        formatted: root.hue-readout;
                        minimum: 0;
                        maximum: 359;
                        value <=> root.hue-slider;
                        changed(value) => {
                            root.hue-slider = round(value);
                            root.hue-picked(round(value));
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        Label { text: "Background image"; }

                        Rectangle {
                            height: 92px;
                            vertical-stretch: 0;
                            border-radius: 12px;
                            background: @linear-gradient(135deg, root.preview-from, root.preview-to);
                            clip: true;

                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: root.preview-initial;
                                color: #ffffffe6;
                                font-size: 34px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;
                            Field {
                                value <=> root.bg-image;
                                placeholder: "https://example.com/photo.jpg";
                                autofocus: false;
                            }
                            if (root.bg-image != "") : Btn {
                                label: "Remove";
                                kind: 1;
                                h: 44px;
                                width: 90px;
                                clicked => { root.bg-image = ""; }
                            }
                        }
                        Note {
                            text: "A URL is fetched when the card renders, and only http(s) or an inline image is accepted. An image stored inside the record never leaves this device.";
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        Label { text: "Icon image"; }
                        HorizontalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;
                            Field {
                                value <=> root.avatar-image;
                                placeholder: "https://example.com/logo.png";
                                autofocus: false;
                            }
                            if (root.avatar-image != "") : Btn {
                                label: "Remove";
                                kind: 1;
                                h: 44px;
                                width: 90px;
                                clicked => { root.avatar-image = ""; }
                            }
                        }
                        Note {
                            text: "Separate from the card background, so a logo stays readable at 40px while the card keeps its photo. Leave it empty to fall back to the background image.";
                        }
                    }

                    // Only once a background exists: `backgroundBlur` is read
                    // with `?? 0` in TS, and a slider for an image that is
                    // not there is a control over nothing.
                    if (root.bg-image != "") : Slider {
                        label: "Background blur";
                        formatted: root.blur-readout;
                        minimum: 0;
                        maximum: 8;
                        value <=> root.bg-blur;
                        changed(value) => {
                            root.bg-blur = round(value);
                            root.bg-blur-changed(round(value));
                        }
                    }
                }

                // ---- Notes ---------------------------------------------
                if (root.section-index == 6) : VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 1;

                    Label { text: "Notes"; }
                    Area {
                        value <=> root.notes;
                        placeholder: "Recovery codes, security questions, anything else";
                        lines: 10;
                    }
                }

                // ---- Inbox ----------------------------------------------
                // The two per-login controls are real today and round-trip
                // through the record. The mailbox list itself arrives with
                // the mail engine, so this says what is and is not wired
                // rather than showing a form that cannot connect anything.
                if (root.section-index == 7) : VerticalLayout {
                    spacing: 14px;
                    vertical-stretch: 0;

                    Toggle {
                        label: "Show messages on this login";
                        hint: root.show-mail
                            ? "This login shows its Messages button."
                            : "Switched off here, so this login shows no Messages button.";
                        checked <=> root.show-mail;
                    }
                    Note {
                        text: "A login whose email is a connected mailbox reads that mailbox — the address it was connected for, never another login's mail. Other logins stay off: switch this on and this one reads the channel's mail scope instead.";
                    }

                    if (root.show-mail) : VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        Label { text: "Which messages"; }
                        Segmented {
                            options: ["Auto", "Matched only", "Recent only"];
                            selected: root.mail-filter-index;
                            changed(i) => { root.mail-filter-picked(i); }
                        }
                        Note {
                            text: "Auto: its mailbox, else only mail matched to this login. Matched only: mail to this login and nothing else. Recent only: everything recent, unmatched.";
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        Label { text: "Mailbox"; }
                        Note {
                            text: "Mailboxes are shared across the vault — connecting one makes it available everywhere, and only the logins whose address matches read it. None can be connected in this build yet.";
                        }
                    }
                }

                // ---- Flags ----------------------------------------------
                if (root.section-index == 8) : VerticalLayout {
                    spacing: 14px;
                    vertical-stretch: 0;

                    Toggle {
                        label: "Add to favourites";
                        hint: "Floats to the top of every sort mode.";
                        checked <=> root.favorite;
                    }

                    Toggle {
                        label: "Needs attention";
                        hint: "Your own flag, not a health guess. Counts towards the Needs attention channel.";
                        checked <=> root.needs-attention;
                    }
                }

                // ---- The cell that keeps the footer at the foot ---------
                // The body's height is the *smallest* of its three children's
                // maximums, and this panel's maximum is the sum of the section
                // it holds, so the body cannot always claim the spare height
                // of the window. The footer takes what the body could not
                // (see below); this cell only has to leave it room.
            }
        }

        // ---- The cell that lets the window open at its own size -------
        // A window opens at its `preferred` size, but clamped into
        // `[min, max]`, and for a stretch layout that maximum is the sum of
        // its children's maximums. Every child of this body has a declared
        // width, so the body's maximum is just the width of its content --
        // and `preferred_size()` then measured the editor at 880 wide, which
        // is what the window was created at. A cell with nothing declared on
        // it has an unbounded maximum (the sum overflows to infinity) and,
        // with `horizontal-stretch: 0` and a preferred size of zero, takes
        // no space in the row.
        Rectangle {
            horizontal-stretch: 0;
        }
    }

    // ---- Footer ------------------------------------------------------
    // The cell claims whatever height the body above could not, and the
    // band sits at the *bottom* of that cell, so Cancel / Save stay flush
    // with the foot of the window however the space above it is split.
    Rectangle {
        vertical-stretch: 1;

        Rectangle {
            y: parent.height - 72px;
            height: 72px;
            background: Theme.bg-deep;

            HorizontalLayout {
                padding-left: 26px;
                padding-right: 26px;
                spacing: 10px;
                alignment: end;

                if (root.confirm-delete) : Text {
                    text: "Delete this login? It goes to undo.";
                    color: Theme.danger;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }

                if (root.confirm-delete) : Btn {
                    label: "Keep it";
                    kind: 1;
                    h: 40px;
                    clicked => { root.confirm-cancelled(); }
                }

                if (root.confirm-delete) : Btn {
                    label: "Delete";
                    kind: 0;
                    h: 40px;
                    enabled: !root.busy;
                    clicked => { root.delete-confirmed(); }
                }

                if (!root.confirm-delete) : Btn {
                    label: "Cancel";
                    kind: 1;
                    h: 40px;
                    enabled: !root.busy;
                    clicked => { root.cancel-clicked(); }
                }

                if (!root.confirm-delete) : Btn {
                    label: root.busy ? "Working..." : (root.edit-id == "" ? "Add to vault" : "Save changes");
                    kind: 0;
                    h: 40px;
                    width: 148px;
                    enabled: !root.busy;
                    clicked => { root.save-clicked(); }
                }
            }
        }
    }

    // ---- The same cell, down the other axis --------------------------
    // The window's height is clamped the same way its width is: the root
    // layout's maximum is `58 + body + 72`, so the editor asked for a window
    // 414 tall on Identity and 400 on the shortest section -- which is what
    // it opened at, whatever `preferred-height` said. Same remedy: one cell
    // that declares no size, so the maximum is unbounded, and `stretch: 0`
    // so it leaves all of the spare height to the body.
    Rectangle {
        vertical-stretch: 0;
    }
}
