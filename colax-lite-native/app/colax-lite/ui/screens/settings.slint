// The Settings window — Phase 5. The chrome of SettingsWindow.tsx with
// Settings.tsx's panels behind it: an in-page modal over the whole app, a
// 248px rail of tabs on the left, a header carrying the section's hint and
// the close button, and a body that scrolls (app.css L932-951). Escape and
// Ctrl+1..9 work while it is open, as they do in the TS, and clicking the
// dimmed sheet outside the window closes it.
//
// The rail lists all thirteen tabs from the start: the Ctrl+number indices
// and the dashboard's deep links ("channels", "security") are promises that
// must not move as panels land. A panel that has not arrived yet says so
// with an empty state rather than pretending to be built; each later task
// replaces that branch with the real thing.
//
// Only the *appearance* panel lives here so far (Task 5.1). The eleven
// dials are two-way with the window root: a drag reaches Rust through
// `pref-*`, and Rust's saved answer flows back down the same chain.
import { Theme } from "../theme.slint";
import {
    Alert, Slider, Toggle, EmptyState, IconButton, Btn, Field, Chip, Label, Modal
} from "../widgets.slint";
import { QuestionRow, QrCell, ChannelRow, TagRow, AccentChip, OptProfileRow, DockManagerRow } from "../models.slint";
import { SecurityForm } from "security_form.slint";

/// One entry of the rail. The order is the TS's `tabs` array
/// (Settings.tsx L500) and must match `SETTINGS_TABS` in main.rs; `num` is
/// the Ctrl+number hint printed at the row's far end.
struct Tab {
    id: string,
    glyph: string,
    label: string,
    hint: string,
    num: string,
}

/// One row of the Hidden tab. `heading` is set on the first row of each
/// group and empty on its siblings — Slint cannot group a model after the
/// fact, and the TS heading carries the group's own count
/// (`{group} ({list.length})`). `key` is the pref key for a switch row, or
/// the list ("button"/"channel"/"folder") for a hidden id, which then rides
/// in `id`.
export struct HiddenRow {
    heading: string,
    label: string,
    detail: string,
    key: string,
    id: string,
}

/// One stored alarm in the Alarms tab. Every cell is already the string the
/// row shows — "No label" when the alarm has none, "Every day" or "Sun, Tue"
/// for its days (AlarmsPanel.tsx L70-73) — and `id` is what Test, the dot and
/// the bin send back, so a row does not address its alarm by position.
export struct AlarmRow {
    id: string,
    time: string,
    label: string,
    days: string,
    enabled: bool,
}

/// One of the seven day chips in the New alarm card: `Sun`..`Sat` in
/// `Date.getDay()` order, lit when the draft has picked it.
export struct DayChip {
    label: string,
    on: bool,
}

// `.alarms__dot`: the circle that enables a row (AlarmsPanel.tsx L86-91),
// green when the alarm is on. A dot rather than the settings Toggle because
// this value comes from a model element, and a model element cannot be
// two-way bound: the click goes to Rust and the push that follows repaints it.
component alarm-dot inherits Rectangle {
    in property <bool> on;
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: touch.has-hover ? #ffffff1a : #00000000;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Rectangle {
        width: 10px;
        height: 10px;
        border-radius: 5px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        // hsl(152 55% 55%), the `.alarms__dot--on` green; `Theme.faint` is
        // the off dot's --text-faint.
        background: root.on ? #5ec98f : Theme.faint;
    }
}

// The 26x18 swatch behind each theme choice (`ThemePreview`, Settings.tsx
// L2483): fixed light / dark / split gradients — never the live palette, or
// all three options would preview whatever is on right now.
component theme-preview inherits Rectangle {
    in property <string> mode;

    width: 26px;
    height: 18px;
    border-radius: 5px;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    background: root.mode == "dark"
        ? @linear-gradient(140deg, #2e3542, #11151c)
        : root.mode == "system"
            ? @linear-gradient(90deg, #ffffff 0%, #ffffff 50%, #2e3542 50%, #2e3542 100%)
            : @linear-gradient(140deg, #ffffff, #d7e0e9);

    // The accent bar along the bottom — `--grad-primary` in the TS.
    Rectangle {
        x: 2px;
        y: parent.height - 5px;
        width: parent.width - 4px;
        height: 3px;
        border-radius: 2px;
        opacity: 0.95;
        background: @linear-gradient(135deg, Theme.grad-from, Theme.grad-to);
    }
}

// The `.setting` shell every row shares: label and hint on the left, the
// control hugging the right, a hairline under the row (app.css L769, L858).
// Slint has no slots, so each control kind is its own row component — the
// shell repeats, the behaviour does not.
//
// A heading with no control at all: the `stacked` Row of Settings.tsx
// (`<Row label="Character sets" hint="At least one must stay on." stacked>`),
// which groups the switches under it without repeating the sentence five
// times. Same width rule as the rows around it.
component group-row inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in property <length> panel-w: 704px;
    width: root.panel-w;
    height: shell.preferred-height;

    shell := VerticalLayout {
        spacing: 3px;
        padding-top: 16px;
        padding-bottom: 8px;

        Text {
            text: root.label;
            color: Theme.text;
            font-size: 13.5px;
            font-weight: 600;
        }
        if (root.hint != "") : Text {
            text: root.hint;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
            width: root.panel-w;
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}

component toggle-row inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in-out property <bool> checked;
    // The locked switch: the Optimize tab shows two savings already in place
    // ("Remove background image" with no picture, "Slower mail polling" with
    // no mailbox), which the TS draws as disabled `checked` rows.
    in property <bool> enabled: true;
    // The rule under the row. The panels want it; the confirm sheets -- the
    // TS's bare `.toggle-row` inside a modal -- do not.
    in property <bool> hairline: true;
    callback toggled();
    // The body panel's inner width, from the window root. It is a property
    // and not a derivation: a width taken from this row's own layout would
    // meet the height that layout is built from — a loop the compiler
    // refuses (Slint treats a layout's info as one dependency).
    in property <length> panel-w: 704px;
    width: root.panel-w;
    height: shell.preferred-height;

    shell := HorizontalLayout {
        alignment: space-between;
        spacing: 16px;
        padding-top: 14px;
        padding-bottom: 14px;

        VerticalLayout {
            // 216px: the 200px slider column plus the 16px gap. The hint
            // wraps, so its column is a measurement from above the modal,
            // never one from inside it.
            width: root.panel-w - 216px;
            spacing: 3px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 13.5px;
                font-weight: 600;
            }
            if (root.hint != "") : Text {
                text: root.hint;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        Toggle {
            // Pinned: the switch's own width is a layout calculation, and a
            // stretch child here is the one edge that turns the row's
            // layout-info loop from a warning into an error.
            width: 44px;
            horizontal-stretch: 0;
            checked <=> root.checked;
            enabled: root.enabled;
            toggled => { root.toggled(); }
        }
    }

    Rectangle {
        visible: root.hairline;
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}

// A slider row: text on the left, the track in a fixed 200px column on the
// right with the formatted value under it (Settings.tsx's local `Slider`,
// L2432, which is a `.setting` wrapping an input and a `.slider-row`).
component slider-row inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step;
    in property <string> formatted;
    in-out property <float> value;
    callback changed(float);

    // See `toggle-row` for why the width is a property from outside.
    in property <length> panel-w: 704px;
    width: root.panel-w;
    height: shell.preferred-height;

    shell := HorizontalLayout {
        alignment: space-between;
        spacing: 16px;
        padding-top: 14px;
        padding-bottom: 14px;

        VerticalLayout {
            width: root.panel-w - 216px;
            spacing: 3px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 13.5px;
                font-weight: 600;
            }
            if (root.hint != "") : Text {
                text: root.hint;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            width: 200px;
            horizontal-stretch: 0;
            spacing: 2px;

            Slider {
                minimum: root.minimum;
                maximum: root.maximum;
                step: root.step;
                value <=> root.value;
                label: "";
                formatted: "";
                changed(v) => { root.changed(v); }
            }

            Text {
                text: root.formatted;
                color: Theme.faint;
                font-size: 12px;
                horizontal-alignment: right;
            }
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}

// A segmented row: the pill box of `.segmented` (app.css L752), but with
// the settings window's *neutral* selected state — plate fill, stronger
// border, full-strength text (`.segmented__option[aria-pressed=true]`, not
// an accent fill). `ids` are the pref values behind the labels and must be
// the same length: the index comes along for the ride.
component seg-row inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in property <[string]> options;
    in property <[string]> ids;
    in property <string> value;
    callback picked(string);

    // See `toggle-row` for why the width is a property from outside.
    in property <length> panel-w: 704px;
    width: root.panel-w;
    height: shell.preferred-height;

    shell := HorizontalLayout {
        alignment: space-between;
        spacing: 16px;
        padding-top: 14px;
        padding-bottom: 14px;

        VerticalLayout {
            width: root.panel-w - 216px;
            spacing: 3px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 13.5px;
                font-weight: 600;
            }
            if (root.hint != "") : Text {
                text: root.hint;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        Rectangle {
            width: pills.preferred-width + 6px;
            height: 36px;
            horizontal-stretch: 0;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.glass;

            pills := HorizontalLayout {
                padding: 3px;
                spacing: 4px;

                for opt[i] in root.options : Rectangle {
                    width: opt-label.preferred-width + 24px;
                    height: 30px;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: root.ids[i] == root.value ? Theme.border-strong : #00000000;
                    background: root.ids[i] == root.value
                        ? Theme.plate
                        : (pill-touch.has-hover ? #ffffff1a : #00000000);
                    pill-touch := TouchArea {
                        clicked => { root.picked(root.ids[i]); }
                    }
                    opt-label := Text {
                        width: parent.width;
                        height: parent.height;
                        text: opt;
                        color: root.ids[i] == root.value ? Theme.text : Theme.muted;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}

// A plain row whose control is a secondary button — the Hidden tab's "Show"
// and "Show all N" (Settings.tsx L1116, L1147). `.btn--secondary` is `kind: 1`
// on the shared Btn.
component btn-row inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in property <string> button-text: "Show";
    // The Btn kinds: 1 = secondary (the default for a row action),
    // 3 = danger ("Delete everything").
    in property <int> button-kind: 1;
    in property <bool> button-enabled: true;
    callback clicked();

    // See `toggle-row` for why the width is a property from outside.
    in property <length> panel-w: 704px;
    width: root.panel-w;
    height: shell.preferred-height;

    shell := HorizontalLayout {
        alignment: space-between;
        spacing: 16px;
        padding-top: 14px;
        padding-bottom: 14px;

        VerticalLayout {
            width: root.panel-w - 216px;
            spacing: 3px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 13.5px;
                font-weight: 600;
            }
            if (root.hint != "") : Text {
                text: root.hint;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        Btn {
            horizontal-stretch: 0;
            kind: root.button-kind;
            enabled: root.button-enabled;
            h: 34px;
            label: root.button-text;
            clicked => { root.clicked(); }
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}

// One wrapped segmented pill. Its own component because a `for` body cannot
// be shared between the two rows of `seg-stack-row` — and it has to be
// declared before them, the way Slint resolves elements in order.
component pill inherits Rectangle {
    in property <int> option-index: 0;
    in property <[string]> labels;
    in property <[string]> ids;
    in property <string> value;
    callback picked(string);

    horizontal-stretch: 1;
    height: 34px;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.ids[root.option-index] == root.value ? Theme.border-strong : #00000000;
    background: root.ids[root.option-index] == root.value
        ? Theme.plate
        : (pill-touch.has-hover ? #ffffff1a : #00000000);

    pill-touch := TouchArea {
        clicked => { root.picked(root.ids[root.option-index]); }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.labels[root.option-index];
        color: root.ids[root.option-index] == root.value ? Theme.text : Theme.muted;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A stacked row: label and hint above, then the control across the full
// panel width — `.setting--stack` (app.css L776). The option-card groups and
// the sort pills use it, because what they show is a set of choices rather
// than a value on a line.
component cards-row inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    // One entry per card: the title, the faint note beside it and, for the
    // view cards, a glyph. `notes` and `icons` may be shorter than `titles`;
    // an empty entry draws nothing.
    in property <[string]> titles;
    in property <[string]> notes;
    in property <[string]> icons;
    in property <[string]> ids;
    in property <string> value;
    callback picked(string);

    // See `toggle-row` for why the width is a property from outside.
    in property <length> panel-w: 704px;
    width: root.panel-w;
    height: stack.preferred-height;

    stack := VerticalLayout {
        spacing: 12px;
        padding-top: 14px;
        padding-bottom: 14px;

        VerticalLayout {
            spacing: 3px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 13.5px;
                font-weight: 600;
            }
            if (root.hint != "") : Text {
                text: root.hint;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                width: root.panel-w;
            }
        }

        // `.option-cards`: equal thirds, each a centred line. Only the
        // pressed card paints, which is why a group shows one plate.
        HorizontalLayout {
            spacing: 8px;

            for title[i] in root.titles : Rectangle {
                horizontal-stretch: 1;
                height: 40px;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: root.ids[i] == root.value ? Theme.border-strong : #00000000;
                background: root.ids[i] == root.value
                    ? Theme.plate
                    : (card-touch.has-hover ? #ffffff0d : #00000000);

                card-touch := TouchArea {
                    clicked => { root.picked(root.ids[i]); }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    if (i < root.icons.length && root.icons[i] != "") : Text {
                        text: root.icons[i];
                        color: root.ids[i] == root.value ? Theme.text : Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: title;
                        color: root.ids[i] == root.value ? Theme.text : Theme.muted;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if (i < root.notes.length && root.notes[i] != "") : Text {
                        text: root.notes[i];
                        color: Theme.faint;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}

// A segmented row that stacks: the six sort orders are longer than the four
// density pills of `seg-row`, so the choices run one per line across the
// panel instead of a single clipped line (`.segmented--wrap`, app.css L752).
// Same neutral pressed state as `seg-row`, and the options list itself drives
// the walk — six choices stack six pills, the Security tab's seven stack
// seven, and no pill can read past the end of a short list.
component seg-stack-row inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in property <[string]> options;
    in property <[string]> ids;
    in property <string> value;
    callback picked(string);

    // See `toggle-row` for why the width is a property from outside.
    in property <length> panel-w: 704px;
    width: root.panel-w;
    height: stack.preferred-height;

    stack := VerticalLayout {
        spacing: 12px;
        padding-top: 14px;
        padding-bottom: 14px;

        VerticalLayout {
            spacing: 3px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 13.5px;
                font-weight: 600;
            }
            if (root.hint != "") : Text {
                text: root.hint;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                width: root.panel-w;
            }
        }

        VerticalLayout {
            spacing: 6px;

            // The list drives the walk: six choices stack six pills and the
            // seven-choice password-age list stacks seven — there is no count
            // to keep in step, and no pill can read past the end of a short
            // list. (The Security tab's pickers are the same stack the sort
            // picker wears, one option per line across the panel.)
            for option[i] in root.options : pill {
                option-index: i;
                labels: root.options;
                ids: root.ids;
                value: root.value;
                picked(id) => { root.picked(id); }
            }
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}

// The Security tab's four groups (Settings.tsx L166-171). Seventeen rows in
// one column read as a wall, so the same two-level shape the Optimize tab
// uses keeps each list short. `.subtabs` is a sunken well of quiet pills with
// the live one on the plate; picking is a plain write, because the chosen
// group never leaves this window.
component sub-tabs inherits Rectangle {
    in property <[string]> labels: [];
    in-out property <int> active: 0;

    height: 34px;
    horizontal-stretch: 0;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    background: #ffffff08;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;

        for label[i] in root.labels : Rectangle {
            height: 28px;
            horizontal-stretch: 0;
            border-radius: 7px;
            background: root.active == i
                ? Theme.plate
                : (tab-touch.has-hover ? #ffffff1a : #00000000);

            tab-touch := TouchArea {
                clicked => { root.active = i; }
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;

                Text {
                    text: label;
                    color: root.active == i ? Theme.text : Theme.muted;
                    font-size: 12.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// A row whose right-hand control is a read-only chip: the crypto in force
// (Settings.tsx L1295-1306) is a fact, not a dial — the chip look without a
// press. `accent` lights it the way `.chip--accent` does (the Data tab's
// App version); the plain reading is `.chip--muted`.
component chip-row inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in property <string> chip-text;
    in property <bool> accent: false;

    in property <length> panel-w: 704px;
    width: root.panel-w;
    height: shell.preferred-height;

    shell := HorizontalLayout {
        alignment: space-between;
        spacing: 16px;
        padding-top: 14px;
        padding-bottom: 14px;

        // The text column gives way to the pill, not the other way round: a
        // long reading (the App version stamp) must not be clipped by the
        // panel, so the row's leftover space comes off this column and its
        // hint wraps instead.
        VerticalLayout {
            width: root.panel-w - reading-chip.preferred-width - 16px;
            spacing: 3px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 13.5px;
                font-weight: 600;
            }
            if (root.hint != "") : Text {
                text: root.hint;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        reading-chip := Chip {
            label: root.chip-text;
            selected: root.accent;
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}

// The confirm sheets the Data and Backup tabs open, and the shared channel
// editor Settings › Channels opens, all wear `Modal` from widgets.slint
// (`<Modal>` in primitives.tsx L6; `.overlay`/`.modal` in app.css L726-737).
// It was a local component here until the editor — which is opened from the
// rail as well as from a panel — needed the same shell; one wash and one
// plate cannot drift.

/// The small `built-in` / `hidden` badge on a channel row
/// (`.tag-manager__badge`). A plain rectangle rather than a widget: it is
/// four words in the whole app, and `Chip` carries a hue and a hover it has
/// no use for.
component row-badge inherits Rectangle {
    in property <string> label;

    height: 15px;
    width: badge-text.preferred-width + 12px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 5px;
    background: #ffffff14;

    badge-text := Text {
        x: 6px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: Theme.faint;
        font-size: 9.5px;
        font-weight: 600;
    }
}

/// One row of Settings › Channels (`ChannelManager.tsx` L115-150): the dot in
/// the channel's colour, the name (a way into the shared editor) with its
/// badges, the count and what the filter is, the eye, and the pencil. Both
/// icon buttons are the TS's `.btn--icon` pair and do the same thing as the
/// name; the eye is the one that is not obvious, so the glyphs are the two
/// the Hidden tab already uses — `◉` shown, `⊘` hidden.
component chan-row inherits Rectangle {
    // Not `row`: that is a deprecated built-in property on every element, so
    // Slint refuses to override it. `entry` is the row's own data.
    in property <ChannelRow> entry;
    callback open(id: string);
    callback toggle(id: string);

    height: 40px;
    border-radius: Theme.radius-sm;
    background: chan-hover.has-hover ? Theme.row-hover : #00000000;

    chan-hover := TouchArea {}

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 10px;

        Rectangle {
            horizontal-stretch: 0;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.entry.hue;
            // A hidden channel's dot dims with its name, so the eye's state
            // reads off the row itself.
            opacity: root.entry.hidden ? 0.4 : 1.0;
        }

        chan-name := TouchArea {
            horizontal-stretch: 1;
            clicked => { root.open(root.entry.id); }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.entry.name;
                    color: root.entry.hidden ? Theme.muted : Theme.text;
                    font-size: 13px;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if (root.entry.builtin) : row-badge { label: "built-in"; }
                if (root.entry.hidden) : row-badge { label: "hidden"; }
                // The count and the filter sit at the row's far end, the way
                // the TS's `.tag-manager__count` does.
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.entry.detail;
                    color: Theme.faint;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }
            }
        }

        IconButton {
            horizontal-stretch: 0;
            icon: root.entry.hidden ? "⊘" : "◉";
            clicked => { root.toggle(root.entry.id); }
        }

        IconButton {
            horizontal-stretch: 0;
            icon: "✎";
            clicked => { root.open(root.entry.id); }
        }
    }
}

/// One tag of Settings › Channels (`ChannelManager.tsx` L219-281): the dot,
/// the name (or the box renaming it), the swatch (or the range recolouring
/// it), how many channels watch it, and the delete button.
///
/// The hue range is a row of its own *below* the tag rather than inline: the
/// TS's bare `<input type=range>` is 16px tall and Slint's `Slider` carries a
/// 44px shell with a label row, which would stretch the tag's own row under
/// it. Same control, same range 0..359, one line down.
component tag-manager-row inherits VerticalLayout {
    // See `chan-row` for why this is `entry` and not `row`.
    in property <TagRow> entry;
    // The name being retyped and the hue being dragged. Both are the row's
    // own in-out properties, seeded from the model: a repeated row cannot
    // write back into a model, and `Field`/`Slider` need somewhere to type
    // or drag. The callbacks carry the new values up, so Rust never has to
    // read a value Slint owns.
    in-out property <string> rename-text: root.entry.name;
    in-out property <float> hue-value: root.entry.hue-value;
    callback rename-start(id: string);
    callback renamed(id: string, name: string);
    // Enter in the rename box: the name has already been written on every
    // keystroke, this only puts the row back to showing it.
    callback rename-done(id: string);
    callback hue-toggle(id: string);
    callback hue-changed(id: string, value: float);
    callback delete(id: string);

    spacing: 4px;
    vertical-stretch: 0;

    Rectangle {
        height: 40px;
        border-radius: Theme.radius-sm;
        background: tag-hover.has-hover ? Theme.row-hover : #00000000;

        tag-hover := TouchArea {}

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 6px;
            spacing: 10px;

            Rectangle {
                horizontal-stretch: 0;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.entry.hue;
            }

            if (root.entry.editing) : VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                tag-field := Field {
                    horizontal-stretch: 1;
                    value <=> root.rename-text;
                    autofocus: true;
                    accepted => { root.renamed(root.entry.id, tag-field.value); root.rename-done(root.entry.id); }
                    edited => { root.renamed(root.entry.id, tag-field.value); }
                }
            }

            if (!root.entry.editing) : VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                tag-name := TouchArea {
                    clicked => { root.rename-start(root.entry.id); }
                    Text {
                        text: root.entry.name;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            if (root.entry.hue-open) : Rectangle {
                horizontal-stretch: 0;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: 2px;
                border-color: Theme.border-strong;
                background: root.entry.hue;
            }
            if (!root.entry.hue-open) : Rectangle {
                horizontal-stretch: 0;
                width: 18px;
                height: 18px;
                border-radius: 5px;
                background: root.entry.hue;
                TouchArea {
                    clicked => { root.hue-toggle(root.entry.id); }
                }
            }

            // The TS puts the count after the swatch, not before it.
            Text {
                horizontal-stretch: 0;
                text: root.entry.usage;
                color: Theme.faint;
                font-size: 11.5px;
                vertical-alignment: center;
            }

            IconButton {
                horizontal-stretch: 0;
                icon: "×";
                clicked => { root.delete(root.entry.id); }
            }
        }
    }

    if (root.entry.hue-open) : Rectangle {
        height: 40px;
        Rectangle {
            x: 18px;
            width: parent.width - 18px;
            height: parent.height;
            Slider {
                minimum: 0;
                maximum: 359;
                step: 1;
                value <=> root.hue-value;
                label: "";
                formatted: "";
                changed(v) => { root.hue-changed(root.entry.id, v); }
            }
        }
    }
}

/// One row of the dock manager (Task 8.3): a bar's header, or one of its
/// slots. A slot whose target is gone draws faint and offers only Remove, so a
/// deleted channel is visible and fixable rather than a silent gap
/// (DockSettings.tsx L5-11). Reordering and rekeying live here too: the key is
/// the Key button, and moving is a menu action on the slot.
component dock-manager-row inherits Rectangle {
    in property <DockManagerRow> entry;
    callback toggle(bool);
    callback remove-bar();
    callback key();
    callback menu(x: float, y: float);
    callback remove-slot();
    callback add-slot();

    height: root.entry.kind == "dock" ? 48px : 40px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.entry.missing ? Theme.border-strong : Theme.border;
    background: root.entry.kind == "dock" ? Theme.surface : Theme.field;

    if (root.entry.kind == "dock") : HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 8px;
        alignment: center;

        Text {
            text: root.entry.glyph;
            color: Theme.faint;
            font-size: 15px;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            alignment: center;
            Text {
                text: root.entry.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
            }
            Text {
                text: root.entry.enabled ? root.entry.hint : "{root.entry.hint} (hidden)";
                color: Theme.faint;
                font-size: 11px;
                overflow: elide;
            }
        }
        Btn {
            horizontal-stretch: 0;
            label: root.entry.enabled ? "Hide" : "Show";
            kind: 1;
            h: 28px;
            width: 62px;
            clicked => { root.toggle(!root.entry.enabled); }
        }
        Btn {
            horizontal-stretch: 0;
            label: "Add slot";
            kind: 1;
            h: 28px;
            width: 78px;
            clicked => { root.add-slot(); }
        }
        IconButton {
            icon: "×";
            clicked => { root.remove-bar(); }
        }
    }

    if (root.entry.kind == "slot") : HorizontalLayout {
        padding-left: 16px;
        padding-right: 6px;
        spacing: 8px;
        alignment: center;

        Rectangle {
            horizontal-stretch: 0;
            width: 26px;
            height: 26px;
            border-radius: Theme.radius-sm;
            background: Theme.surface;

            if (root.entry.has-dot) : Rectangle {
                x: 4px;
                y: 4px;
                width: 7px;
                height: 7px;
                border-radius: 4px;
                background: root.entry.dot;
            }
            Text {
                width: parent.width;
                height: parent.height;
                text: root.entry.glyph;
                color: root.entry.missing ? Theme.danger : Theme.muted;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            alignment: center;
            Text {
                text: root.entry.title;
                color: root.entry.missing ? Theme.danger : Theme.text;
                font-size: 12.5px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.entry.hint;
                color: Theme.faint;
                font-size: 11px;
                overflow: elide;
            }
        }
        if (!root.entry.missing) : Rectangle {
            horizontal-stretch: 0;
            width: 20px;
            height: 20px;
            border-radius: 5px;
            background: Theme.plate;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.entry.key;
                color: Theme.faint;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if (!root.entry.missing) : Btn {
            horizontal-stretch: 0;
            label: "Key";
            kind: 1;
            h: 26px;
            width: 50px;
            clicked => { root.key(); }
        }
        slot-menu := Rectangle {
            horizontal-stretch: 0;
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: slot-menu-touch.has-hover ? #ffffff1a : #ffffff0a;
            Text {
                width: parent.width;
                height: parent.height;
                text: "⋯";
                color: Theme.muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            slot-menu-touch := TouchArea {
                clicked => {
                    root.menu(
                        (self.absolute-position.x + self.mouse-x) / 1px,
                        (self.absolute-position.y + self.mouse-y) / 1px,
                    );
                }
            }
        }
        IconButton {
            icon: "×";
            clicked => { root.remove-slot(); }
        }
    }
}

export component Settings inherits Rectangle {
    // Which rail row is lit. Rust owns the id list and validates every jump
    // against it, so the index is all the window keeps — clamped before use
    // below, because an out-of-range index must not panic a modal.
    in property <int> tab-index: 0;

    // The modal's outer frame. Rust writes these from the window's own size
    // (`settings_ops::follow_window`) so the sheet shrinks with the window:
    // a `min(1080px, parent.width - 60px)` written in here would bind the
    // modal to the window's layout info, which is the binding loop the
    // fixed constants exist to avoid.
    in property <length> frame-w: 1080px;
    in property <length> frame-h: 700px;

    // The body panel's inner width — frame minus the 248px rail and the 32px
    // padding on each side. Same deal as the frame: Rust's, because every
    // wrapping hint below measures against it.
    in property <length> panel-w: 768px;

    // The appearance panel's eleven dials. Two-way with the window root: a
    // drag writes up through `pref-float`, the saved (and quantised) answer
    // flows back down and settles the widget.
    in-out property <string> ap-theme: "system";
    in-out property <string> ap-accent: "slate";
    in-out property <float> ap-motion: 1.0;
    in-out property <float> ap-motion-speed: 1.0;
    in-out property <float> ap-ambient: 1.0;
    in-out property <float> ap-text-scale: 100.0;
    in-out property <float> ap-roundness: 1.0;
    in-out property <float> ap-card-depth: 0.5;
    in-out property <string> ap-density: "comfortable";
    in-out property <bool> ap-reduce-transparency: false;
    in-out property <bool> ap-high-contrast: false;

    // The accent grid, pushed with the rest of the values when the window
    // opens (Rust owns the hue maths).
    in property <[AccentChip]> accent-chips: [];

    // The Layout tab's dials. The four pickers are the same preferences the
    // sidebar's own menus write, so both doors lead to one value; the
    // switches are the chrome the Hidden tab reads back.
    in-out property <string> lay-view: "animated";
    in-out property <string> lay-sort: "title";
    in-out property <string> lay-sidebar-labels: "both";
    in-out property <string> lay-rail-position: "left";
    in-out property <bool> lay-letter-groups: true;
    in-out property <bool> lay-auto-tag-domain: true;
    in-out property <bool> lay-unassigned-channel: true;
    in-out property <bool> lay-auto-tag-channel: false;
    in-out property <bool> lay-orbit-labels: true;
    in-out property <bool> lay-health-badges: true;
    in-out property <bool> lay-shortcuts: false;
    in-out property <bool> lay-lock-button: true;
    in-out property <bool> lay-new-channel-button: true;
    in-out property <bool> lay-compact-button: true;
    in-out property <bool> lay-new-login-button: true;
    in-out property <bool> lay-bulk-add-button: true;
    in-out property <bool> lay-settings-button: true;
    in-out property <bool> lay-hide-sidebar-button: true;
    in-out property <bool> lay-show-sidebar: true;
    in-out property <bool> lay-show-urls: true;
    in-out property <bool> lay-pin-favorites: true;
    in-out property <bool> lay-floating-chrome: true;
    in-out property <bool> lay-hide-dividers: false;

    // The Layout tab's dock manager (Task 8.3): one header row per bar, then
    // one row per slot, all built in Rust (`dock.rs::push`). The callbacks are
    // keyed by the row's own dock/slot indices, because the model is rebuilt on
    // every refresh and only the indices survive a write.
    in property <[DockManagerRow]> dock-rows: [];
    in property <bool> dock-recording: false;
    callback dock-key(text: string);
    callback dock-toggle(index: int, enabled: bool);
    callback dock-remove(index: int);
    callback dock-slot-key(index: int, slot: int);
    callback dock-slot-menu(index: int, slot: int, x: float, y: float);
    callback dock-slot-remove(index: int, slot: int);
    callback dock-add-slot(index: int);
    callback dock-add();

    // The Hidden tab is derived in Rust — it is a reading of the switches
    // above plus the three hidden lists — so it arrives as a model and is
    // never written back as a whole.
    in property <[HiddenRow]> hidden-rows: [];

    // The Desktop tab. These four are the shell flags: they are stored in the
    // vault *and* in shell.json, because the tray reads them before any vault
    // is unlocked. `desk-close-to-tray` is the TS's masked reading
    // (`closeToTray && trayEnabled`, Settings.tsx L1573): with the tray off the
    // row shows off, and a click still stores the flag.
    in-out property <bool> desk-launch-at-login: false;
    in-out property <bool> desk-tray: true;
    in-out property <bool> desk-close-to-tray: true;
    in-out property <bool> desk-mute: false;

    // The Generator tab. One object with the editor's own generator: these six
    // are the fields `passwordGenerator` holds, so a chip toggled in the editor
    // shows up here and vice versa. The label is formatted in Rust, the way
    // the editor's is.
    in-out property <float> gen-length: 20;
    in-out property <string> gen-length-label;
    in-out property <bool> gen-lower: true;
    in-out property <bool> gen-upper: true;
    in-out property <bool> gen-digits: true;
    in-out property <bool> gen-symbols: true;
    in-out property <bool> gen-avoid: true;

    // The Alarms tab. `alarm-rows` is the stored list and `alarm-day-chips`
    // is the draft's seven days; both are built in Rust, because the day
    // picks are not a key of the document. The label and the time are the
    // card's own two fields — Rust reads them when Add is pressed, the way
    // the editor's tag box is read — and `alarm-sound` names the imported
    // sound in the draft, empty while the built-in chime is chosen.
    in property <[AlarmRow]> alarm-rows: [];
    in property <[DayChip]> alarm-day-chips: [];
    in-out property <string> alarm-sound;
    in-out property <string> alarm-label;
    in-out property <string> alarm-time: "08:00";

    // The Security tab (Task 5.7). `sec-group` is the lit sub-tab: the four
    // groups of Settings.tsx L1245-1433, indexed in order. The rest are the
    // fourteen rows' values, plus `sec-kdf` - the rounds count is formatted in
    // Rust, because Slint cannot put a comma into a number.
    in-out property <int> sec-group: 0;
    in-out property <string> sec-auto-lock: "5";
    in-out property <string> sec-clipboard: "30";
    in-out property <string> sec-pw-age: "180";
    in-out property <string> sec-email-age: "365";
    in-out property <string> sec-email-check: "90";
    in-out property <bool> sec-clear-on-lock: true;
    in-out property <bool> sec-clip-capture: false;
    in-out property <bool> sec-clip-autosave: false;
    in-out property <bool> sec-warn-reuse: true;
    in-out property <bool> sec-tag-reused: true;
    in-out property <bool> sec-mask-emails: true;
    in-out property <bool> sec-confirm-export: false;
    in-out property <bool> sec-confirm-deletes: true;
    in-out property <bool> sec-copy-toasts: true;
    in property <string> sec-kdf;

    // The vault's own second factor: a `SecurityForm` instance bound to
    // `prefs.vaultSecurity`. The transient half — the typed code, the
    // passcode drafts, the checking row — are the window's own fields,
    // exactly as the editor's `sec-*` set is, because Rust reads them back
    // when a button fires. `vsec-questions` carries prompts only; the hashes
    // never leave Rust.
    in property <string> vsec-level: "none";
    in property <string> vsec-questions-note: "Not set";
    in property <bool> vsec-totp: false;
    in property <string> vsec-otpauth;
    in property <int> vsec-qr-size: 0;
    in property <[QrCell]> vsec-qr-cells;
    in property <bool> vsec-totp-staged: false;
    in property <string> vsec-totp-note;
    in-out property <string> vsec-totp-seed;
    in-out property <string> vsec-totp-code;
    in property <bool> vsec-passcode: false;
    in-out property <string> vsec-passcode-new;
    in-out property <string> vsec-passcode-confirm;
    in-out property <string> vsec-passcode-input;
    in property <string> vsec-passcode-error;
    in property <[QuestionRow]> vsec-questions;
    in property <string> vsec-answer-error;
    in-out property <string> vsec-checking-id;
    in-out property <string> vsec-check-input;
    in property <string> vsec-new-prompt;
    in-out property <string> vsec-new-answer;

    // ---- Data and Backup (Task 5.8) ---------------------------------------
    // The two chips' text is Rust's, composed where the numbers live: the
    // stored count and the vault file's real size, and the build stamp vite
    // would have baked into the web bundle. `data-count` gates the CSV
    // export's button, exactly as `items.length === 0` does in the TS.
    in property <string> data-stored: "0 · about 1 KB";
    in property <string> data-version;
    in property <int> data-count: 0;

    // "Protect this backup": the confirm-before-export sheet.
    in property <bool> data-protect-open: false;
    in-out property <string> data-export-password;
    in property <int> data-export-score: 0;

    // "Delete all data?": the sheet's message carries the count, so it is
    // composed in Rust beside the items.
    in property <bool> data-reset-open: false;
    in property <string> data-reset-message;

    // "Restore from backup": the sheet opens with the picked file's name.
    in property <string> data-restore-name;
    in property <string> data-restore-message;
    in property <string> data-restore-error;
    in-out property <string> data-restore-password;
    in-out property <bool> data-restore-passwordless: false;
    in-out property <bool> data-restore-rekey: false;
    in-out property <string> data-restore-next;
    in property <bool> data-restore-busy: false;
    // The submit button's own gate, rescored in Rust on every keystroke and
    // toggle: Slint has no string length to test `next.length < 10` with.
    in property <bool> data-restore-ready: false;

    // The Backup tab's first row hint: the count and the password warning,
    // both already composed the way the TS template composes them.
    in property <string> backup-hint; 

    // Native-only, and the one thing in this sheet with no TS counterpart:
    // whether an export carries the app's own settings — theme, folders,
    // channels, tags, alarms — beside the vault and its logins. See
    // `VaultPreferences.backup_with_settings`.
    in-out property <bool> backup-with-settings: true;

    // ---- About (Task 5.12) -------------------------------------------------
    // The running stamp (platform and version, built in Rust — there is no
    // build-time banner here to read).
    in property <string> about-version: "";
    callback about-copy-report();
    callback about-reset();

    // ---- Optimize (Task 5.11) ---------------------------------------------
    // Every reading is pushed from the document by `optimize_ops::push_panel`;
    // nothing here keeps a state by itself except which sub-group and rename
    // the user is in, which the TS also keeps local to the window.
    in-out property <int> opt-group: 0;
    // The counter and whether a trade-away has been recorded.
    in property <int> opt-count-on: 0;
    in property <bool> opt-snapshotted: false;
    in-out property <string> opt-active-profile: "";
    // The Look rows. The four compound ones are derived readings (the TS's
    // `checked` expressions); two-way so the Toggle can hand the new value to
    // its handler through the binding.
    in-out property <bool> opt-motion-off: false;
    in-out property <bool> opt-micro: true;
    in-out property <bool> opt-ambient-off: false;
    in-out property <bool> opt-transparency: false;
    in-out property <bool> opt-compact: false;
    in-out property <bool> opt-flat: false;
    // "Remove background image" is locked on while there is no picture.
    in-out property <bool> opt-no-picture: true;
    // The Messages rows.
    in-out property <bool> opt-mail-on: true;
    in-out property <bool> opt-mail-locked: false;
    in-out property <bool> opt-mail-images: true;
    in-out property <string> opt-page-size: "50";
    in-out property <bool> opt-cache-empty: true;
    in-out property <bool> opt-spellcheck: false;
    // Saved profiles: the rows, the save box (enabled until the twelfth
    // profile), and the rename pair — which profile is being retyped and what
    // the box says so far.
    in property <[OptProfileRow]> opt-profiles;
    in-out property <bool> opt-can-save: true;
    in-out property <string> opt-name: "";
    in-out property <string> opt-renamer: "";
    in-out property <string> opt-rename: "";
    // "n of 10" and its two trailing sentences, assembled in Rust — Slint
    // has no number-to-string it will promise, and the sentence changes with
    // the snapshot.
    in property <string> opt-readout: "";
    // "What it costs right now": formatted in Rust, em-dash when the OS does
    // not say.
    in property <string> opt-work: "—";
    in property <string> opt-priv: "—";

    // ---- Background (Task 5.9) --------------------------------------------
    // The URL draft is the window's own field, exactly as `BackgroundSection`'s
    // `url` state is the component's: typing does not write the preference
    // until the text is a bare `http(s)` URL or empty, so the field can hold
    // half-typed nonsense without a refused write settling it back.
    in-out property <string> bg-url;
    in property <string> bg-error;
    in property <bool> bg-has-image: false;
    // The three dials, pushed from the stored values on every refresh and
    // written back through the generic `pref-float`.
    in-out property <float> bg-opacity: 0.35;
    in-out property <float> bg-blur: 0;
    in-out property <float> bg-dim: 0.25;

    // ---- Channels (Task 5.10) ---------------------------------------------
    // The catalogue as rows: every channel the document holds, shipped or
    // made, with its count, its kind-or-tag detail, and whether its eye is
    // off. `hidden` also picks the eye's own glyph.
    in property <[ChannelRow]> chan-rows: [];
    // Hide all and Show all are two conditions rather than two buttons always
    // drawn: the TS shows Hide all while something is still visible and Show
    // all while something is hidden.
    in property <bool> chan-can-hide-all: false;
    in property <bool> chan-can-show-all: false;
    // The tag half: the catalogue with its usage text, the draft name in the
    // add box, and whether that draft is worth adding (Rust trims; Slint has
    // no `trim`).
    in property <[TagRow]> chan-tag-rows: [];
    in-out property <string> chan-tag-input;
    in property <bool> chan-tag-can-add: false;

    callback closed();
    callback tab-picked(index: int);
    callback pref-string(key: string, value: string);
    callback pref-float(key: string, value: float);
    callback pref-bool(key: string, value: bool);
    callback hidden-restore(key: string, id: string);
    callback hidden-restore-all();
    callback alarm-add();
    callback alarm-test(id: string);
    callback alarm-toggle(id: string);
    callback alarm-delete(id: string);
    callback alarm-day-toggled(index: int);
    callback alarm-import();
    callback alarm-reset-sound();
    // The Security tab's own: the lock button and the vault form's twelve
    // actions. The fourteen simple rows ride the generic `pref-*` callbacks
    // above, the way the Layout tab's do.
    callback security-lock();
    callback vsec-totp-attach();
    callback vsec-totp-generate();
    callback vsec-totp-check();
    callback vsec-totp-discard();
    callback vsec-totp-remove();
    callback vsec-passcode-save();
    callback vsec-passcode-check();
    callback vsec-passcode-remove();
    callback vsec-question-add();
    callback vsec-question-remove(id: string);
    callback vsec-question-check(id: string);
    callback vsec-prompt-step(delta: int);
    // Data and Backup: the row actions and the three sheets' own. The
    // sheets' fields ride in-out properties; only the presses come back.
    callback data-export-csv();
    callback data-import-csv();
    callback data-reset-open-clicked();
    callback data-reset-cancel();
    callback data-reset-confirmed();
    callback data-export-edited();
    callback data-protect-cancel();
    callback data-protect-confirm();
    callback backup-export();
    callback backup-restore-pick();
    callback backup-with-settings-toggled();
    // Optimize: the two presets and the two doors of "Restore my look", plus
    // one callback per compound row; the rest ride the generic `pref-bool` /
    // `pref-string` / `pref-float`.
    callback opt-balanced();
    callback opt-max();
    callback opt-restore();
    callback opt-motion-toggled();
    callback opt-ambient-toggled();
    callback opt-cards-toggled();
    callback opt-background-removed();
    // Saved profiles.
    callback opt-save-profile();
    callback opt-apply-profile(string);
    callback opt-rename-start(string);
    callback opt-rename-commit(string);
    callback opt-rename-cancel();
    callback opt-overwrite(string);
    callback opt-delete-profile(string);
    // Speed and Messages.
    callback opt-measure();
    callback opt-mail-toggled();
    callback opt-page-picked(string);
    callback opt-cache-clear();
    callback data-restore-cancel();
    callback data-restore-edit();
    // Background: the field's own edits, and the two buttons beside it. The
    // three sliders ride the generic `pref-float` above, keyed "bg-opacity",
    // "bg-blur" and "bg-dim".
    callback bg-url-edited();
    callback bg-upload();
    callback bg-remove();
    // Channels: the panel's own twelve. The channel rows open the shared
    // editor by id ("new" for a new one), the eye toggles one rail row, and
    // the tag rows carry their own new name or hue up because a repeated row
    // cannot write back into the model it was built from.
    callback chan-edit(id: string);
    callback chan-toggle-hidden(id: string);
    callback chan-hide-all();
    callback chan-show-all();
    callback chan-tag-edited();
    callback chan-tag-add();
    callback chan-tag-rename-start(id: string);
    callback chan-tag-renamed(id: string, name: string);
    callback chan-tag-rename-done(id: string);
    callback chan-tag-hue-toggle(id: string);
    callback chan-tag-hue-changed(id: string, value: float);
    callback chan-tag-delete(id: string);
    callback data-restore-submit();

    // The thirteen tabs of Settings.tsx L500, in order. Hints come from
    // `describe()` in SettingsWindow.tsx L180 — three tabs have none there
    // and have none here.
    in property <[Tab]> tabs: [
        { id: "appearance", glyph: "◐", label: "Appearance", hint: "Theme, colour, motion and the app background", num: "1" },
        { id: "layout", glyph: "▦", label: "Layout", hint: "How your logins are displayed and ordered", num: "2" },
        { id: "hidden", glyph: "⊘", label: "Hidden", hint: "", num: "3" },
        { id: "background", glyph: "▨", label: "Background", hint: "The image behind the whole app", num: "4" },
        { id: "channels", glyph: "◈", label: "Channels", hint: "Sidebar views, their tags and how they look", num: "5" },
        { id: "generator", glyph: "✦", label: "Generator", hint: "Defaults for new passwords", num: "6" },
        { id: "security", glyph: "◉", label: "Security", hint: "Locking, clipboard and warnings", num: "7" },
        { id: "alarms", glyph: "◷", label: "Alarms", hint: "", num: "8" },
        { id: "data", glyph: "⇩", label: "Data", hint: "Import, export and what is stored", num: "9" },
        { id: "backup", glyph: "▣", label: "Backup", hint: "Encrypted backups and restore", num: "10" },
        { id: "desktop", glyph: "⊞", label: "Desktop", hint: "", num: "11" },
        { id: "optimize", glyph: "⚙", label: "Optimize", hint: "Trade eye-candy for memory, CPU and battery", num: "12" },
        { id: "about", glyph: "ⓘ", label: "About", hint: "Diagnostics and resets", num: "13" },
    ];

    // The entry the header and the lit rail row read, clamped: Rust sends
    // the index, this keeps a bad one inside the table.
    property <Tab> active: root.tabs[min(max(root.tab-index, 0), root.tabs.length - 1)];

    // The root inherits Rectangle, so with no geometry of its own it covers
    // the wrapper the window puts it in — the same full-window backdrop the
    // gate draws (security.slint L99).
    // Escape closes and Ctrl+1..9 jumps — SettingsWindow.tsx L61-79. The
    // scope only exists while the window is open (the whole component is
    // inside `if (root.settings-open)` in main.slint), so it grabs focus on
    // creation and dies with the modal.
    FocusScope {
        init => { self.focus(); }

        key-pressed(event) => {
            // A dock key recording (Task 8.3) owns the keyboard while it is
            // armed, even here: the Layout tab's Key button starts it, and the
            // very next key is the answer, not a tab jump.
            if (root.dock-recording) {
                root.dock-key(event.text);
                return accept;
            }
            if (event.text == Key.Escape) {
                // A confirm sheet swallows the key first: Escape closes the
                // dialog, not the whole window (the TS modal's own handler
                // stops propagation before SettingsWindow's does).
                if (root.data-protect-open) { root.data-protect-cancel(); return accept; }
                if (root.data-reset-open) { root.data-reset-cancel(); return accept; }
                if (root.data-restore-name != "") { root.data-restore-cancel(); return accept; }
                root.closed();
                return accept;
            }
            if (event.modifiers.control) {
                if (event.text == "1") { root.tab-picked(0); return accept; }
                if (event.text == "2") { root.tab-picked(1); return accept; }
                if (event.text == "3") { root.tab-picked(2); return accept; }
                if (event.text == "4") { root.tab-picked(3); return accept; }
                if (event.text == "5") { root.tab-picked(4); return accept; }
                if (event.text == "6") { root.tab-picked(5); return accept; }
                if (event.text == "7") { root.tab-picked(6); return accept; }
                if (event.text == "8") { root.tab-picked(7); return accept; }
                if (event.text == "9") { root.tab-picked(8); return accept; }
            }
            return reject;
        }
    }

    // `.overlay`: the dimmed sheet. This TouchArea covers everything, so
    // only a click that lands *outside* the window (the TS's
    // `e.target === e.currentTarget`) reaches it and closes.
    sheet := TouchArea {
        clicked => { root.closed(); }
    }

    // `.settings-window`: 248px of rail, the rest main (app.css L932).
    //
    // The *sizes* come from `frame-w`/`frame-h` (Rust, from the window's
    // size) rather than a `min(…, parent.width - …)` in here: an explicit
    // `parent.width` on the modal bridges this tree's wrapping hints back
    // into the window's own layout info, which is a binding loop the
    // compiler refuses (a wrap makes preferred-height a function of width,
    // and the modal's width was a function of the window). The centring
    // stays responsive — x/y feed no layout info.
    win := Rectangle {
        width: root.frame-w;
        height: root.frame-h;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-xl;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.bg;
        clip: true;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 14px;

        HorizontalLayout {

            // ---- The rail ------------------------------------------------
            Rectangle {
                width: 248px;
                horizontal-stretch: 0;
                background: Theme.bg-deep;

                // The hairline turns the rail's right edge.
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.hairline;
                }

                VerticalLayout {
                    padding-top: 20px;
                    padding-bottom: 16px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;

                    // `.settings-window__brand`: the gradient dot and the word.
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 5px;
                            background: @linear-gradient(135deg, Theme.grad-from, Theme.grad-to);
                        }
                        Text {
                            text: "Settings";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // `.settings-window__tabs`: thirteen rows, scrollable on
                    // a short window the way the TS rail's own overflow is.
                    Rectangle {
                        vertical-stretch: 1;
                        Flickable {
                            content-width: 224px;
                            content-height: tabs-column.preferred-height;

                            tabs-column := VerticalLayout {
                                // A constant width: a `Flickable` sizes its
                                // content from the content's own width, so a
                                // derived width here would meet the size
                                // coming back — a loop. The rail is a fixed
                                // 248px, so this is 224px.
                                width: 224px;
                                spacing: 2px;

                                for entry[i] in root.tabs : Rectangle {
                                    height: 40px;
                                    border-radius: Theme.radius-md;
                                    border-width: 1px;
                                    border-color: root.active.id == entry.id ? Theme.border-strong : #00000000;
                                    background: root.active.id == entry.id
                                        ? Theme.plate
                                        : (tab-touch.has-hover ? #ffffff0d : #00000000);
                                    tab-touch := TouchArea {
                                        clicked => { root.tab-picked(i); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 10px;
                                        spacing: 10px;

                                        // `.settings-tab__icon`: the round
                                        // plate the glyph sits in.
                                        Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            border-radius: 14px;
                                            background: root.active.id == entry.id || tab-touch.has-hover
                                                ? Theme.surface-hover
                                                : Theme.plate;
                                            Text {
                                                width: parent.width;
                                                height: parent.height;
                                                text: entry.glyph;
                                                color: root.active.id == entry.id ? Theme.text : Theme.muted;
                                                font-size: 13px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: entry.label;
                                            color: root.active.id == entry.id ? Theme.text : Theme.muted;
                                            font-size: 13px;
                                            font-weight: root.active.id == entry.id ? 600 : 500;
                                            wrap: word-wrap;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }

                                        // `.settings-tab__index`: the
                                        // Ctrl+number, quiet until the row
                                        // is lit or hovered.
                                        Text {
                                            text: entry.num;
                                            color: Theme.faint;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            visible: root.active.id == entry.id || tab-touch.has-hover;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ---- The main column ------------------------------------------
            Rectangle {
                horizontal-stretch: 1;

                VerticalLayout {

                    // `.settings-window__header`: title, hint, close button.
                    HorizontalLayout {
                        padding-top: 30px;
                        padding-bottom: 20px;
                        padding-left: 32px;
                        padding-right: 32px;
                        spacing: 12px;

                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            Text {
                                text: root.active.label;
                                color: Theme.text;
                                font-size: 24px;
                                font-weight: 600;
                            }
                            if (root.active.hint != "") : Text {
                                text: root.active.hint;
                                color: Theme.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                                // A constant, like the rows below: the header
                                // hint must not wrap at a width the panel's
                                // own layout info produced.
                                width: root.panel-w - 60px;
                            }
                        }

                        IconButton {
                            horizontal-stretch: 0;
                            icon: "×";
                            clicked => { root.closed(); }
                        }
                    }

                    // `.settings-window__body`: 8/32/32 padding, scrolling.
                    Flickable {
                        vertical-stretch: 1;
                        content-width: 768px;
                        content-height: panel.preferred-height;

                        panel := VerticalLayout {
                            // Rust's number (frame minus rail and padding),
                            // not a derivation from the Flickable: see the
                            // `frame-w` note above.
                            width: root.panel-w;
                            padding-top: 8px;
                            padding-bottom: 32px;
                            padding-left: 32px;
                            padding-right: 32px;

                            // ---- The appearance panel --------------------
                            if (root.active.id == "appearance") : VerticalLayout {

                                // Theme (Settings.tsx L507-530): a stacked
                                // row — text, then three option cards.
                                Rectangle {
                                    height: theme-stack.preferred-height;

                                    theme-stack := VerticalLayout {
                                        spacing: 12px;
                                        padding-top: 14px;
                                        padding-bottom: 14px;

                                        VerticalLayout {
                                            spacing: 3px;
                                            Text {
                                                text: "Theme";
                                                color: Theme.text;
                                                font-size: 13.5px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: "System follows your device and updates live.";
                                                color: Theme.muted;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                                width: root.panel-w;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;

                                            for mode in ["light", "dark", "system"] : Rectangle {
                                                horizontal-stretch: 1;
                                                height: 38px;
                                                border-radius: Theme.radius-sm;
                                                border-width: 1px;
                                                border-color: root.ap-theme == mode ? Theme.border-strong : #00000000;
                                                background: root.ap-theme == mode
                                                    ? Theme.plate
                                                    : (theme-touch.has-hover ? #ffffff0d : #00000000);
                                                theme-touch := TouchArea {
                                                    clicked => { root.pref-string("theme", mode); }
                                                }

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: center;

                                                    theme-preview {
                                                        mode: mode;
                                                    }

                                                    Text {
                                                        text: mode == "light" ? "☀" : mode == "dark" ? "☾" : "☁";
                                                        color: root.ap-theme == mode ? Theme.text : Theme.muted;
                                                        font-size: 13px;
                                                        vertical-alignment: center;
                                                    }

                                                    Text {
                                                        text: mode == "light" ? "Light" : mode == "dark" ? "Dark" : "System";
                                                        color: root.ap-theme == mode ? Theme.text : Theme.muted;
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        x: 0;
                                        y: parent.height - 1px;
                                        width: parent.width;
                                        height: 1px;
                                        background: Theme.hairline;
                                    }
                                }

                                // Accent (Settings.tsx L532-549): same stack,
                                // swatches pushed by Rust's hue table.
                                Rectangle {
                                    height: accent-stack.preferred-height;

                                    accent-stack := VerticalLayout {
                                        spacing: 12px;
                                        padding-top: 14px;
                                        padding-bottom: 14px;

                                        VerticalLayout {
                                            spacing: 3px;
                                            Text {
                                                text: "Accent";
                                                color: Theme.text;
                                                font-size: 13.5px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: "A small, calm palette on purpose.";
                                                color: Theme.muted;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                                width: root.panel-w;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;

                                            for chip in root.accent-chips : Rectangle {
                                                horizontal-stretch: 1;
                                                height: 38px;
                                                border-radius: Theme.radius-sm;
                                                border-width: 1px;
                                                border-color: root.ap-accent == chip.id ? Theme.border-strong : #00000000;
                                                background: root.ap-accent == chip.id
                                                    ? Theme.plate
                                                    : (chip-touch.has-hover ? #ffffff0d : #00000000);
                                                chip-touch := TouchArea {
                                                    clicked => { root.pref-string("accent", chip.id); }
                                                }

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: center;

                                                    Rectangle {
                                                        width: 16px;
                                                        height: 16px;
                                                        border-radius: 8px;
                                                        background: @linear-gradient(135deg, chip.from, chip.to);
                                                    }

                                                    Text {
                                                        text: chip.label;
                                                        color: root.ap-accent == chip.id ? Theme.text : Theme.muted;
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        x: 0;
                                        y: parent.height - 1px;
                                        width: parent.width;
                                        height: 1px;
                                        background: Theme.hairline;
                                    }
                                }

                                // The six sliders (Settings.tsx L551-613).
                                // Steps and formats are the TS's own: Rust
                                // quantises the same step before it writes,
                                // so the stored value always lands on one.
                                slider-row {
                                    panel-w: root.panel-w;
                                    label: "Animation intensity";
                                    hint: "Scales every transition. Your device's reduced-motion setting still wins.";
                                    minimum: 0;
                                    maximum: 1;
                                    step: 0.25;
                                    value <=> root.ap-motion;
                                    formatted: root.ap-motion == 0 ? "Off" : root.ap-motion < 0.6 ? "Calm" : "Full";
                                    changed(v) => { root.pref-float("motion", v); }
                                }

                                slider-row {

                                    panel-w: root.panel-w;
                                    label: "Animation speed";
                                    hint: "How quickly panels, menus and settings tabs move. Faster is never slower to load — a transition is the same work, finished sooner.";
                                    minimum: 1;
                                    maximum: 2;
                                    step: 0.25;
                                    value <=> root.ap-motion-speed;
                                    formatted: root.ap-motion-speed <= 1.25 ? "Normal" : root.ap-motion-speed < 1.75 ? "Fast" : "Instant";
                                    changed(v) => { root.pref-float("motion-speed", v); }
                                }

                                slider-row {

                                    panel-w: root.panel-w;
                                    label: "Glow";
                                    hint: "Strength of the ambient gradient behind everything.";
                                    minimum: 0;
                                    maximum: 1;
                                    step: 0.25;
                                    value <=> root.ap-ambient;
                                    formatted: root.ap-ambient == 0 ? "Off" : root.ap-ambient < 0.6 ? "Subtle" : "Full";
                                    changed(v) => { root.pref-float("ambient", v); }
                                }

                                slider-row {

                                    panel-w: root.panel-w;
                                    label: "Text size";
                                    hint: "Scales the whole interface.";
                                    minimum: 85;
                                    maximum: 130;
                                    step: 5;
                                    value <=> root.ap-text-scale;
                                    formatted: Math.round(root.ap-text-scale) + "%";
                                    changed(v) => { root.pref-float("text-scale", v); }
                                }

                                slider-row {

                                    panel-w: root.panel-w;
                                    label: "Corner roundness";
                                    hint: "How soft or sharp every surface looks.";
                                    minimum: 0.6;
                                    maximum: 1.4;
                                    step: 0.1;
                                    value <=> root.ap-roundness;
                                    formatted: Math.round(root.ap-roundness * 100) + "%";
                                    changed(v) => { root.pref-float("roundness", v); }
                                }

                                slider-row {

                                    panel-w: root.panel-w;
                                    label: "Card shadow";
                                    hint: "The shadow under each login. Off keeps them flat; deep lifts them clear of the page.";
                                    minimum: 0;
                                    maximum: 1;
                                    step: 0.05;
                                    value <=> root.ap-card-depth;
                                    formatted: root.ap-card-depth == 0 ? "Off" : root.ap-card-depth < 0.3 ? "Faint" : root.ap-card-depth < 0.7 ? "Soft" : "Deep";
                                    changed(v) => { root.pref-float("card-depth", v); }
                                }

                                // Density (Settings.tsx L614-628).
                                seg-row {
                                    panel-w: root.panel-w;
                                    label: "Density";
                                    hint: "Row height and spacing.";
                                    options: ["Compact", "Comfortable", "Spacious"];
                                    ids: ["compact", "comfortable", "spacious"];
                                    value: root.ap-density;
                                    picked(id) => { root.pref-string("density", id); }
                                }

                                // The two switches (Settings.tsx L629-642).
                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Transparency";
                                    hint: "Turn off the frosted-glass effect for a flatter, faster surface.";
                                    checked <=> root.ap-reduce-transparency;
                                    toggled => { root.pref-bool("reduceTransparency", root.ap-reduce-transparency); }
                                }

                                toggle-row {

                                    panel-w: root.panel-w;
                                    label: "High contrast";
                                    hint: "Stronger borders and dimmer greys.";
                                    checked <=> root.ap-high-contrast;
                                    toggled => { root.pref-bool("highContrast", root.ap-high-contrast); }
                                }
                            }

                            // ---- The layout panel ------------------------
                            // How the logins are shown and where the chrome
                            // sits (Settings.tsx L651-953). The four pickers
                            // write the same preferences the sidebar's own
                            // menus write, so the two doors stay one value.
                            if (root.active.id == "layout") : VerticalLayout {
                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Group list by first letter";
                                    hint: "In the List view, rows sit under a letter heading. Off flattens it into one run.";
                                    checked <=> root.lay-letter-groups;
                                    toggled => { root.pref-bool("showLetterGroups", root.lay-letter-groups); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Auto-tag new logins";
                                    hint: "Reads the site and email-provider domain and attaches the matching tag, creating it when needed.";
                                    checked <=> root.lay-auto-tag-domain;
                                    toggled => { root.pref-bool("autoTagDomain", root.lay-auto-tag-domain); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Show unassigned channel";
                                    hint: "A sidebar entry for every login that has no tag yet.";
                                    checked <=> root.lay-unassigned-channel;
                                    toggled => { root.pref-bool("showUnassignedChannel", root.lay-unassigned-channel); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "New tags become channels";
                                    hint: "Every tag you create also gets its own sidebar channel.";
                                    checked <=> root.lay-auto-tag-channel;
                                    toggled => { root.pref-bool("autoTagChannel", root.lay-auto-tag-channel); }
                                }

                                // Rail presentation. Both controls are in the
                                // sidebar's right-click menu too, because the
                                // rail is the thing being described and the
                                // user is usually looking at it.
                                cards-row {
                                    panel-w: root.panel-w;
                                    label: "Channel labels";
                                    hint: "The sidebar rail — not the view picker below, which has its own setting. Icons only collapses the rail to a narrow strip you read by shape. Names only drops the glyphs but keeps the colour dot, which is what tells two similar names apart. (Compact mode in the sidebar footer also hides names.)";
                                    titles: ["Icons and names", "Icons only", "Names only"];
                                    notes: ["Both, as it is by default", "A narrow rail", "A plain list"];
                                    ids: ["both", "icon", "name"];
                                    value: root.lay-sidebar-labels;
                                    picked(id) => { root.pref-string("sidebar-labels", id); }
                                }

                                cards-row {
                                    panel-w: root.panel-w;
                                    label: "Rail position";
                                    hint: "Where the channel rail sits in the window. Docked top or bottom turns it into a horizontal strip, so folders open inline rather than nesting.";
                                    titles: ["Left edge", "Right edge", "Top tabs", "Bottom dock"];
                                    notes: ["A vertical rail", "A vertical rail", "A horizontal strip", "A horizontal strip"];
                                    ids: ["left", "right", "top", "bottom"];
                                    value: root.lay-rail-position;
                                    picked(id) => { root.pref-string("sidebar-position", id); }
                                }

                                // The quick-launch docks (Task 8.3). Every bar,
                                // then its slots. The bar's own right-click
                                // menu reaches the same operations from where
                                // the bar actually is, which is usually what
                                // you want; this is the place you can see all
                                // of them at once.
                                Rectangle { height: 4px; background: #00000000; }

                                Text {
                                    text: "QUICK-LAUNCH DOCKS";
                                    color: Theme.faint;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1.4px;
                                }

                                Text {
                                    text: "Bars float over the vault, one keypress from anywhere. Drag a bar to move it — the nearest edge decides whether it lies flat or stands up. Right-click a bar for position and Hide, or a slot to rekey it.";
                                    color: Theme.faint;
                                    font-size: 11.5px;
                                    wrap: word-wrap;
                                }

                                for entry in root.dock-rows : dock-manager-row {
                                    entry: entry;
                                    toggle(enabled) => { root.dock-toggle(entry.dock, enabled); }
                                    remove-bar => { root.dock-remove(entry.dock); }
                                    add-slot => { root.dock-add-slot(entry.dock); }
                                    key => { root.dock-slot-key(entry.dock, entry.slot); }
                                    menu(x, y) => { root.dock-slot-menu(entry.dock, entry.slot, x, y); }
                                    remove-slot => { root.dock-slot-remove(entry.dock, entry.slot); }
                                }

                                Btn {
                                    width: parent.width;
                                    label: "Add a dock";
                                    kind: 1;
                                    clicked => { root.dock-add(); }
                                }

                                cards-row {
                                    panel-w: root.panel-w;
                                    label: "Default view";
                                    hint: "Remembered the next time you open the app.";
                                    icons: ["≈", "●", "☰", "▦"];
                                    titles: ["Flow", "Orbit", "List", "Grid"];
                                    notes: ["Spring-animated cards", "3D carousel ring", "Plain grouped list", "Responsive card grid"];
                                    ids: ["animated", "carousel", "basic", "grid"];
                                    value: root.lay-view;
                                    picked(id) => { root.pref-string("view", id); }
                                }

                                seg-stack-row {
                                    panel-w: root.panel-w;
                                    label: "Sort by";
                                    hint: "Applies to the Flow and List views.";
                                    options: ["Name (A–Z)", "Recently updated", "Least recently updated", "Weakest first", "Username", "Custom (drag order)"];
                                    ids: ["title", "recent", "oldest", "strength", "username", "manual"];
                                    value: root.lay-sort;
                                    picked(id) => { root.pref-string("sort", id); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Show websites";
                                    hint: "Display the site under each login.";
                                    checked <=> root.lay-show-urls;
                                    toggled => { root.pref-bool("showUrls", root.lay-show-urls); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Label orbit nodes";
                                    hint: "Puts each login's title and email inside its own card in the Orbit ring.";
                                    checked <=> root.lay-orbit-labels;
                                    toggled => { root.pref-bool("showOrbitLabels", root.lay-orbit-labels); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Pin favorites";
                                    hint: "Keep favorites in their own section at the top.";
                                    checked <=> root.lay-pin-favorites;
                                    toggled => { root.pref-bool("pinFavorites", root.lay-pin-favorites); }
                                }

                                // "Expand on select" used to sit here. It made
                                // one click open the editor over the list you
                                // were scanning, and the double-click already
                                // opens it everywhere else — so the switch had
                                // nothing left to say and is gone rather than
                                // quietly doing nothing (Settings.tsx L861).

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Health badges";
                                    hint: "Flag reused and long-untouched passwords.";
                                    checked <=> root.lay-health-badges;
                                    toggled => { root.pref-bool("showHealthBadges", root.lay-health-badges); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Shortcuts in sidebar";
                                    hint: "Off leaves the shortcut sheet in Settings only.";
                                    checked <=> root.lay-shortcuts;
                                    toggled => { root.pref-bool("showShortcuts", root.lay-shortcuts); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Lock button";
                                    hint: "The lock control on the main screen. Settings always keeps its own.";
                                    checked <=> root.lay-lock-button;
                                    toggled => { root.pref-bool("showLockButton", root.lay-lock-button); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "New channel button";
                                    hint: "The shortcut at the end of the sidebar. Hiding it changes nothing — channels are still one right-click away.";
                                    checked <=> root.lay-new-channel-button;
                                    toggled => { root.pref-bool("showNewChannelButton", root.lay-new-channel-button); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Compact button";
                                    hint: "The sidebar footer's narrow-rail toggle.";
                                    checked <=> root.lay-compact-button;
                                    toggled => { root.pref-bool("showCompactButton", root.lay-compact-button); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "New login button";
                                    hint: "The topbar shortcut.";
                                    checked <=> root.lay-new-login-button;
                                    toggled => { root.pref-bool("showNewLoginButton", root.lay-new-login-button); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Bulk add button";
                                    hint: "The topbar shortcut beside New login.";
                                    checked <=> root.lay-bulk-add-button;
                                    toggled => { root.pref-bool("showBulkAddButton", root.lay-bulk-add-button); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Settings button";
                                    hint: "The sidebar footer's own shortcut here.";
                                    checked <=> root.lay-settings-button;
                                    toggled => { root.pref-bool("showSettingsButton", root.lay-settings-button); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Hide sidebar button";
                                    hint: "The sidebar footer's Hide control.";
                                    checked <=> root.lay-hide-sidebar-button;
                                    toggled => { root.pref-bool("showHideSidebarButton", root.lay-hide-sidebar-button); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Show sidebar";
                                    hint: "Hides the whole channel rail. A button appears in the topbar to bring it back, so Settings stays reachable.";
                                    checked <=> root.lay-show-sidebar;
                                    toggled => { root.pref-bool("showSidebar", root.lay-show-sidebar); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Floating controls";
                                    hint: "Detaches the sidebar channels, the view menu and New login into their own pills.";
                                    checked <=> root.lay-floating-chrome;
                                    toggled => { root.pref-bool("floatingChrome", root.lay-floating-chrome); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Hide dividers";
                                    hint: "Removes the hairline rules inside this settings window.";
                                    checked <=> root.lay-hide-dividers;
                                    toggled => { root.pref-bool("hideDividers", root.lay-hide-dividers); }
                                }
                            }

                            // ---- The hidden panel ------------------------
                            // Lost and found: everything hidden by right-click
                            // or switched off in Layout, grouped by where it
                            // lives, each with a way back (Settings.tsx
                            // L958-1156). The rows are derived in Rust from
                            // the switches themselves, so this panel is a
                            // reading of the document, never a copy of it.
                            if (root.active.id == "hidden") : VerticalLayout {
                                if (root.hidden-rows.length == 0) : Text {
                                    width: root.panel-w;
                                    text: "Nothing is hidden. Right-click any topbar, sidebar, dock or login-card button to hide it straight from where it lives.";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                if (root.hidden-rows.length > 1) : btn-row {
                                    panel-w: root.panel-w;
                                    label: "Show everything";
                                    hint: "Brings back every hidden button, bar, channel and folder at once.";
                                    button-text: "Show all " + root.hidden-rows.length;
                                    clicked => { root.hidden-restore-all(); }
                                }

                                for row in root.hidden-rows : VerticalLayout {
                                    if (row.heading != "") : Rectangle {
                                        width: root.panel-w;
                                        height: 34px;
                                        // `.setting__label`: the group's name
                                        // and how many rows it holds.
                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: row.heading;
                                            color: Theme.muted;
                                            font-size: 12px;
                                            font-weight: 600;
                                            vertical-alignment: bottom;
                                        }
                                    }

                                    btn-row {
                                        panel-w: root.panel-w;
                                        label: row.label;
                                        hint: row.detail;
                                        button-text: "Show";
                                        clicked => { root.hidden-restore(row.key, row.id); }
                                    }
                                }
                            }

                            // ---- The background panel ---------------------
                            // Settings.tsx's `BackgroundSection` (L2254): one
                            // picture behind the whole app, three dials over
                            // it. The field writes only when its text is a
                            // bare `http(s)` URL or empty -- the TS's own
                            // `valid` test, checked in Rust -- so a half-typed
                            // URL is simply not stored yet. A URL is never
                            // fetched here: this app makes no network request
                            // for a picture, which is why the hint says so
                            // rather than promising a photo that cannot load.
                            if (root.active.id == "background") : VerticalLayout {
                                width: root.panel-w;
                                spacing: 0px;

                                VerticalLayout {
                                    width: root.panel-w;
                                    spacing: 3px;
                                    padding-top: 14px;
                                    padding-bottom: 10px;

                                    Text {
                                        text: "Background image";
                                        color: Theme.text;
                                        font-size: 13.5px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "A URL is kept as text: this app fetches nothing. An upload is stored with the vault.";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        width: root.panel-w;
                                    }
                                }

                                // A row of its own height, so the three
                                // children centre on it: the field is 44px and
                                // the buttons are shorter, and a layout's
                                // cross-axis default would line the shorter
                                // ones up with the top. The row's own layout
                                // keeps the *default* `alignment`, too -- an
                                // inner `alignment: start` distributes the
                                // leftover width instead of stretching into it,
                                // which collapses the field to nothing and
                                // leaves the button alone at the left edge.
                                Rectangle {
                                    width: root.panel-w;
                                    height: 44px;

                                    HorizontalLayout {
                                        spacing: 8px;

                                        bg-url-field := Field {
                                            horizontal-stretch: 1;
                                            placeholder: "https://example.com/photo.jpg";
                                            autofocus: false;
                                            value <=> root.bg-url;
                                            edited => { root.bg-url-edited(); }
                                        }

                                        Btn {
                                            horizontal-stretch: 0;
                                            label: "Upload";
                                            kind: 1;
                                            h: 44px;
                                            clicked => { root.bg-upload(); }
                                        }

                                        if (root.bg-has-image) : VerticalLayout {
                                            horizontal-stretch: 0;
                                            alignment: center;
                                            IconButton {
                                                icon: "×"; // remove the background
                                                clicked => { root.bg-remove(); }
                                            }
                                        }
                                    }
                                }

                                if (root.bg-error != "") : Text {
                                    width: root.panel-w;
                                    text: root.bg-error;
                                    color: Theme.danger;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                Text {
                                    width: root.panel-w;
                                    text: "Uploads are resized to at most 1600px and re-encoded, then capped at 8 MB - so almost any photo fits. The picture is stored inside this vault's own file.";
                                    color: Theme.faint;
                                    font-size: 11.5px;
                                    wrap: word-wrap;
                                }

                                slider-row {
                                    panel-w: root.panel-w;
                                    label: "Image opacity";
                                    hint: "How strongly the photo shows through.";
                                    minimum: 0;
                                    maximum: 1;
                                    step: 0.05;
                                    formatted: Math.round(root.bg-opacity * 100) + "%";
                                    value <=> root.bg-opacity;
                                    changed(v) => { root.pref-float("bg-opacity", v); }
                                }

                                slider-row {
                                    panel-w: root.panel-w;
                                    label: "Blur";
                                    hint: "Softens the photo so text stays readable.";
                                    minimum: 0;
                                    maximum: 40;
                                    step: 2;
                                    formatted: Math.round(root.bg-blur) + "px";
                                    value <=> root.bg-blur;
                                    changed(v) => { root.pref-float("bg-blur", v); }
                                }

                                slider-row {
                                    panel-w: root.panel-w;
                                    label: "Dim";
                                    hint: "Darks or lightens everything behind the interface.";
                                    minimum: 0;
                                    maximum: 0.9;
                                    step: 0.05;
                                    formatted: Math.round(root.bg-dim * 100) + "%";
                                    value <=> root.bg-dim;
                                    changed(v) => { root.pref-float("bg-dim", v); }
                                }
                            }

                            // ---- The channels panel (Task 5.10) ----------
                            // `ChannelManager` (Settings.tsx L1180): every
                            // channel as a row, then the tag catalogue underneath.
                            // The row is the sidebar's own row - a dot in the
                            // channel's colour, the name as a way into the
                            // shared editor, the count and the filter, and the
                            // eye that takes it off the rail without deleting it.
                            if (root.active.id == "channels") : VerticalLayout {
                                width: root.panel-w;
                                spacing: 12px;
                                vertical-stretch: 0;

                                VerticalLayout {
                                    width: root.panel-w;
                                    spacing: 3px;
                                    padding-top: 14px;
                                    padding-bottom: 10px;

                                    Text {
                                        text: "Channels";
                                        color: Theme.text;
                                        font-size: 13.5px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        // The TS hint also promises drag-to-
                                        // reorder and a right-click menu on
                                        // the rail, both of which arrive with
                                        // the sidebar's own entries (Phase 8);
                                        // this says what the panel does today.
                                        text: "Every channel is editable - name, icon, colour, theme, image and tags. The eye hides one from the rail without deleting it.";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        width: root.panel-w;
                                    }
                                }

                                if (root.chan-rows.length == 0) : Alert {
                                    info: true;
                                    message: "No channels. Every vault has at least one - the fallback view - so this should not happen.";
                                }

                                for chan-row-entry in root.chan-rows : chan-row {
                                    entry: chan-row-entry;
                                    open(id) => { root.chan-edit(id); }
                                    toggle(id) => { root.chan-toggle-hidden(id); }
                                }

                                HorizontalLayout {
                                    width: root.panel-w;
                                    spacing: 8px;
                                    alignment: start;

                                    Btn {
                                        horizontal-stretch: 0;
                                        label: "New channel";
                                        kind: 1;
                                        clicked => { root.chan-edit("new"); }
                                    }

                                    if (root.chan-can-hide-all) : Btn {
                                        horizontal-stretch: 0;
                                        label: "Hide all";
                                        kind: 2;
                                        clicked => { root.chan-hide-all(); }
                                    }

                                    if (root.chan-can-show-all) : Btn {
                                        horizontal-stretch: 0;
                                        label: "Show all";
                                        kind: 2;
                                        clicked => { root.chan-show-all(); }
                                    }
                                }

                                Rectangle {
                                    width: root.panel-w;
                                    height: 1px;
                                    background: Theme.hairline;
                                }

                                Text {
                                    text: "Tags";
                                    color: Theme.text;
                                    font-size: 13.5px;
                                    font-weight: 600;
                                }

                                // The add box, the way the login editor's is:
                                // `chan-tag-input` is two-way, the Enter key and
                                // the button both add, and Rust answers
                                // `chan-tag-can-add` so a box of spaces cannot
                                // become a tag. A row of its own height, with
                                // the default alignment, so the field stretches
                                // into the leftover width.
                                Rectangle {
                                    width: root.panel-w;
                                    height: 44px;

                                    HorizontalLayout {
                                        spacing: 8px;

                                        Field {
                                            horizontal-stretch: 1;
                                            placeholder: "New tag name";
                                            autofocus: false;
                                            value <=> root.chan-tag-input;
                                            edited => { root.chan-tag-edited(); }
                                            accepted => { root.chan-tag-add(); }
                                        }

                                        Btn {
                                            horizontal-stretch: 0;
                                            label: "Add";
                                            kind: 1;
                                            h: 44px;
                                            enabled: root.chan-tag-can-add;
                                            clicked => { root.chan-tag-add(); }
                                        }
                                    }
                                }

                                if (root.chan-tag-rows.length == 0) : Alert {
                                    info: true;
                                    message: "No tags yet. Create one above, or from a login's editor - then attach it to a channel and only logins carrying it will show there.";
                                }

                                for tag-entry in root.chan-tag-rows : tag-manager-row {
                                    entry: tag-entry;
                                    rename-start(id) => { root.chan-tag-rename-start(id); }
                                    renamed(id, name) => { root.chan-tag-renamed(id, name); }
                                    rename-done(id) => { root.chan-tag-rename-done(id); }
                                    hue-toggle(id) => { root.chan-tag-hue-toggle(id); }
                                    hue-changed(id, value) => { root.chan-tag-hue-changed(id, value); }
                                    delete(id) => { root.chan-tag-delete(id); }
                                }
                            }

                            // ---- The desktop panel ------------------------
                            // The four switches of Settings.tsx L1551-1585. The
                            // TS renders this tab only inside the desktop shell:
                            // a browser page has no tray, no Run key and no
                            // window to minimise to it, so on the web the four
                            // would be dead controls. This *is* the desktop
                            // shell, and all four already drive it — the tray
                            // icon, the X button, the Run key, and the alarm
                            // chime.
                            if (root.active.id == "desktop") : VerticalLayout {
                                spacing: 0px;

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Run at startup";
                                    hint: "Launch Colax when you sign in to Windows.";
                                    checked <=> root.desk-launch-at-login;
                                    toggled => { root.pref-bool("launchAtLogin", root.desk-launch-at-login); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "System tray";
                                    hint: "Keep an icon by the clock. Right-click it to show, lock, mute, restart or quit.";
                                    checked <=> root.desk-tray;
                                    toggled => { root.pref-bool("trayEnabled", root.desk-tray); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Minimise to tray on close";
                                    hint: "The X button hides the window instead of quitting. Needs the tray above.";
                                    // The masked reading goes back up: with the
                                    // tray off the row reads off, so the new
                                    // value the switch lands on *is* the flag.
                                    checked <=> root.desk-close-to-tray;
                                    toggled => { root.pref-bool("closeToTray", root.desk-close-to-tray); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Mute all sounds";
                                    hint: "Silences alarms and chimes. Toasts still appear. Also in the tray menu.";
                                    checked <=> root.desk-mute;
                                    toggled => { root.pref-bool("soundsMuted", root.desk-mute); }
                                }
                            }

                            // ---- The generator panel ----------------------
                            // Settings.tsx L1199-1242. Six fields that are one
                            // object in the document, and the same object the
                            // editor's generator works from: a chip toggled
                            // there arrives here on the next refresh, and a
                            // switch thrown here re-rolls the preview there.
                            if (root.active.id == "generator") : VerticalLayout {
                                spacing: 0px;

                                slider-row {
                                    panel-w: root.panel-w;
                                    label: "Default length";
                                    hint: "Used when the generator opens.";
                                    minimum: 8;
                                    maximum: 64;
                                    step: 1;
                                    formatted: root.gen-length-label;
                                    value <=> root.gen-length;
                                    changed(v) => { root.pref-float("gen-length", v); }
                                }

                                group-row {
                                    panel-w: root.panel-w;
                                    label: "Character sets";
                                    hint: "At least one must stay on.";
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Lowercase  a–z";
                                    checked <=> root.gen-lower;
                                    toggled => { root.pref-bool("gen-lower", root.gen-lower); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Uppercase  A–Z";
                                    checked <=> root.gen-upper;
                                    toggled => { root.pref-bool("gen-upper", root.gen-upper); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Digits  0–9";
                                    checked <=> root.gen-digits;
                                    toggled => { root.pref-bool("gen-digits", root.gen-digits); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Symbols  !@#";
                                    checked <=> root.gen-symbols;
                                    toggled => { root.pref-bool("gen-symbols", root.gen-symbols); }
                                }

                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Avoid look-alikes  l 1 I O 0";
                                    checked <=> root.gen-avoid;
                                    toggled => { root.pref-bool("gen-avoid", root.gen-avoid); }
                                }
                            }

                            // ---- The alarms panel -------------------------
                            // AlarmsPanel.tsx L60-166: the stored reminders,
                            // then the card that makes the next one. Every
                            // cell of a row is a string Rust already printed
                            // ("No label", "Sun, Tue"), because the TS decides
                            // those at render time and a model element cannot
                            // be sorted out in Slint. The dot is the panel's
                            // own little control for the same reason: the
                            // value comes from the model, and a click goes to
                            // Rust, which pushes the new list back.
                            if (root.active.id == "alarms") : VerticalLayout {
                                width: root.panel-w;
                                spacing: 12px;
                                padding-top: 12px;

                                Text {
                                    width: parent.width;
                                    text: "Alarms ring while the app is open. Pick a sound from your device or keep the built-in chime.";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                // `.alarms__list`: 4px between the cards, 12px
                                // between the list and its neighbours.
                                VerticalLayout {
                                    spacing: 4px;

                                    if (root.alarm-rows.length == 0) : Text {
                                        width: parent.width;
                                        text: "No alarms yet.";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }

                                    for row in root.alarm-rows : Rectangle {
                                        width: parent.width;
                                        height: alarm-shell.preferred-height;
                                        border-radius: Theme.radius-md;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: Theme.surface;

                                        alarm-shell := HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 8px;
                                            padding-top: 8px;
                                            padding-bottom: 8px;
                                            spacing: 8px;
                                            alignment: space-between;

                                            // time · label · days
                                            HorizontalLayout {
                                                spacing: 12px;
                                                alignment: start;

                                                Text {
                                                    text: row.time;
                                                    font-family: "Consolas";
                                                    font-weight: 600;
                                                    color: Theme.text;
                                                    font-size: 14px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: row.label;
                                                    color: Theme.muted;
                                                    font-size: 13px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: row.days;
                                                    color: Theme.faint;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Test · dot · delete
                                            HorizontalLayout {
                                                spacing: 4px;
                                                alignment: end;

                                                Btn {
                                                    horizontal-stretch: 0;
                                                    kind: 2;
                                                    h: 30px;
                                                    label: "Test";
                                                    clicked => { root.alarm-test(row.id); }
                                                }

                                                alarm-dot {
                                                    on: row.enabled;
                                                    clicked => { root.alarm-toggle(row.id); }
                                                }

                                                IconButton {
                                                    horizontal-stretch: 0;
                                                    icon: "×"; // delete this alarm
                                                    clicked => { root.alarm-delete(row.id); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // `.sec__card`, the New alarm form. Label and
                                // Time are the card's own fields; Days and
                                // Sound are the draft Rust keeps, because both
                                // are pushed in as data.
                                Rectangle {
                                    width: parent.width;
                                    border-radius: Theme.radius-md;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    height: new-alarm-shell.preferred-height;

                                    new-alarm-shell := VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;

                                        Text {
                                            text: "New alarm";
                                            color: Theme.text;
                                            font-size: 13px;
                                            font-weight: 620;
                                        }

                                        VerticalLayout {
                                            spacing: 6px;
                                            Label { text: "Label"; }
                                            Field {
                                                value <=> root.alarm-label;
                                                placeholder: "Call mum";
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 6px;
                                            Label { text: "Time"; }
                                            Field {
                                                value <=> root.alarm-time;
                                                placeholder: "08:00";
                                                autofocus: false;
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 6px;
                                            Label { text: "Days"; }
                                            HorizontalLayout {
                                                spacing: 4px;
                                                alignment: start;

                                                for chip[index] in root.alarm-day-chips : Chip {
                                                    label: chip.label;
                                                    selected: chip.on;
                                                    toggled => { root.alarm-day-toggled(index); }
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 6px;
                                            Label { text: "Sound"; }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;

                                                Btn {
                                                    horizontal-stretch: 0;
                                                    kind: 1;
                                                    h: 34px;
                                                    label: "Import sound";
                                                    clicked => { root.alarm-import(); }
                                                }

                                                if (root.alarm-sound != "") : Chip {
                                                    label: root.alarm-sound;
                                                }

                                                if (root.alarm-sound != "") : Btn {
                                                    horizontal-stretch: 0;
                                                    kind: 2;
                                                    h: 34px;
                                                    label: "Reset to chime";
                                                    clicked => { root.alarm-reset-sound(); }
                                                }

                                                if (root.alarm-sound == "") : Text {
                                                    text: "Built-in chime";
                                                    color: Theme.faint;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Btn {
                                            kind: 0;
                                            h: 38px;
                                            label: "Add alarm";
                                            enabled: root.alarm-time != "";
                                            clicked => { root.alarm-add(); }
                                        }
                                    }
                                }
                            }

                            // ---- Security ------------------------------------
                            // The four groups as sub-tabs, each a short list.
                            // The selects are pill stacks rather than the TS's
                            // dropdowns — this app has no `Select` — and the
                            // vault's second factor is the same `SecurityForm`
                            // the editor mounts, bound to the stored
                            // `vaultSecurity` instead of a draft.
                            if (root.active.id == "security") : VerticalLayout {
                                width: root.panel-w;
                                spacing: 12px;
                                padding-top: 12px;

                                sub-tabs {
                                    labels: ["Locking", "Clipboard", "Health warnings", "Confirmations"];
                                    active <=> root.sec-group;
                                }

                                if (root.sec-group == 0) : VerticalLayout {
                                    spacing: 0px;

                                    seg-stack-row {
                                        panel-w: root.panel-w;
                                        label: "Auto-lock";
                                        hint: "Lock after a period without activity.";
                                        options: ["1 minute", "5 minutes", "15 minutes", "30 minutes", "1 hour", "Never"];
                                        ids: ["1", "5", "15", "30", "60", "0"];
                                        value: root.sec-auto-lock;
                                        picked(id) => { root.pref-string("auto-lock", id); }
                                    }

                                    // `Row stacked` in the TS: the hint
                                    // describes the form below it rather than
                                    // sitting beside it. The rule under it is
                                    // the row's own — a layout child cannot
                                    // set `y`, so the hairline hangs off the
                                    // wrapper the layout is inside of.
                                    Rectangle {
                                        width: root.panel-w;
                                        height: stacked.preferred-height;

                                        stacked := VerticalLayout {
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                spacing: 3px;
                                                Text {
                                                    text: "Vault second factor";
                                                    color: Theme.text;
                                                    font-size: 13.5px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: "After the vault opens, require an authenticator code or a recovery answer too. Optional, and per-device.";
                                                    color: Theme.muted;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                    width: root.panel-w;
                                                }
                                            }

                                            SecurityForm {
                                                subject: "the vault";
                                                sec-level: root.vsec-level;
                                                sec-questions-note: root.vsec-questions-note;
                                                sec-totp: root.vsec-totp;
                                                sec-otpauth: root.vsec-otpauth;
                                                qr-size: root.vsec-qr-size;
                                                qr-cells: root.vsec-qr-cells;
                                                sec-totp-staged: root.vsec-totp-staged;
                                                sec-totp-note: root.vsec-totp-note;
                                                sec-totp-seed <=> root.vsec-totp-seed;
                                                sec-totp-code <=> root.vsec-totp-code;
                                                sec-passcode: root.vsec-passcode;
                                                sec-passcode-new <=> root.vsec-passcode-new;
                                                sec-passcode-confirm <=> root.vsec-passcode-confirm;
                                                sec-passcode-input <=> root.vsec-passcode-input;
                                                sec-passcode-error: root.vsec-passcode-error;
                                                sec-questions: root.vsec-questions;
                                                sec-answer-error: root.vsec-answer-error;
                                                sec-checking-id <=> root.vsec-checking-id;
                                                sec-check-input <=> root.vsec-check-input;
                                                sec-new-prompt: root.vsec-new-prompt;
                                                sec-new-answer <=> root.vsec-new-answer;
                                                sec-totp-attach => { root.vsec-totp-attach(); }
                                                sec-totp-generate => { root.vsec-totp-generate(); }
                                                sec-totp-check => { root.vsec-totp-check(); }
                                                sec-totp-discard => { root.vsec-totp-discard(); }
                                                sec-totp-remove => { root.vsec-totp-remove(); }
                                                sec-passcode-save => { root.vsec-passcode-save(); }
                                                sec-passcode-check => { root.vsec-passcode-check(); }
                                                sec-passcode-remove => { root.vsec-passcode-remove(); }
                                                sec-question-add => { root.vsec-question-add(); }
                                                sec-question-remove(id) => { root.vsec-question-remove(id); }
                                                sec-question-check(id) => { root.vsec-question-check(id); }
                                                sec-prompt-step(delta) => { root.vsec-prompt-step(delta); }
                                            }

                                        }

                                        Rectangle {
                                            x: 0;
                                            y: parent.height - 1px;
                                            width: parent.width;
                                            height: 1px;
                                            background: Theme.hairline;
                                        }
                                    }

                                    btn-row {
                                        panel-w: root.panel-w;
                                        label: "Lock now";
                                        hint: "Clears the decryption key from memory straight away.";
                                        button-text: "Lock";
                                        clicked => { root.security-lock(); }
                                    }

                                    chip-row {
                                        panel-w: root.panel-w;
                                        label: "Key derivation";
                                        hint: "Rounds applied to your password before it can derive the vault key.";
                                        chip-text: root.sec-kdf;
                                    }

                                    chip-row {
                                        panel-w: root.panel-w;
                                        label: "Encryption";
                                        hint: "Every login is sealed individually with a fresh nonce.";
                                        chip-text: "AES-256-GCM";
                                    }
                                }

                                if (root.sec-group == 1) : VerticalLayout {
                                    spacing: 0px;

                                    seg-stack-row {
                                        panel-w: root.panel-w;
                                        label: "Clear clipboard";
                                        hint: "Wipe the clipboard after copying.";
                                        options: ["Never", "15 seconds", "30 seconds", "60 seconds", "2 minutes"];
                                        ids: ["0", "15", "30", "60", "120"];
                                        value: root.sec-clipboard;
                                        picked(id) => { root.pref-string("clear-clipboard", id); }
                                    }

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Clear clipboard on lock";
                                        hint: "Adds a wipe to the lock action itself.";
                                        checked <=> root.sec-clear-on-lock;
                                        toggled => { root.pref-bool("clearClipboardOnLock", root.sec-clear-on-lock); }
                                    }

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Detect logins on the clipboard";
                                        hint: "Watches for an email and a password copied together, and offers to save them.";
                                        checked <=> root.sec-clip-capture;
                                        toggled => { root.pref-bool("clipboardCapture", root.sec-clip-capture); }
                                    }

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Save clipboard logins straight away";
                                        hint: "Skips the confirmation prompt from clipboard detection.";
                                        checked <=> root.sec-clip-autosave;
                                        toggled => { root.pref-bool("clipboardAutoSave", root.sec-clip-autosave); }
                                    }
                                }

                                if (root.sec-group == 2) : VerticalLayout {
                                    spacing: 0px;

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Warn on reused passwords";
                                        hint: "A tappable notice, not a dialog: it points at the Dashboard, which lists the shared logins.";
                                        checked <=> root.sec-warn-reuse;
                                        toggled => { root.pref-bool("warnOnReuse", root.sec-warn-reuse); }
                                    }

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Tag reused passwords";
                                        hint: "Files every login sharing a password under a “Reused password” tag, so the group has a sidebar row of its own.";
                                        checked <=> root.sec-tag-reused;
                                        toggled => { root.pref-bool("autoTagReused", root.sec-tag-reused); }
                                    }

                                    seg-stack-row {
                                        panel-w: root.panel-w;
                                        label: "Flag stale passwords";
                                        hint: "A password unchanged for this long counts as stale in the health views.";
                                        options: ["Never", "30 days", "60 days", "90 days", "180 days", "1 year", "2 years"];
                                        ids: ["0", "30", "60", "90", "180", "365", "730"];
                                        value: root.sec-pw-age;
                                        picked(id) => { root.pref-string("password-age", id); }
                                    }

                                    seg-stack-row {
                                        panel-w: root.panel-w;
                                        label: "Flag stale emails";
                                        hint: "An address unchanged for this long is flagged for review.";
                                        options: ["Never", "90 days", "180 days", "1 year", "2 years"];
                                        ids: ["0", "90", "180", "365", "730"];
                                        value: root.sec-email-age;
                                        picked(id) => { root.pref-string("email-age", id); }
                                    }

                                    seg-stack-row {
                                        panel-w: root.panel-w;
                                        label: "Email check reminder";
                                        hint: "How often you are asked to review the addresses you have saved.";
                                        options: ["Never", "Every month", "Every 2 months", "Every 3 months", "Every 6 months", "Every year"];
                                        ids: ["0", "30", "60", "90", "180", "365"];
                                        value: root.sec-email-check;
                                        picked(id) => { root.pref-string("email-check", id); }
                                    }

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Mask email addresses";
                                        hint: "Shows the first letters only on cards and messages. Copying still copies the full address.";
                                        checked <=> root.sec-mask-emails;
                                        toggled => { root.pref-bool("maskEmails", root.sec-mask-emails); }
                                    }
                                }

                                if (root.sec-group == 3) : VerticalLayout {
                                    spacing: 0px;

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Confirm before export";
                                        hint: "Ask for a password to protect the backup file.";
                                        checked <=> root.sec-confirm-export;
                                        toggled => { root.pref-bool("confirmBeforeExport", root.sec-confirm-export); }
                                    }

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Confirm deletions";
                                        hint: "Ask before removing a login.";
                                        checked <=> root.sec-confirm-deletes;
                                        toggled => { root.pref-bool("confirmDeletes", root.sec-confirm-deletes); }
                                    }

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Copy toasts";
                                        hint: "Show a small confirmation after copying.";
                                        checked <=> root.sec-copy-toasts;
                                        toggled => { root.pref-bool("copyToasts", root.sec-copy-toasts); }
                                    }
                                }
                            }

                            // ---- Data ----------------------------------------
                            // What is stored and who this build is, then the
                            // two plaintext escapes: CSV out through the save
                            // dialog, CSV back in through the open one — each
                            // row added as a fresh login, exactly as
                            // `service.addItem` does per parsed line.
                            if (root.active.id == "data") : VerticalLayout {
                                width: root.panel-w;
                                spacing: 0px;

                                chip-row {
                                    panel-w: root.panel-w;
                                    label: "Stored logins";
                                    hint: "Everything lives in a local vault file on this device.";
                                    chip-text: root.data-stored;
                                }

                                chip-row {
                                    panel-w: root.panel-w;
                                    label: "App version";
                                    hint: "The exact build running right now. If a fix you expected is missing, this tells you the install is stale.";
                                    chip-text: root.data-version;
                                    accent: true;
                                }

                                btn-row {
                                    panel-w: root.panel-w;
                                    label: "Export as CSV";
                                    hint: "Plaintext, for moving to another tool. Delete it afterwards.";
                                    button-text: "Export CSV";
                                    button-enabled: root.data-count > 0;
                                    clicked => { root.data-export-csv(); }
                                }

                                btn-row {
                                    panel-w: root.panel-w;
                                    label: "Import from CSV";
                                    hint: "Expects the columns name, url, username, password, notes.";
                                    button-text: "Import CSV";
                                    clicked => { root.data-import-csv(); }
                                }

                                btn-row {
                                    panel-w: root.panel-w;
                                    label: "Delete all data";
                                    hint: "Removes every login, tag, channel, folder, alarm, connected mailbox, setting and usage record from this device, and clears the clipboard. There is no undo.";
                                    button-text: "Delete everything";
                                    button-kind: 3;
                                    clicked => { root.data-reset-open-clicked(); }
                                }
                            }

                            // ---- Backup --------------------------------------
                            if (root.active.id == "backup") : VerticalLayout {
                                width: root.panel-w;
                                spacing: 0px;

                                // Native-only: the TS backup is the vault and
                                // its logins, full stop, and a restore of one
                                // leaves the device's own settings alone. This
                                // app writes its preferences into the same file
                                // (they live in it on disk), so the switch is
                                // the honest choice between "the same file the
                                // web build makes" and "everything".
                                toggle-row {
                                    panel-w: root.panel-w;
                                    label: "Include settings and layout";
                                    hint: "The theme, folders, channels, tags, alarms and every other setting travel with the backup. Off, the file carries the vault and its logins only — restoring it leaves this device's settings as they are.";
                                    checked <=> root.backup-with-settings;
                                    toggled => { root.backup-with-settings-toggled(); }
                                }

                                btn-row {
                                    panel-w: root.panel-w;
                                    label: "Encrypted backup";
                                    hint: root.backup-hint;
                                    button-text: "Export";
                                    clicked => { root.backup-export(); }
                                }

                                btn-row {
                                    panel-w: root.panel-w;
                                    label: "Restore from backup";
                                    hint: "Replaces everything currently in this vault.";
                                    button-text: "Restore";
                                    clicked => { root.backup-restore-pick(); }
                                }
                            }

                            // ---- Optimize -------------------------------------
                            // Four groups as sub-tabs, the two-level shape
                            // Security established (`renderTabOptimize`,
                            // Settings.tsx L1599-2066). Every reading is
                            // derived from the document and every write goes
                            // through the store, so the counter cannot lie
                            // about the switches it counts.
                            if (root.active.id == "optimize") : VerticalLayout {
                                width: root.panel-w;
                                spacing: 12px;
                                padding-top: 12px;

                                sub-tabs {
                                    labels: ["General", "Look & feel", "Speed", "Messages"];
                                    active <=> root.opt-group;
                                }

                                if (root.opt-group == 0) : VerticalLayout {
                                    spacing: 0px;

                                    // Stacked row: the hint describes the
                                    // three buttons below it, so they sit
                                    // under the rule's padding the way the
                                    // security form does.
                                    Rectangle {
                                        width: root.panel-w;
                                        height: presets.preferred-height;

                                        presets := VerticalLayout {
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                spacing: 3px;
                                                Text {
                                                    text: "One-click profiles";
                                                    color: Theme.text;
                                                    font-size: 13.5px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: "Applies a whole set of resource-saving settings at once. Your logins, tags, mailboxes and layout are never touched — only how much the app animates and repaints.";
                                                    color: Theme.muted;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;

                                                Btn {
                                                    kind: 1;
                                                    h: 34px;
                                                    label: "Balanced";
                                                    clicked => { root.opt-balanced(); }
                                                }
                                                Btn {
                                                    kind: 0;
                                                    h: 34px;
                                                    label: "Maximum savings";
                                                    clicked => { root.opt-max(); }
                                                }
                                                Btn {
                                                    kind: 2;
                                                    h: 34px;
                                                    label: "Restore my look";
                                                    clicked => { root.opt-restore(); }
                                                }
                                            }

                                            Text {
                                                text: root.opt-readout;
                                                color: Theme.muted;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                        }

                                        Rectangle {
                                            x: 0;
                                            y: parent.height - 1px;
                                            width: parent.width;
                                            height: 1px;
                                            background: Theme.hairline;
                                        }
                                    }

                                    // Saved looks: the whole style under a
                                    // name, stored with the vault so a backup
                                    // carries it.
                                    Rectangle {
                                        width: root.panel-w;
                                        height: saved.preferred-height;

                                        saved := VerticalLayout {
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                spacing: 3px;
                                                Text {
                                                    text: "Saved profiles";
                                                    color: Theme.text;
                                                    font-size: 13.5px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: "Store the look above under a name and put it back later — after a reset, a new machine, or a friend's install. Profiles live in the vault, so an encrypted backup carries them.";
                                                    color: Theme.muted;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;

                                                opt-name-field := Field {
                                                    horizontal-stretch: 1;
                                                    autofocus: false;
                                                    placeholder: "Name this look, e.g. Evening focus";
                                                    value <=> root.opt-name;
                                                    accepted => { root.opt-save-profile(); }
                                                }

                                                Btn {
                                                    kind: 1;
                                                    h: 34px;
                                                    enabled: root.opt-can-save;
                                                    label: "Save current";
                                                    clicked => { root.opt-save-profile(); }
                                                }
                                            }

                                            if (root.opt-profiles.length == 0) : Text {
                                                text: "Nothing saved yet. Set the switches below how you like them, name the look and save it.";
                                                color: Theme.muted;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }

                                            for entry in root.opt-profiles : Rectangle {
                                                width: root.panel-w;
                                                height: profile-row.preferred-height;
                                                border-radius: Theme.radius-sm;
                                                background: entry.active ? #ffffff0d : #00000000;

                                                profile-row := HorizontalLayout {
                                                    padding: 8px;
                                                    padding-right: 10px;
                                                    spacing: 10px;

                                                    if (entry.id != root.opt-renamer) : VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        alignment: center;
                                                        spacing: 2px;

                                                        HorizontalLayout {
                                                            alignment: start;
                                                            spacing: 6px;

                                                            if (entry.active) : Text {
                                                                text: "✓";
                                                                color: Theme.accent;
                                                                font-size: 14px;
                                                                vertical-alignment: center;
                                                            }
                                                            Text {
                                                                text: entry.name;
                                                                color: Theme.text;
                                                                font-size: 13px;
                                                                vertical-alignment: center;
                                                                overflow: elide;
                                                            }
                                                        }
                                                        Text {
                                                            text: entry.meta;
                                                            color: Theme.muted;
                                                            font-size: 11.5px;
                                                        }
                                                    }

                                                    if (entry.id == root.opt-renamer) : VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        alignment: center;

                                                        Field {
                                                            value <=> root.opt-rename;
                                                            autofocus: true;
                                                            accepted => { root.opt-rename-commit(entry.id); }
                                                        }
                                                    }

                                                    HorizontalLayout {
                                                        spacing: 6px;

                                                        if (entry.id == root.opt-renamer) : HorizontalLayout {
                                                            spacing: 6px;

                                                            Btn {
                                                                kind: 2;
                                                                h: 28px;
                                                                label: "Save name";
                                                                clicked => { root.opt-rename-commit(entry.id); }
                                                            }
                                                            Btn {
                                                                kind: 2;
                                                                h: 28px;
                                                                label: "Cancel";
                                                                clicked => { root.opt-rename-cancel(); }
                                                            }
                                                        }
                                                        if (entry.id != root.opt-renamer) : HorizontalLayout {
                                                            spacing: 6px;

                                                            Btn {
                                                                kind: 0;
                                                                h: 28px;
                                                                enabled: !entry.active;
                                                                label: "Apply";
                                                                clicked => { root.opt-apply-profile(entry.id); }
                                                            }
                                                            Btn {
                                                                kind: 2;
                                                                h: 28px;
                                                                label: "Rename";
                                                                clicked => { root.opt-rename-start(entry.id); }
                                                            }
                                                            Btn {
                                                                kind: 2;
                                                                h: 28px;
                                                                label: "Overwrite";
                                                                clicked => { root.opt-overwrite(entry.id); }
                                                            }
                                                            Btn {
                                                                kind: 2;
                                                                h: 28px;
                                                                label: "Delete";
                                                                clicked => { root.opt-delete-profile(entry.id); }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            x: 0;
                                            y: parent.height - 1px;
                                            width: parent.width;
                                            height: 1px;
                                            background: Theme.hairline;
                                        }
                                    }

                                    // The measurements: two real numbers,
                                    // read off this process. The TS's page
                                    // also breaks its engine's process tree
                                    // down and counts DOM nodes; a native
                                    // build is one process with no engine
                                    // around it, so there is nothing else to
                                    // report.
                                    Rectangle {
                                        width: root.panel-w;
                                        height: costs.preferred-height;

                                        costs := VerticalLayout {
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                spacing: 3px;
                                                Text {
                                                    text: "What it costs right now";
                                                    color: Theme.text;
                                                    font-size: 13.5px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: "Measured on this machine, not estimated. This build is one process — there is no engine tree around it — so the working set and the private bytes are the whole story, and the browser build's per-process breakdown has nothing to list. Measure before and after flipping a switch to see what it actually bought.";
                                                    color: Theme.muted;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 24px;

                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text {
                                                        text: root.opt-work;
                                                        color: Theme.text;
                                                        font-size: 20px;
                                                        font-weight: 600;
                                                    }
                                                    Text {
                                                        text: "Task manager";
                                                        color: Theme.muted;
                                                        font-size: 11.5px;
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text {
                                                        text: root.opt-priv;
                                                        color: Theme.text;
                                                        font-size: 20px;
                                                        font-weight: 600;
                                                    }
                                                    Text {
                                                        text: "Private bytes";
                                                        color: Theme.muted;
                                                        font-size: 11.5px;
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;

                                                Btn {
                                                    kind: 1;
                                                    h: 28px;
                                                    label: "Measure again";
                                                    clicked => { root.opt-measure(); }
                                                }
                                                Text {
                                                    text: "Every refresh measures too — these are always the current numbers.";
                                                    color: Theme.muted;
                                                    font-size: 11.5px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            x: 0;
                                            y: parent.height - 1px;
                                            width: parent.width;
                                            height: 1px;
                                            background: Theme.hairline;
                                        }
                                    }

                                    // Reset belongs with the profiles it
                                    // undoes, not at the bottom of a list it
                                    // no longer matches the shape of.
                                    Rectangle {
                                        width: root.panel-w;
                                        height: reset.preferred-height;

                                        reset := VerticalLayout {
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                spacing: 3px;
                                                Text {
                                                    text: "Reset optimisations";
                                                    color: Theme.text;
                                                    font-size: 13.5px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: root.opt-snapshotted
                                                        ? "Puts back the look that was here before anything was traded away — background picture, sliders, mail cadence and all."
                                                        : "Restores every value this panel touches to its shipped default. Nothing here is destructive.";
                                                    color: Theme.muted;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            HorizontalLayout {
                                                alignment: start;
                                                Btn {
                                                    kind: 2;
                                                    h: 34px;
                                                    label: "Reset";
                                                    clicked => { root.opt-restore(); }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            x: 0;
                                            y: parent.height - 1px;
                                            width: parent.width;
                                            height: 1px;
                                            background: Theme.hairline;
                                        }
                                    }
                                }

                                if (root.opt-group == 1) : VerticalLayout {
                                    spacing: 0px;

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Reduce motion";
                                        hint: "Stops the spring and entrance animations. The biggest win on a large vault, and the one that helps most on battery.";
                                        checked <=> root.opt-motion-off;
                                        toggled => { root.opt-motion-toggled(); }
                                    }

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Micro-animations";
                                        hint: "The small transitions on the controls that never had any — buttons, chips, tabs, rows and badges. They run only while you interact, so the cost is a few frames per click rather than a cost per second.";
                                        checked <=> root.opt-micro;
                                        toggled => { root.pref-bool("microMotion", root.opt-micro); }
                                    }

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Quiet the background";
                                        hint: "Fades out the animated mesh gradient behind everything. It is the single heaviest thing the app repaints, so this is the switch to reach for first.";
                                        checked <=> root.opt-ambient-off;
                                        toggled => { root.opt-ambient-toggled(); }
                                    }

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Reduce transparency";
                                        hint: "Drops the frosted-glass blur on the topbar, dock and dialogs for flat, opaque surfaces. Blur is a per-frame GPU cost everywhere it appears.";
                                        checked <=> root.opt-transparency;
                                        toggled => { root.pref-bool("reduceTransparency", root.opt-transparency); }
                                    }

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Compact layout";
                                        hint: "Tighter spacing, so more fits on screen and less is painted while scrolling.";
                                        checked <=> root.opt-compact;
                                        toggled => { root.pref-string("density", root.opt-compact ? "compact" : "comfortable"); }
                                    }

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Flat cards";
                                        hint: "Removes the drop shadows under login cards. Cheap on its own, and it compounds with the others.";
                                        checked <=> root.opt-flat;
                                        toggled => { root.opt-cards-toggled(); }
                                    }

                                    // Always rendered, unlike the first
                                    // draft the TS had: "no full-bleed photo
                                    // is being repainted every frame" is a
                                    // real saving either way, and hiding the
                                    // row made the counter look broken.
                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Remove background image";
                                        hint: root.opt-no-picture
                                            ? "Nothing to remove — there is no background picture, so this saving is already in place."
                                            : "A full-bleed photo is decoded once and repainted under everything. Removing it is the largest single saving, but you lose the picture. Save a profile first if you want it back exactly.";
                                        checked <=> root.opt-no-picture;
                                        enabled: !root.opt-no-picture;
                                        toggled => { root.opt-background-removed(); }
                                    }
                                }

                                if (root.opt-group == 2) : VerticalLayout {
                                    spacing: 0px;

                                    // Chromium flags live on other machines
                                    // now — this build has no GPU process and
                                    // no spellcheck dictionary to free at
                                    // startup, so it is the one row the TS
                                    // shows everywhere. Stored and counted
                                    // here; the mail and editor phases bring
                                    // the editable text a spellcheck would
                                    // serve.
                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Disable spellcheck";
                                        hint: "Stored now and counted in the readout above; the mail and editor phases bring the editable text a spellcheck would serve.";
                                        checked <=> root.opt-spellcheck;
                                        toggled => { root.pref-bool("disableSpellcheck", root.opt-spellcheck); }
                                    }
                                }

                                if (root.opt-group == 3) : VerticalLayout {
                                    spacing: 0px;

                                    // Nothing connected means nothing polls,
                                    // so the saving is already in place —
                                    // shown as a locked "on" rather than an
                                    // off switch that could never be reached,
                                    // which is what kept the counter off its
                                    // own total on a fresh install.
                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Slower mail polling";
                                        hint: root.opt-mail-locked
                                            ? "Nothing to poll — no mailbox is connected, so no background check is running. Connect one and this becomes a choice."
                                            : "Stretches every connected mailbox to a 15-minute refresh. Mail reads immediately when you open a login, so this only affects background checks.";
                                        checked <=> root.opt-mail-on;
                                        enabled: !root.opt-mail-locked;
                                        toggled => { root.opt-mail-toggled(); }
                                    }

                                    toggle-row {
                                        panel-w: root.panel-w;
                                        label: "Fetch inline images";
                                        hint: "Inline images (logos, signatures, photos pasted into a message) are fetched when a message is opened. Switching this off reads the text only — the largest single saving when opening mail, and nothing about the message list changes.";
                                        checked <=> root.opt-mail-images;
                                        toggled => { root.pref-bool("mailInlineImages", root.opt-mail-images); }
                                    }

                                    seg-row {
                                        panel-w: root.panel-w;
                                        label: "Messages per page";
                                        hint: "How many headers each mailbox page holds. Smaller pages mean less mail kept in memory at once; larger pages mean fewer round trips while scrolling.";
                                        options: ["25", "50", "100"];
                                        ids: ["25", "50", "100"];
                                        value: root.opt-page-size;
                                        picked(id) => { root.opt-page-picked(id); }
                                    }

                                    // The cache is what lets an expander show
                                    // a message body without a second IMAP
                                    // read, and this is the one button here
                                    // that reclaims memory right now rather
                                    // than preventing the memory being spent
                                    // later.
                                    btn-row {
                                        panel-w: root.panel-w;
                                        label: "Clear cached messages";
                                        hint: "Drops every cached message body this app holds. Open messages are refetched on the next open, so nothing is lost — the mail itself lives on the server.";
                                        button-text: "Clear cache";
                                        button-kind: 2;
                                        button-enabled: !root.opt-cache-empty;
                                        clicked => { root.opt-cache-clear(); }
                                    }
                                }
                            }

                            // Every panel not landed yet. The header already
                            // names the section and says what it is for, so
                            // the body only has to be honest about the wait.
                            // ---- About ----------------------------------------
                            // Five skinny facts and one destructive button
                            // (`Settings.tsx`'s last tab). The TS's
                            // "Keyboard shortcuts" row is not here yet — the
                            // rail's shortcut sheet it points at lands with
                            // Phase 8 — so the panel ships with four.
                            if (root.active.id == "about") : VerticalLayout {
                                width: root.panel-w;
                                spacing: 0px;

                                chip-row {
                                    panel-w: root.panel-w;
                                    label: "Version";
                                    hint: "Colax — local-first password vault. The exact running build.";
                                    chip-text: root.about-version;
                                    accent: true;
                                }

                                chip-row {
                                    panel-w: root.panel-w;
                                    label: "Where your data goes";
                                    hint: "Nowhere. There is no server and no network call.";
                                    chip-text: "offline only";
                                    accent: true;
                                }

                                btn-row {
                                    panel-w: root.panel-w;
                                    label: "Copy diagnostics";
                                    hint: "Version, preferences and item counts. No secrets.";
                                    button-text: "Copy report";
                                    clicked => { root.about-copy-report(); }
                                }

                                // The one dangerous button the tab owns, and
                                // the reason it lives beside the version
                                // stamp: a reset takes the saved looks with
                                // it, which the hint says out loud. The TS
                                // fires it without a confirm, and so does
                                // this.
                                btn-row {
                                    panel-w: root.panel-w;
                                    label: "Reset preferences";
                                    hint: "Keeps your logins, restores every setting to its default. Saved looks and profiles are settings too, and they go with it.";
                                    button-text: "Reset settings";
                                    button-kind: 3;
                                    clicked => { root.about-reset(); }
                                }

                                chip-row {
                                    panel-w: root.panel-w;
                                    label: "Created by";
                                    hint: "Behind every pixel of this vault.";
                                    chip-text: "iraveos";
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- The three confirm sheets -----------------------------------------
    // Declared last so they draw over the sheet. `modal` puts each in the
    // window's middle; the footer buttons share the width, the way
    // `.modal__footer .btn{flex:1}` stretches them.

    if (root.data-protect-open) : Modal {
        title: "Protect this backup";
        closed => { root.data-protect-cancel(); }

        Alert {
            info: true;
            message: "The backup is re-wrapped with this password, so the file is protected even if it leaves this device. Remember it: there is no way to recover a lost backup password.";
        }

        Field {
            value <=> root.data-export-password;
            placeholder: "Backup password";
            password: true;
            edited => { root.data-export-edited(); }
        }

        HorizontalLayout {
            spacing: 8px;
            Btn {
                horizontal-stretch: 1;
                kind: 1;
                label: "Cancel";
                clicked => { root.data-protect-cancel(); }
            }
            Btn {
                horizontal-stretch: 1;
                kind: 0;
                label: "Export";
                // `disabled={busy || estimateStrength(exportPassword).score < 2}`
                // (Settings.tsx L2197) -- the score is Rust's.
                enabled: root.data-export-score >= 2;
                clicked => { root.data-protect-confirm(); }
            }
        }
    }

    if (root.data-reset-open) : Modal {
        title: "Delete all data?";
        closed => { root.data-reset-cancel(); }

        Alert {
            message: root.data-reset-message;
        }

        HorizontalLayout {
            spacing: 8px;
            Btn {
                horizontal-stretch: 1;
                kind: 1;
                label: "Cancel";
                clicked => { root.data-reset-cancel(); }
            }
            Btn {
                horizontal-stretch: 1;
                kind: 3;
                label: "Delete everything";
                clicked => { root.data-reset-confirmed(); }
            }
        }
    }

    if (root.data-restore-name != "") : Modal {
        title: "Restore from backup";
        closed => { root.data-restore-cancel(); }

        Alert {
            warn: true;
            message: root.data-restore-message;
        }

        if (root.data-restore-error != "") : Alert {
            message: root.data-restore-error;
        }

        // `.field` with its `.field__note`: the note sits under the input
        // and is honest about the passwordless case even though the button
        // below still wants a character typed.
        VerticalLayout {
            spacing: 6px;

            Field {
                value <=> root.data-restore-password;
                placeholder: "Backup vault password";
                password: true;
                edited => { root.data-restore-edit(); }
            }

            Text {
                text: "Leave empty if the backup has no vault password.";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                width: parent.width;
            }
        }

        toggle-row {
            panel-w: 496px;
            hairline: false;
            label: "Restore without a vault password";
            checked <=> root.data-restore-passwordless;
            toggled => { root.data-restore-edit(); }
        }

        if (!root.data-restore-passwordless) : VerticalLayout {
            spacing: 14px;

            toggle-row {
                panel-w: 496px;
                hairline: false;
                label: "Use a different password on this device";
                checked <=> root.data-restore-rekey;
                toggled => { root.data-restore-edit(); }
            }

            if (root.data-restore-rekey) : Field {
                value <=> root.data-restore-next;
                placeholder: "New vault password";
                password: true;
                edited => { root.data-restore-edit(); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Btn {
                horizontal-stretch: 1;
                kind: 1;
                label: "Cancel";
                clicked => { root.data-restore-cancel(); }
            }
            Btn {
                horizontal-stretch: 1;
                kind: 0;
                label: "Restore vault";
                // `busy || password.length === 0 || (rekey && next.length < 10)`
                // (Settings.tsx L2686) — `data-restore-ready` is that
                // expression's first two clauses, rescored in Rust.
                enabled: root.data-restore-ready && !root.data-restore-busy;
                clicked => { root.data-restore-submit(); }
            }
        }
    }
}
