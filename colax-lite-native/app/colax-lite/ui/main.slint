    // a plain two-way binding and still read the way the web's does.
    in-out property <bool> settings-desk-launch-at-login: false;
    in-out property <bool> settings-desk-tray: true;
    in-out property <bool> settings-desk-close-to-tray: true;
    in-out property <bool> settings-desk-mute: false;
    // The Generator tab. Its six dials are the same fields the editor's own
