// Colax Lite's native interface -- Phase 2.
//
// One window, eight screens: first run (choose a protection), create
// (password -> confirm), unlock (password or device), import (backup
// password), the vault list itself, and an error screen for a vault file
// that cannot be opened at all.
//
// Division of labour with Rust (`src/main.rs`): every state *transition*
// lives there -- this file only renders the screen it is told to show and
// reports what the user did. The two `if` branches at the bottom of
// MainWindow are the whole screen switch; inputs inside a stage block are
// recreated when the stage appears, which is what focuses them (`init`).

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
// `Badge` the widget is aliased: models.slint also exports a `Badge` *struct*
// and one name cannot mean both here.
import { Btn, Field, Alert, Badge as BadgeBox, EmptyState, StrengthMeter } from "widgets.slint";
import { Screen, Badge, LoginCard, SidebarRow, TagChip, ViewKind, RailPosition, HueSwatch, PickTag, QuestionRow, QrCell, OptRow, DashRing, DashIssue, DashStat, DashRow, DashBar, DashReuse, DashUse, DashDay, DashKey, DashPop, HistoryData } from "models.slint";
import { Editor } from "screens/editor.slint";
import { SecurityGate } from "screens/security.slint";
import { Dashboard } from "screens/dashboard.slint";
import { History } from "screens/history.slint";
import { Settings, AccentChip, HiddenRow } from "screens/settings.slint";

// ---- The vault's four presentations -------------------------------------
// `VIEW_OPTIONS` in ViewMenu.tsx: Flow, Orbit, List, Grid -- four cards with
// the same data and four different shapes. They share two components: the
// compact face Grid and Orbit both draw, and the list row Flow and List both
// draw. Everything here follows the one sizing rule this app has proven
// works for a component outside a layout: the root fills its parent (the
// `Label` arrangement), and whoever places it owns the geometry.

// The compact card: tile, name, username, badges, modified note. Small
// enough to survive a grid cell and deep enough to still be a card.
component card-face inherits Rectangle {
    in property <LoginCard> card;
    callback open(id: string);

    face-touch := TouchArea {
        clicked => { root.open(root.card.id); }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: Theme.radius-md;
        background: root.card.selected ? Theme.accent-soft
            : (face-touch.has-hover ? Theme.row-hover : Theme.field);
        border-width: 1px;
        border-color: root.card.selected ? Theme.border-focus : Theme.border;

        VerticalLayout {
            padding-top: 12px;
            padding-bottom: 10px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 5px;

            HorizontalLayout {
                spacing: 9px;

                Rectangle {
                    width: 34px;
                    height: 34px;
                    vertical-stretch: 0;
                    border-radius: 9px;
                    background: root.card.tile;

                    if (!root.card.has-image) : Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.card.initial;
                        color: #ffffff;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if (root.card.has-image) : Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.card.image;
                        image-fit: contain;
                    }
                }

                VerticalLayout {
                    spacing: 2px;

                    Text {
                        text: root.card.label;
                        color: Theme.text;
                        font-size: 13.5px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: bottom;
                    }

                    Text {
                        text: root.card.username == ""
                            ? (root.card.hostname == "" ? "(no username)" : root.card.hostname)
                            : root.card.username;
                        color: Theme.muted;
                        font-size: 11.5px;
                        overflow: elide;
                    }
                }
            }

            if (root.card.badges.length > 0) : HorizontalLayout {
                spacing: 5px;
                alignment: start;

                for badge in root.card.badges : BadgeBox {
                    label: badge.label;
                    tone: badge.tone;
                }
            }

            Rectangle { vertical-stretch: 1; height: 1px; }

            if (root.card.modified-note != "") : Text {
                text: root.card.modified-note;
                color: Theme.faint;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}

// One card on Orbit's ring. The angle decides everything geometric: where it
// sits, how big it is, how faded. `cos` is the depth axis -- the card at the
// front of the ring is the big sharp one -- and `sin` walks the ring left to
// right. Slint has no 3-D transforms, so this is the carousel drawn as the
// ellipse it would project onto, which is what the TS preset draws too.
component orbit-card inherits Rectangle {
    in property <LoginCard> card;
    in property <float> angle;
    in property <bool> show: true;
    // The ring's box, handed in: a component's root has no `parent` to ask.
    in property <length> ring-w;
    in property <length> ring-h;
    callback open(id: string);

    // Depth as size rather than as a transform. `cos` is the depth axis, so
    // the card at the front of the ring is the big one and the ones behind
    // it shrink away; growing the rectangle instead of scaling the element
    // keeps the face's own text at its own size and lands in the same
    // picture. The trig wants an *angle*, hence `* 1deg` on the float.
    property <float> depth: (Math.cos(root.angle * 1deg) + 1.0) / 2.0;
    property <length> card-w: 190px + 62px * root.depth;
    property <length> card-h: 118px + 36px * root.depth;

    visible: root.show;
    width: root.card-w;
    height: root.card-h;
    x: root.ring-w / 2 - root.card-w / 2 + Math.sin(root.angle * 1deg) * Math.min(root.ring-w * 0.42, 470px);
    y: root.ring-h / 2 - root.card-h / 2 + Math.cos(root.angle * 1deg) * 26px;
    opacity: 0.28 + 0.72 * root.depth;

    card-face {
        card: root.card;
        open => { root.open(root.card.id); }
    }
}

// One row of the list-shaped views: the line the vault has always drawn,
// lifted out so Flow and List can share it. Flow's only difference is the
// arrival -- rows fade in staggered, which is the whole of
// "spring-animated cards" with the tools Slint has (animate the properties
// that read as arrival, not a physics engine).
component list-row inherits Rectangle {
    in property <LoginCard> card;
    in property <bool> busy: false;
    in property <bool> show-urls: true;
    in property <bool> animated: false;
    in property <int> index: 0;
    callback open(id: string);
    callback copy(id: string);
    callback star(id: string);

    property <bool> entered: false;

    height: 86px;
    border-radius: Theme.radius-md;
    background: root.card.selected ? Theme.accent-soft
        : (card-touch.has-hover ? Theme.row-hover : #00000000);
    border-width: root.card.selected ? 1px : 0px;
    border-color: root.card.selected ? Theme.border-focus : #00000000;
    opacity: root.animated && !root.entered ? 0.0 : 1.0;
    animate opacity {
        duration: 280ms;
        easing: ease-out;
        delay: root.animated ? root.index * 22ms : 0ms;
    }
    init => { root.entered = true; }

    card-touch := TouchArea {
        // One click opens the editor. The TS app needs a double-click here
        // (single-click only selects), but a native list has no context
        // menu and no selection state doing anything yet -- making the
        // user discover a second click to edit is a web habit, not a
        // feature.
        clicked => { root.open(root.card.id); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;

        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: root.card.tile;

            if (!root.card.has-image) : Text {
                width: parent.width;
                height: parent.height;
                text: root.card.initial;
                color: #ffffff;
                font-size: 17px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if (root.card.has-image) : Image {
                width: parent.width;
                height: parent.height;
                source: root.card.image;
                image-fit: contain;
            }
        }

        VerticalLayout {
            spacing: 3px;
            vertical-stretch: 1;

            // Badges sit above the title, not beside the username: a login
            // with three of them would otherwise push the name out of the
            // card (the reason `HealthBadges` got its own row in views.tsx).
            if (root.card.badges.length > 0) : HorizontalLayout {
                spacing: 6px;
                // Left-aligned at the badges' own widths: the default
                // stretch would spread three chips evenly across the card.
                alignment: start;

                for badge in root.card.badges : BadgeBox {
                    label: badge.label;
                    tone: badge.tone;
                }
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.card.label;
                    color: Theme.text;
                    font-size: 14.5px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }

                if (root.card.favorite) : Text {
                    text: "★";
                    color: Theme.warn;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                if (root.card.needs-attention) : Text {
                    text: "!";
                    color: Theme.danger;
                    font-size: 12px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.card.username == ""
                    ? (root.card.hostname == "" ? "(no username)" : root.card.hostname)
                    : root.card.username;
                color: Theme.muted;
                font-size: 12.5px;
                overflow: elide;
            }

            if (root.card.modified-note != "") : Text {
                text: root.card.modified-note;
                color: Theme.faint;
                font-size: 11.5px;
                overflow: elide;
            }
        }

        Rectangle { horizontal-stretch: 1; width: 1px; }

        VerticalLayout {
            spacing: 2px;
            alignment: center;

            if (root.show-urls && root.card.hostname != "") : Text {
                width: 200px;
                text: root.card.hostname;
                color: Theme.faint;
                font-size: 12.5px;
                horizontal-alignment: right;
                overflow: elide;
            }

            Text {
                width: 200px;
                text: root.card.masked-password;
                color: Theme.muted;
                font-size: 13px;
                horizontal-alignment: right;
                letter-spacing: 1px;
            }
        }

        Btn {
            label: "Copy";
            kind: 1;
            h: 32px;
            enabled: !root.busy;
            clicked => { root.copy(root.card.id); }
        }

        // Favourite, on its own so it can be hit without opening the
        // editor. The star next to the title only *reports* the state;
        // this is what changes it.
        Rectangle {
            width: 30px;
            height: 30px;
            vertical-stretch: 0;
            border-radius: 8px;
            background: star-touch.has-hover ? #ffffff14 : #00000000;

            star-touch := TouchArea {
                clicked => { root.star(root.card.id); }
            }

            Text {
                width: parent.width;
                height: parent.height;
                text: root.card.favorite ? "★" : "☆";
                color: root.card.favorite ? Theme.warn : Theme.muted;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// One button of the view switcher. `labels-mode` is the `sidebarLabels`
// pref (icon / name / both) that Settings offers in TS: one value decides
// whether the four buttons spell themselves out.
component view-chip inherits Rectangle {
    in property <string> view-id;
    in property <string> label;
    in property <string> glyph;
    in property <color> hue;
    in property <bool> selected: false;
    in property <string> labels-mode: "both";
    callback picked();

    height: 32px;
    border-radius: 8px;
    background: root.selected ? root.hue.with-alpha(0.16)
        : (chip-touch.has-hover ? Theme.row-hover : #00000000);
    border-width: root.selected ? 1px : 0px;
    border-color: root.selected ? root.hue.with-alpha(0.45) : #00000000;

    chip-touch := TouchArea {
        clicked => { root.picked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        if (root.labels-mode != "name") : Text {
            text: root.glyph;
            color: root.selected ? root.hue : Theme.muted;
            font-size: 13px;
            vertical-alignment: center;
        }

        if (root.labels-mode != "icon") : Text {
            text: root.label;
            color: root.selected ? Theme.text : Theme.muted;
            font-size: 12.5px;
            font-weight: root.selected ? 600 : 500;
            vertical-alignment: center;
        }
    }
}

// One rail row, both dockings. As a column line it fills the rail's width
// and lays out dot / label / count left to right; as a strip pill it hugs
// its own content (a rectangle in a layout keeps its preferred width when
// that is what the layout asks for -- the same thing `Btn` does in the
// topbar). `labels-mode` is `sidebarLabels` and `compact` the narrowed rail:
// between them they are TS's `showIcon`/`showLabel` (Sidebar.tsx L177-189),
// with the count kept only while there is room for it. In a compact dock the
// padding *is* the centring: 8 of rail, 14 of row, puts the 16px dot at 22
// in a 60px column.
component rail-row inherits Rectangle {
    in property <SidebarRow> entry;
    in property <string> labels-mode: "both";
    in property <bool> compact: false;
    callback picked(id: string);

    border-radius: Theme.radius-sm;
    background: root.entry.selected ? Theme.accent-soft
        : (rail-touch.has-hover ? Theme.row-hover : #00000000);

    rail-touch := TouchArea {
        clicked => { root.picked(root.entry.id); }
    }

    HorizontalLayout {
        padding-left: root.compact ? 14px : 10px;
        padding-right: root.compact ? 14px : 10px;
        spacing: root.compact ? 0px : 10px;

        if (root.labels-mode != "name") : Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: root.entry.hue;
            opacity: root.entry.selected ? 1.0 : 0.65;
        }

        if (root.labels-mode != "icon" && !root.compact) : Text {
            text: root.entry.label;
            color: root.entry.selected ? Theme.text : Theme.muted;
            font-size: 13px;
            font-weight: root.entry.selected ? 600 : 500;
            overflow: elide;
            vertical-alignment: center;
        }

        if (!root.compact) : Rectangle { horizontal-stretch: 1; width: 1px; }

        if (root.entry.count > 0 && !root.compact) : Text {
            text: root.entry.count;
            color: root.entry.selected ? Theme.accent-text : Theme.faint;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// The sidebar footer's Settings row (Sidebar.tsx L602): a gear and the
// word, or just the gear once the rail narrows. It is how the shell opens
// the modal — the dashboard's cards are the other way in.
component settings-item inherits Rectangle {
    in property <bool> compact: false;
    in property <bool> labels: true;
    callback clicked();

    height: 34px;
    border-radius: Theme.radius-sm;
    background: footer-touch.has-hover ? Theme.row-hover : #00000000;

    footer-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Text {
            text: "⚙";
            color: Theme.muted;
            font-size: 14px;
            vertical-alignment: center;
        }

        if (root.labels && !root.compact) : Text {
            text: "Settings";
            color: Theme.muted;
            font-size: 13px;
            font-weight: 500;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// Re-exported so Rust can reach them: applyAppearance pushes every token into
// this global (ADR-2), items.rs and main.rs build the models (LoginCard,
// QuestionRow, QrCell, ...), and both need those types in the generated
// module.
export { Theme }
export { Badge, LoginCard, SidebarRow, TagChip, ViewKind, RailPosition, HueSwatch, PickTag, QuestionRow, QrCell, OptRow }

export component MainWindow inherits Window {
    title: "Colax Lite";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 880px;
    min-height: 560px;
    default-font-family: "Segoe UI";
    background: @linear-gradient(160deg, Theme.bg-deep, Theme.bg);

    in property <Screen> screen;
    // Messages are written by the Rust side *and* cleared by `changed
    // screen` here, so they have to be `in-out`.
    in-out property <string> error-text;
    in-out property <string> notice-text;
    in property <bool> busy: false;
    // The derived models: rail (channels + a separator) and the visible
    // cards. Pushed together by `refresh_items` so they cannot disagree.
    in property <[LoginCard]> cards;
    in property <[SidebarRow]> sidebar;
    // The active channel. `in-out` because clicking a rail row writes it
    // here, and `channel-selected` then asks Rust to re-derive both models.
    in-out property <string> active-channel: "all";
    // The rail label for the active channel, pushed with the models above
    // (a channel may be renamed, and "All logins" is only the default).
    in property <string> channel-name;
    // Empty-state copy for the *channel*, not the query: a search with no
    // hits is a different problem from an empty channel and says so.
    in property <string> cards-empty-title;
    in property <string> cards-empty-hint;
    // `--showUrls`: the hostname column is a preference, not a constant.
    in property <bool> show-urls: true;
    // Which chrome the Layout tab's switches keep (Task 5.2b). These three
    // are the shortcuts the shell draws today; the rest of the flags gate
    // chrome that has not landed yet (the rail's shortcut sheet, its compact
    // and hide controls, the floating pills) and are listed in Settings ›
    // Hidden all the same, so none of them is a switch that lies.
    in property <bool> show-new-login: true;
    in property <bool> show-lock: true;
    in property <bool> show-settings-button: true;
    // "3 logins" / "1 login", assembled in Rust: pluralisation beats a
    // format function in the UI layer.
    in property <string> count-label;
    in-out property <string> search-text;
    // ---- View and sort ------------------------------------------------
    // The two knobs the TS topbar offers. Both are prefs and both write back
    // through Rust; the ids are storage.ts's own (`VaultView`, `SortMode`),
    // so a stored vault means the same thing here as there.
    in-out property <string> vault-view: "animated";
    in-out property <string> vault-sort: "title";
    // The label the current sort wears in the button ("Recently updated").
    in property <string> vault-sort-label: "Name";
    // `sidebarLabels`: icon / name / both. One value for the switcher *and*
    // for the rail alike -- TS reads the same pref at Sidebar.tsx L177-189
    // and again wherever the views are labelled.
    in property <string> labels-mode: "both";
    // ---- The rail's dials --------------------------------------------
    // `sidebarPosition` decides where it docks: left and right keep the
    // column and swap ends, top and bottom turn it into a strip across the
    // window (the four `data-rail` grids, app.css L32-44). `showSidebar`
    // takes it off the window entirely; `compactSidebar` -- or icon-only
    // labels -- narrows it to the dot column (60px, app.css L1310-1312).
    in-out property <string> rail-position: "left";
    in property <bool> rail-hidden: false;
    in property <bool> rail-compact: false;
    // Derived from the three above so the shell's geometry reads as facts
    // rather than as the same test written four times.
    in property <bool> rail-strip: !root.rail-hidden
        && (root.rail-position == "top" || root.rail-position == "bottom");
    in property <bool> rail-side: !root.rail-hidden && !root.rail-strip;
    in property <length> rail-w: root.rail-compact ? 60px : 244px;
    in property <length> rail-h: 56px;
    // The `motion` pref, 0..1: 0 is "reduce animation", and it is what Flow's
    // stagger and Orbit's drift both check.
    in property <float> motion: 1.0;
    // Grid: how many cells fit across, answered by Rust when the grid
    // reports its width (the tag cloud's arrangement, reused).
    in property <int> grid-cols: 3;
    // Orbit: the ring's angle in degrees, advanced by Rust's timer.
    in property <float> orbit-angle: 0.0;
    // The sort dropdown, and the six rows it lists (built in Rust, from the
    // same table the handler validates against).
    in-out property <bool> sort-menu-open: false;
    in property <[OptRow]> sort-options;
    in-out property <string> password-value;
    in-out property <string> confirm-value;
    // The undo strip for the last deletion. Empty means "nothing to undo",
    // which is the same test the Rust side uses.
    in-out property <string> undo-text;

    // ---- The item editor's draft -------------------------------------
    // Handed to `Editor` as `in-out`, so the screen owns the values while it
    // is open and `save-item` reads the lot back in one go.
    in-out property <string> edit-id;
    in-out property <string> edit-title;
    in-out property <string> edit-url;
    in-out property <string> edit-username;
    in-out property <string> edit-password;
    in-out property <string> edit-notes;
    in-out property <bool> edit-favorite;
    in-out property <bool> edit-needs-attention;
    in-out property <float> edit-reminder-days;
    in property <string> edit-reminder-label;
    in property <bool> edit-can-delete;
    // Strength of whatever is in the editor's password box, recomputed by
    // Rust on every keystroke.
    in property <int> edit-strength-score: -1;
    in property <string> edit-strength-label;
    in property <string> edit-strength-bits;
    in property <string> edit-strength-crack;
    // The generator, same idea.
    in-out property <bool> gen-show: false;
    in-out property <bool> gen-revealed: false;
    in-out property <string> gen-mode: "Random";
    in-out property <float> gen-length: 20;
    in-out property <float> gen-words: 5;
    in property <string> gen-length-label;
    in property <string> gen-words-label;
    in-out property <bool> gen-lower: true;
    in-out property <bool> gen-upper: true;
    in-out property <bool> gen-digits: true;
    in-out property <bool> gen-symbols: true;
    in-out property <bool> gen-avoid: true;
    in property <string> gen-value;
    in property <string> gen-mask;
    in property <int> gen-strength-score: -1;
    in property <string> gen-strength-label;
    in property <string> gen-strength-bits;
    in property <string> gen-strength-crack;
    in property <bool> editor-confirm-delete: false;
    in property <bool> gen-reveal-editor: false;
    in-out property <string> editor-section: "identity";

    // ---- The Appearance half of the draft ------------------------------
    // The hue is -1 for "auto"; `edit-hue-slider` is what the slider shows,
    // which is the chosen hue or the derived one, because a slider cannot
    // sit at -1. Everything numeric that has to reach the screen as *text*
    // arrives pre-formatted — Slint cannot turn a number into a string.
    in-out property <float> edit-accent-hue: -1;
    in-out property <float> edit-hue-slider: 212;
    in property <string> edit-hue-readout;
    in property <string> edit-blur-readout;
    in property <color> edit-preview-from;
    in property <color> edit-preview-to;
    in property <string> edit-preview-initial: "?";
    in property <[HueSwatch]> edit-hue-swatches;
    in-out property <string> edit-bg-image;
    in-out property <float> edit-bg-blur: 0;
    in-out property <string> edit-avatar-image;

    // ---- The Inbox half of the draft -----------------------------------
    in-out property <bool> edit-show-mail: false;
    // Value and label are pushed together, like the reminder pair: Rust owns
    // the mapping and the screen only counts in indices.
    in property <string> edit-mail-filter: "auto";
    in property <string> edit-mail-filter-label: "Auto";

    // ---- The Organise half of the draft --------------------------------
    // The tag *selection* lives in Rust (`editor_tags`), because the catalogue
    // it is chosen from is read from preferences on every push and only Rust
    // can see both at once. What crosses is a cloud already split into lines,
    // the box a new tag is typed into, and the two dates with their hints.
    in property <[[PickTag]]> edit-tag-rows;
    in property <bool> edit-tag-can-add: false;
    in-out property <string> edit-tag-input;
    in-out property <string> edit-pw-date;
    in-out property <string> edit-email-date;
    in property <string> edit-pw-date-hint;
    in property <string> edit-email-date-hint;

    // ---- The Security half of the draft ---------------------------------
    // The hashes and salts never cross this boundary. The draft itself lives
    // in Rust (`editor_security` in main.rs) because a PBKDF2 hash is not
    // something a screen should hold, and what arrives here is only what a
    // screen can read or type: the level, the two flags, the question
    // prompts, the QR symbol, and the four boxes the user types into.
    in property <string> edit-sec-level: "none";
    // "Not set" / "1 question" / "2 questions" -- composed in Rust, because
    // Slint cannot turn a number into part of a string.
    in property <string> edit-sec-questions-note: "Not set";
    in property <bool> edit-sec-totp: false;
    // Staged by Generate/Attach, not yet confirmed by a code: kept apart
    // from `edit-sec-totp` so nothing can be saved by accident.
    in property <bool> edit-sec-totp-staged: false;
    // The inline error under the code box (and under the paste row).
    in property <string> edit-sec-totp-note;
    // The `otpauth://` URI and the QR symbol it produced, pushed together
    // whenever the seed *or the login's name* changes -- the URI carries the
    // name, so renaming a login regenerates the code.
    in property <string> edit-sec-otpauth;
    in property <int> edit-qr-size: 0;
    in property <[QrCell]> edit-qr-cells;
    in property <bool> edit-sec-passcode: false;
    in property <string> edit-sec-passcode-error;
    // Prompts only: `SecurityQuestion`'s hash and salt stay in Rust.
    in property <[QuestionRow]> edit-sec-questions;
    in property <string> edit-sec-answer-error;
    in property <string> edit-sec-new-prompt;
    // Two-way, because Rust reads them to verify and clears them after.
    in-out property <string> edit-sec-totp-seed;
    in-out property <string> edit-sec-totp-code;
    in-out property <string> edit-sec-passcode-new;
    in-out property <string> edit-sec-passcode-confirm;
    in-out property <string> edit-sec-passcode-input;
    in-out property <string> edit-sec-checking-id;
    in-out property <string> edit-sec-check-input;
    in-out property <string> edit-sec-new-answer;

    callback create-no-password();
    callback create-with-password();
    callback create-import();
    callback password-next();
    callback create-back();
    callback create-submit();
    callback unlock-submit();
    callback open-device();
    callback import-submit();
    callback import-back();
    callback import-from-vault();
    callback lock-vault();
    callback copy-password(id: string);
    callback search-changed(query: string);
    callback channel-selected(id: string);
    // The History channel (Task 7.2): the query and segment are screen state
    // like `search-text`, reset with the channel switch, and every row action
    // travels back to Rust by id — restore, open, copy, forget, clear.
    callback history-query-changed();
    callback history-filter-changed(index: int);
    callback history-clear();
    callback history-restore(id: string);
    callback history-open(id: string);
    callback history-copy(value: string, label: string, item-id: string);
    callback history-forget(id: string);
    callback toggle-favorite(id: string);
    // The switcher and the sort menu. Both take the id, not the label: Rust
    // validates it against the pref's own whitelist before it writes.
    callback view-picked(view: string);
    callback sort-picked(sort: string);
    // Sent by the grid with its width, so Rust can answer with a column
    // count (Slint has no wrapping grid and no integer maths worth having).
    callback vault-relayout(width: float);
    // The rail's two dials. Ids, not labels: Rust checks each against the
    // pref's own whitelist before it writes.
    callback rail-picked(position: string);
    callback labels-picked(labels: string);
    // ---- The dashboard (Task 7.1) -----------------------------------------
    // The Command Center replaces the whole content pane when its channel is
    // active — toolbar and grid included, as the TS dashboard does. Rust
    // fills the models on every refresh (`dashboard.rs::fill`); the three
    // callbacks are the only way back out.
    in-out property <bool> show-dashboard: false;
    // The History channel takes the pane the dashboard's way: its own screen,
    // its own header, the list hidden behind it (Task 7.2).
    in-out property <bool> show-history: false;
    in-out property <HistoryData> history-data;
    in-out property <string> history-query;
    in-out property <int> history-filter: 0;
    in-out property <DashRing> dash-ring;
    in-out property <string> dash-sub: "";
    in-out property <bool> dash-empty: false;
    in-out property <bool> dash-has-password: false;
    in-out property <bool> dash-has-headline: false;
    in-out property <DashIssue> dash-headline;
    in-out property <[DashStat]> dash-stats;
    in-out property <[DashIssue]> dash-issues;
    in-out property <[DashRow]> dash-recent;
    in-out property <[DashKey]> dash-segments;
    in-out property <[DashKey]> dash-keys;
    in-out property <bool> dash-has-days: false;
    in-out property <[DashDay]> dash-days;
    in-out property <int> dash-days-added;
    in-out property <int> dash-days-changed;
    in-out property <[DashBar]> dash-domains;
    in-out property <[DashReuse]> dash-reuse;
    in-out property <[DashUse]> dash-uses;
    in-out property <int> dash-uses-total;
    in-out property <[DashRow]> dash-emails;
    in-out property <int> dash-emails-more;
    in-out property <[DashRow]> dash-factors;
    in-out property <int> dash-factors-more;
    in-out property <[DashBar]> dash-channels;
    in-out property <int> dash-channels-more;
    in-out property <int> dash-tag-count;
    in-out property <int> dash-channel-count;
    in-out property <DashPop> dash-pop-strength;
    in-out property <DashPop> dash-pop-domains;
    in-out property <DashPop> dash-pop-reuse;
    in-out property <DashPop> dash-pop-uses;
    // Bulk add and channel editing have no native panel yet; the buttons
    // report that rather than sitting dead (Settings landed in Phase 5).
    callback dash-bulk-add();
    callback dash-new-channel();
    callback dash-open-settings(section: string);
    // ---- The Settings window (Phase 5) -----------------------------------
    // An in-page modal over every screen: `settings-open` mounts it,
    // `settings-tab-index` is the lit rail row (the `SETTINGS_TABS` order
    // in main.rs), and the eleven appearance dials ride two-way so a drag
    // writes up through `pref-float` while the saved answer settles back
    // down. The dashboard's deep links ("channels", "security") and the
    // sidebar's footer row both arrive through `open-settings`.
    callback open-settings(section: string);
    callback settings-closed();
    callback settings-tab-picked(index: int);
    callback settings-pref-string(key: string, value: string);
    callback settings-pref-float(key: string, value: float);
    callback settings-pref-bool(key: string, value: bool);
    callback settings-hidden-restore(key: string, id: string);
    callback settings-hidden-restore-all();
    in-out property <bool> settings-open: false;
    in-out property <int> settings-tab-index: 0;
    // The modal's frame, in logical pixels, kept in step with the window by
    // `settings_ops::follow_window` (see settings.slint for why Slint does
    // not compute this itself).
    in-out property <length> settings-w: 1080px;
    in-out property <length> settings-h: 700px;
    // The modal's body panel width, also Rust's (`follow_window`): every
    // wrapping hint in the sheet measures against it.
    in-out property <length> settings-panel-w: 768px;
    in-out property <string> settings-ap-theme: "system";
    in-out property <string> settings-ap-accent: "slate";
    in-out property <float> settings-ap-motion: 1.0;
    in-out property <float> settings-ap-motion-speed: 1.0;
    in-out property <float> settings-ap-ambient: 1.0;
    in-out property <float> settings-ap-text-scale: 100.0;
    in-out property <float> settings-ap-roundness: 1.0;
    in-out property <float> settings-ap-card-depth: 0.5;
    in-out property <string> settings-ap-density: "comfortable";
    in-out property <bool> settings-ap-reduce-transparency: false;
    in-out property <bool> settings-ap-high-contrast: false;
    in-out property <[AccentChip]> settings-accent-chips;
    // ---- The Settings window's Layout tab (Task 5.2) ---------------------
    // The four pickers are the same preferences the sidebar's own menus
    // write; the switches are the chrome, which the Hidden tab reads back as
    // rows pushed from Rust.
    in-out property <string> settings-lay-view: "animated";
    in-out property <string> settings-lay-sort: "title";
    in-out property <string> settings-lay-sidebar-labels: "both";
    in-out property <string> settings-lay-rail-position: "left";
    in-out property <bool> settings-lay-letter-groups: true;
    in-out property <bool> settings-lay-auto-tag-domain: true;
    in-out property <bool> settings-lay-unassigned-channel: true;
    in-out property <bool> settings-lay-auto-tag-channel: false;
    in-out property <bool> settings-lay-orbit-labels: true;
    in-out property <bool> settings-lay-health-badges: true;
    in-out property <bool> settings-lay-shortcuts: false;
    in-out property <bool> settings-lay-lock-button: true;
    in-out property <bool> settings-lay-new-channel-button: true;
    in-out property <bool> settings-lay-compact-button: true;
    in-out property <bool> settings-lay-new-login-button: true;
    in-out property <bool> settings-lay-bulk-add-button: true;
    in-out property <bool> settings-lay-settings-button: true;
    in-out property <bool> settings-lay-hide-sidebar-button: true;
    in-out property <bool> settings-lay-show-sidebar: true;
    in-out property <bool> settings-lay-show-urls: true;
    in-out property <bool> settings-lay-pin-favorites: true;
    in-out property <bool> settings-lay-floating-chrome: true;
    in-out property <bool> settings-lay-hide-dividers: false;
    in-out property <[HiddenRow]> settings-hidden-rows;
    // ---- SecurityGate ----------------------------------------------------
    // A blocking verification for a login or for the vault itself: any one
    // factor passes, and the open panel holds everything typed until Rust
    // says a check came back right (SecurityGate.tsx L12-93). The window
    // keeps only what it is handed *at open* -- the title, the hint, which
    // factors exist -- plus the error a failed attempt prints; the three
    // fields live in the panel and die with it.
    in property <bool> gate-open: false;
    in property <string> gate-title: "";
    in property <string> gate-hint: "This is protected. Prove it is you to continue.";
    in property <bool> gate-has-passcode: false;
    in property <bool> gate-has-totp: false;
    in property <bool> gate-has-questions: false;
    in property <[QuestionRow]> gate-questions;
    in property <string> gate-error: "";
    // mode: "passcode" | "totp" | "question"; question-id is the stored
    // question the answer was typed against.
    callback gate-unlock(mode: string, value: string, question-id: string);
    callback gate-cancel();

    // ---- The lock card -----------------------------------------------------
    // What the TS LockScreen's Frame carried and the first lock screens
    // shipped without (Task 6.2). `storage-persistent` is the startup probe
    // of the app data folder -- the native reading of the browser's storage
    // availability check; the lock-strength props are the create-password
    // meter, pushed on every edit the way the editor's own are.
    in property <bool> storage-persistent: true;
    in-out property <int> lock-strength-score: -1;
    in-out property <string> lock-strength-label: "";
    in-out property <string> lock-strength-bits: "";
    in-out property <string> lock-strength-crack: "";
    callback password-edited();
    callback suggest-password();
    callback toggle-theme();
    callback undo-clicked();
    callback undo-dismissed();
    callback quit-app();

    // ---- The item editor ---------------------------------------------
    callback open-editor(id: string);       // "" opens a new login
    callback editor-cancel();
    callback editor-save();
    callback editor-delete-asked();
    callback editor-delete-confirmed();
    callback editor-confirm-cancelled();
    callback editor-reveal();
    callback editor-section-selected(id: string);
    callback editor-password-edited();
    callback editor-generator-toggled();
    callback editor-regenerate();
    callback editor-gen-mode-picked(index: int);
    callback editor-use-generated();
    callback editor-copy-generated();
    callback editor-reminder-picked(index: int);
    // Appearance and Inbox. The image fields need no callback of their own:
    // they are two-way with the draft and nothing derives from them here.
    callback editor-hue-picked(hue: float);
    callback editor-title-edited();
    callback editor-bg-blur-changed(value: float);
    callback editor-mail-filter-picked(index: int);
    // Organise. Adding a tag writes the catalogue straight away (so it
    // survives a cancelled edit); toggling one only edits the draft's
    // selection, which Save hands over with the rest.
    callback editor-tag-add();
    callback editor-tag-toggle(id: string);
    callback editor-tag-relayout(width: float);
    callback editor-tag-input-edited();
    callback editor-date-edited(which: int);
    // Security. Rust does the work behind each one -- a PBKDF2 hash, an RFC
    // check, a QR matrix, a seeded draft -- and replies by pushing the
    // properties above. These only say what the user pushed.
    callback editor-sec-totp-attach();
    callback editor-sec-totp-generate();
    callback editor-sec-totp-check();
    callback editor-sec-totp-discard();
    callback editor-sec-totp-remove();
    callback editor-sec-passcode-save();
    callback editor-sec-passcode-check();
    callback editor-sec-passcode-remove();
    callback editor-sec-question-add();
    // Two-stage: first press opens the answer box, second verifies it.
    callback editor-sec-question-check(id: string);
    callback editor-sec-question-remove(id: string);
    callback editor-sec-prompt-step(delta: int);

    // The transient layer -- the messages, the typed-in text that cannot
    // still be needed (the create flow stashes the password in Rust before
    // leaving its stage), the meter, the search box -- is reset by `goto` in
    // Rust, once, in the same tick as the switch. That is where it lives
    // because of when this handler runs: a `changed` callback fires *after*
    // the frame that changed, so a message set on the far side of a screen
    // switch was wiped before it was ever drawn. The dev walk caught it:
    // "Vault created." and the suggested password each survived one
    // synchronous dump and were gone by the next, half a second later. A
    // reset in Rust runs before the caller sets its own values, so what is
    // set after a switch now stays set.

    // -- The screens -------------------------------------------------------
    // Exactly one of the three branches below exists at any moment, and all
    // three are children of the window's single root layout. That is what
    // makes a screen as tall as the window: a screen cannot ask for it
    // itself. Geometry written on a component at the call site is not
    // applied to its root -- the root keeps the height of its own content,
    // which parked the editor's footer in the middle of the window, one
    // section deep. A layout, by contrast, sizes its children directly.
    // The screens lay out inside this box; the gate floats over them (a
    // layout child is *placed*, and a full-window overlay must not be).
    // The tree below keeps the indentation it already had -- Slint reads
    // structure, not columns -- so the only new lines here are this one and
    // its closing brace.
    Rectangle {
    VerticalLayout {
        spacing: 0px;
        // What the window opens at is decided by the `Window` above:
        // `preferred-height` is the height, and `min-height` the floor. Two
        // things can still hold it below that -- a screen whose maximum is
        // smaller than the preferred size (measured: the editor capped the
        // window at 414 tall on Identity), which each screen disarms with a
        // sizeless cell of its own; and nothing else. Constraints written
        // here, on the root layout, are dropped: the component's root is the
        // `Window`, and only its `min-*`/`preferred-*` reach the window's
        // first sizing.

        // -- Vault: rail + content ------------------------------------------
        // A child of a layout defaults to `stretch: 0`, which leaves it as tall
        // as its content and parks the spare space at the bottom of the window.
        // The plain Rectangle around the two columns is the sort menu's shell:
        // a layout child is placed by the layout, and a floating panel needs
        // somewhere to be placed *at*.
        if (root.screen == Screen.Vault) : Rectangle {
            vertical-stretch: 1;

            // ---- The rail -------------------------------------------------
            // Docked by `sidebarPosition`: a column on one side, or a strip
            // across the window. Both boxes are placed by hand because a
            // layout orders its children by declaration, and the right-hand
            // dock is the same markup in the other order -- which no layout
            // can express.
            rail := Rectangle {
                background: Theme.bg-deep;
                width: root.rail-strip ? parent.width
                    : (root.rail-side ? root.rail-w : 0px);
                height: root.rail-strip ? root.rail-h
                    : (root.rail-side ? parent.height : 0px);
                x: root.rail-strip ? 0px
                    : (root.rail-position == "right" ? parent.width - root.rail-w : 0px);
                y: root.rail-strip
                    ? (root.rail-position == "top" ? 0px : parent.height - root.rail-h)
                    : 0px;
                clip: true;

                // Side: the column, top to bottom. The padding narrows with
                // the rail; the name and the count are simply not built when
                // there is no room left for them.
                if (!root.rail-strip) : VerticalLayout {
                    padding-top: 26px;
                    padding-bottom: 20px;
                    padding-left: root.rail-compact ? 8px : 14px;
                    padding-right: root.rail-compact ? 8px : 14px;
                    spacing: 4px;

                    HorizontalLayout {
                        padding-left: root.rail-compact ? 7px : 8px;
                        padding-bottom: root.rail-compact ? 8px : 18px;
                        spacing: 10px;

                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 8px;
                            background: @linear-gradient(120deg, Theme.grad-from, Theme.grad-to);

                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: "C";
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if (!root.rail-compact) : Text {
                            text: "Colax Lite";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // The rail itself: channels and one hairline before the
                    // summary screens. A separator is `kind: 2` and has no id —
                    // nothing can select it.
                    for row in root.sidebar : Rectangle {
                        height: row.kind == 2 ? 20px : 34px;

                        if (row.kind == 2) : Rectangle {
                            x: 8px;
                            y: (parent.height - 1px) / 2;
                            width: parent.width - 16px;
                            height: 1px;
                            background: Theme.hairline;
                        }

                        if (row.kind != 2) : rail-row {
                            entry: row;
                            labels-mode: root.labels-mode;
                            compact: root.rail-compact;
                            picked => {
                                root.active-channel = row.id;
                                root.channel-selected(row.id);
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; height: 1px; }

                    if (root.show-settings-button) : settings-item {
                        compact: root.rail-compact;
                        labels: root.labels-mode != "icon";
                        clicked => { root.open-settings(""); }
                    }

                    if (!root.rail-compact) : Text {
                        text: root.count-label;
                        color: Theme.faint;
                        font-size: 12px;
                    }
                }

                // Strip: the same rows as pills across the window -- TS flips
                // the list to a row (app.css L40-70) rather than re-rendering
                // it, and these two layouts are that flip. Rows keep their
                // 34px and hug whatever they need; the count rides the far end.
                if (root.rail-strip) : HorizontalLayout {
                    padding-top: 11px;
                    padding-bottom: 11px;
                    padding-left: 14px;
                    padding-right: 18px;
                    spacing: 6px;

                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 8px;
                        background: @linear-gradient(120deg, Theme.grad-from, Theme.grad-to);

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "C";
                            color: #ffffff;
                            font-size: 15px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if (!root.rail-compact) : Text {
                        text: "Colax Lite";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    for row in root.sidebar : Rectangle {
                        height: row.kind == 2 ? 22px : 34px;

                        // The rule turns with the rail: a hairline standing up
                        // instead of lying down (app.css L68).
                        if (row.kind == 2) : Rectangle {
                            x: 0px;
                            y: (parent.height - 22px) / 2;
                            width: 1px;
                            height: 22px;
                            background: Theme.hairline;
                        }

                        if (row.kind != 2) : rail-row {
                            entry: row;
                            labels-mode: root.labels-mode;
                            compact: root.rail-compact;
                            picked => {
                                root.active-channel = row.id;
                                root.channel-selected(row.id);
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; width: 1px; }

                    Text {
                        text: root.count-label;
                        color: Theme.faint;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    if (root.show-settings-button) : settings-item {
                        compact: root.rail-compact;
                        labels: root.labels-mode != "icon";
                        clicked => { root.open-settings(""); }
                    }
                }
            }

            // ---- The content ----------------------------------------------
            // Placed in the rail's wake: the side column leaves its width
            // beside it, the strip leaves its height above or below, and a
            // hidden rail leaves nothing at all.
            Rectangle {
                x: root.rail-side && root.rail-position == "left" ? root.rail-w : 0px;
                y: root.rail-strip && root.rail-position == "top" ? root.rail-h : 0px;
                width: root.rail-side ? parent.width - root.rail-w : parent.width;
                height: root.rail-strip ? parent.height - root.rail-h : parent.height;

                // The Command Center takes the whole pane when its channel is
                // active — the toolbar and the grid go with the list, as they
                // do in the TS, because the dashboard brings its own header
                // and its own ways out.
                if (root.show-dashboard) : Dashboard {
                    ring: root.dash-ring;
                    sub: root.dash-sub;
                    empty: root.dash-empty;
                    has-password: root.dash-has-password;
                    has-headline: root.dash-has-headline;
                    headline: root.dash-headline;
                    stats: root.dash-stats;
                    issues: root.dash-issues;
                    recent: root.dash-recent;
                    segments: root.dash-segments;
                    keys: root.dash-keys;
                    has-days: root.dash-has-days;
                    days: root.dash-days;
                    days-added: root.dash-days-added;
                    days-changed: root.dash-days-changed;
                    domains: root.dash-domains;
                    reuse: root.dash-reuse;
                    uses: root.dash-uses;
                    uses-total: root.dash-uses-total;
                    emails: root.dash-emails;
                    emails-more: root.dash-emails-more;
                    factors: root.dash-factors;
                    factors-more: root.dash-factors-more;
                    channels: root.dash-channels;
                    channels-more: root.dash-channels-more;
                    tag-count: root.dash-tag-count;
                    channel-count: root.dash-channel-count;
                    pop-strength: root.dash-pop-strength;
                    pop-domains: root.dash-pop-domains;
                    pop-reuse: root.dash-pop-reuse;
                    pop-uses: root.dash-pop-uses;

                    // Both routes exist on the root already: the rail handler
                    // clears the search and refreshes, the editor handler
                    // opens a new login for "".
                    select-channel(id) => { root.channel-selected(id); }
                    open-login(id) => { root.open-editor(id); }
                    add-login() => { root.open-editor(""); }
                    bulk-add() => { root.dash-bulk-add(); }
                    new-channel() => { root.dash-new-channel(); }
                    open-settings(section) => { root.dash-open-settings(section); }
                }
                // The History channel swaps in the same way — the rail and
                // the shell stay, the pane's contents go (Task 7.2).
                if (root.show-history) : History {
                    data: root.history-data;
                    filter: root.history-filter;
                    query <=> root.history-query;

                    query-edited => { root.history-query-changed(); }
                    filter-changed(i) => { root.history-filter-changed(i); }
                    clear => { root.history-clear(); }
                    restore(id) => { root.history-restore(id); }
                    open-login(id) => { root.history-open(id); }
                    copy(value, label, item-id) => { root.history-copy(value, label, item-id); }
                    forget(id) => { root.history-forget(id); }
                }
                if (!root.show-dashboard && !root.show-history) : VerticalLayout {
                    padding-top: 26px;
                    padding-bottom: 16px;
                    padding-left: 30px;
                    padding-right: 34px;
                    spacing: 14px;

                    // Title left, actions right: `space-between` keeps both at
                    // their own width and spends the slack between them, which
                    // is what `justify-content: space-between` does for the
                    // web's `.topbar`. The actions are one nested group, so the
                    // slack lands after the title and not between every button
                    // -- a stretch spacer instead would let them grow with the
                    // window.
                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 10px;

                        Text {
                            text: root.active-channel == "all"
                                ? "All logins"
                                : root.channel-name;
                            color: Theme.text;
                            font-size: 20px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 10px;

                            if (root.show-new-login) : Btn {
                                label: "New login";
                                kind: 1;
                                h: 36px;
                                horizontal-stretch: 0;
                                enabled: !root.busy;
                                clicked => { root.open-editor(""); }
                            }

                            Btn {
                                label: "Import";
                                kind: 1;
                                h: 36px;
                                horizontal-stretch: 0;
                                enabled: !root.busy;
                                clicked => { root.import-from-vault(); }
                            }

                            if (root.show-lock) : Btn {
                                label: root.busy ? "Working..." : "Lock";
                                kind: 0;
                                h: 36px;
                                horizontal-stretch: 0;
                                enabled: !root.busy;
                                clicked => { root.lock-vault(); }
                            }
                        }
                    }

                    if (root.error-text != "") : Alert {
                        message: root.error-text;
                    }

                    if (root.notice-text != "") : Alert {
                        message: root.notice-text;
                        good: true;
                    }

                    search-input := Field {
                        placeholder: "Search logins...";
                        value <=> root.search-text;
                        edited => { root.search-changed(root.search-text); }
                    }

                    // ---- The view switcher --------------------------------
                    // Four presentations of the same cards (VIEW_OPTIONS,
                    // ViewMenu.tsx), each with the hue TS paints it. The
                    // button set is static -- the ids are pref values, not
                    // data -- so what changes with `sidebarLabels` is only
                    // whether the names are spelled out.
                    HorizontalLayout {
                        spacing: 8px;
                        vertical-stretch: 0;

                        view-chip {
                            view-id: "animated";
                            label: "Flow";
                            glyph: "≈";
                            hue: #3b82f6;
                            selected: root.vault-view == "animated";
                            labels-mode: root.labels-mode;
                            picked => { root.view-picked("animated"); }
                        }

                        view-chip {
                            view-id: "carousel";
                            label: "Orbit";
                            glyph: "●";
                            hue: #8b5cf6;
                            selected: root.vault-view == "carousel";
                            labels-mode: root.labels-mode;
                            picked => { root.view-picked("carousel"); }
                        }

                        view-chip {
                            view-id: "basic";
                            label: "List";
                            glyph: "☰";
                            hue: #10b981;
                            selected: root.vault-view == "basic";
                            labels-mode: root.labels-mode;
                            picked => { root.view-picked("basic"); }
                        }

                        view-chip {
                            view-id: "grid";
                            label: "Grid";
                            glyph: "▦";
                            hue: #f59e0b;
                            selected: root.vault-view == "grid";
                            labels-mode: root.labels-mode;
                            picked => { root.view-picked("grid"); }
                        }

                        Rectangle { horizontal-stretch: 1; width: 1px; }

                        // The sort menu's anchor: same chrome as a chip, so
                        // the two rows read as one control strip.
                        Rectangle {
                            height: 32px;
                            vertical-stretch: 0;
                            border-radius: 8px;
                            background: root.sort-menu-open ? Theme.accent-soft
                                : (sort-touch.has-hover ? Theme.row-hover : #00000000);
                            border-width: 1px;
                            border-color: root.sort-menu-open ? Theme.border-focus : Theme.border;

                            sort-touch := TouchArea {
                                clicked => { root.sort-menu-open = !root.sort-menu-open; }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 7px;
                                alignment: center;

                                Text {
                                    text: "Sort";
                                    color: Theme.faint;
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.vault-sort-label;
                                    color: Theme.text;
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Text {
                                    text: "▾";
                                    color: Theme.muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if (root.cards.length == 0) : VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 6px;

                        if (root.search-text != "") : EmptyState {
                            title: "No matches";
                            hint: "Nothing in this vault matches \"" + root.search-text + "\".";
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                        }

                        if (root.search-text == "") : EmptyState {
                            title: root.cards-empty-title;
                            hint: root.cards-empty-hint;
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                        }
                    }

                    // ---- The four views ----------------------------------
                    // One cards model, four presentations (VIEW_OPTIONS in
                    // ViewMenu.tsx). The switch is here rather than in Rust
                    // because everything needed to draw is already on the
                    // card; what Rust owns is which one is showing, the
                    // column count the grid asks it for, and the angle the
                    // ring drifts by.

                    // List: the plain grouped list. `group` is the letter
                    // header, filled by Rust only where the sort and the
                    // grouping agree (see group_by_letter in items.rs).
                    if (root.vault-view == "basic" && root.cards.length > 0) : ListView {
                        vertical-stretch: 1;

                        for card in root.cards : VerticalLayout {
                            spacing: 2px;

                            if (card.group != "") : Rectangle {
                                height: 28px;
                                vertical-stretch: 0;

                                Text {
                                    x: 12px;
                                    width: parent.width - 24px;
                                    height: parent.height;
                                    text: card.group;
                                    color: Theme.faint;
                                    font-size: 11.5px;
                                    font-weight: 700;
                                    letter-spacing: 1.5px;
                                    vertical-alignment: bottom;
                                }
                            }

                            list-row {
                                card: card;
                                busy: root.busy;
                                show-urls: root.show-urls;
                                open => { root.open-editor(card.id); }
                                copy => { root.copy-password(card.id); }
                                star => { root.toggle-favorite(card.id); }
                            }
                        }
                    }

                    // Flow: the same rows arriving staggered. The delay
                    // rides on each row's own animation (`index * 22ms`), so
                    // the tenth card lands after the first with no timer in
                    // either language. `motion == 0` shows them at once.
                    if (root.vault-view == "animated" && root.cards.length > 0) : ListView {
                        vertical-stretch: 1;

                        for card[i] in root.cards : list-row {
                            card: card;
                            index: i;
                            animated: root.motion > 0.0;
                            busy: root.busy;
                            show-urls: root.show-urls;
                            open => { root.open-editor(card.id); }
                            copy => { root.copy-password(card.id); }
                            star => { root.toggle-favorite(card.id); }
                        }
                    }

                    // Grid: cells sized by Rust's answer to the width this
                    // block reports (`vault-relayout`), the tag cloud's
                    // arrangement reused because Slint still has no wrapping
                    // grid and its integer maths is still not worth having.
                    if (root.vault-view == "grid" && root.cards.length > 0) : Flickable {
                        vertical-stretch: 1;

                        grid-body := Rectangle {
                            width: parent.width;
                            height: Math.ceil((root.cards.length * 1.0) / root.grid-cols) * 134px;

                            init => { root.vault-relayout(grid-body.width / 1px); }
                            changed width => { root.vault-relayout(grid-body.width / 1px); }

                            for card[i] in root.cards : Rectangle {
                                property <length> cw: (parent.width - (root.grid-cols - 1) * 10px) / root.grid-cols;
                                width: cw;
                                height: 124px;
                                // Column: how many whole rows this cell sits past.
                                x: (i - Math.floor(i / root.grid-cols) * root.grid-cols) * (cw + 10px);
                                y: Math.floor(i / root.grid-cols) * 134px;

                                card-face {
                                    card: card;
                                    open => { root.open-editor(card.id); }
                                }
                            }
                        }
                    }

                    // Orbit: the ring. Painted as two passes over the same
                    // cards -- the far half first, the near half over it --
                    // because a repeater paints in model order and the ring's
                    // back would otherwise sit on top of its front. The angle
                    // comes from Rust's timer, which is also what makes the
                    // ring drift while the mouse is anywhere else.
                    if (root.vault-view == "carousel" && root.cards.length > 0) : Rectangle {
                        vertical-stretch: 1;
                        clip: true;

                        for card[i] in root.cards : orbit-card {
                            card: card;
                            angle: root.orbit-angle + i * (360.0 / Math.max(root.cards.length, 1));
                            show: Math.cos((root.orbit-angle + i * (360.0 / Math.max(root.cards.length, 1))) * 1deg) < 0.0;
                            ring-w: parent.width;
                            ring-h: parent.height;
                            open => { root.open-editor(card.id); }
                        }

                        for card[i] in root.cards : orbit-card {
                            card: card;
                            angle: root.orbit-angle + i * (360.0 / Math.max(root.cards.length, 1));
                            show: Math.cos((root.orbit-angle + i * (360.0 / Math.max(root.cards.length, 1))) * 1deg) >= 0.0;
                            ring-w: parent.width;
                            ring-h: parent.height;
                            open => { root.open-editor(card.id); }
                        }
                    }

                    // Undo for the last deletion. Sits in the content column
                    // rather than floating over it, so it cannot cover the card
                    // the user is deciding about -- and it is a row with a
                    // button, not a toast, because the whole point of undo is
                    // that it can still be pressed a second later.
                    if (root.undo-text != "") : Rectangle {
                        height: 48px;
                        vertical-stretch: 0;
                        border-radius: 9px;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 8px;
                            spacing: 10px;

                            Text {
                                text: root.undo-text;
                                color: Theme.text;
                                font-size: 13px;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            Btn {
                                label: "Undo";
                                kind: 1;
                                h: 32px;
                                width: 78px;
                                enabled: !root.busy;
                                clicked => { root.undo-clicked(); }
                            }

                            Btn {
                                label: "Dismiss";
                                kind: 2;
                                h: 32px;
                                width: 84px;
                                clicked => { root.undo-dismissed(); }
                            }
                        }
                    }
                }
            }

            // ---- The sort menu -------------------------------------------
            // Drops under its button and floats over the columns, so the
            // backdrop arrives first: a second press on the button -- or a
            // click anywhere else -- closes the menu again. The panel's rows
            // come from Rust (`sort-options`), the tick from the same
            // comparison the handler validates with. Both hang off the
            // *window* rather than off the shell: a child asking its parent
            // rectangle for the width the layout is about to hand that
            // rectangle is a preferred-size loop, which this app has already
            // been warned about once.
            if (root.sort-menu-open) : TouchArea {
                width: root.width;
                height: root.height;
                z: 30;
                clicked => { root.sort-menu-open = false; }
            }

            if (root.sort-menu-open) : Rectangle {
                // The button sits at the far right of the content column:
                // window minus a hand's width of margin for the panel.
                x: root.width - 252px;
                // Padding + title row + search + the switcher row, with the
                // column's 14px between each -- the menu hangs off the row
                // that owns it.
                y: 180px;
                z: 31;
                width: 228px;
                height: root.sort-options.length * 36px + 16px;
                border-radius: Theme.radius-md;
                background: Theme.bg;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 2px;

                    for opt in root.sort-options : Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: opt.id == root.vault-sort
                            ? Theme.accent-soft
                            : (opt-touch.has-hover ? Theme.row-hover : #00000000);

                        opt-touch := TouchArea {
                            clicked => {
                                root.sort-menu-open = false;
                                root.sort-picked(opt.id);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;

                            Text {
                                text: opt.id == root.vault-sort ? "✓" : "";
                                color: Theme.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: opt.label;
                                color: Theme.text;
                                font-size: 13px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // -- The item editor: a full-height screen, not the centered card -----
        // It gets its own branch rather than joining the unlock-style card
        // because it has its own rail, top bar and footer.
        if (root.screen == Screen.Editor) : Editor {
            vertical-stretch: 1;
            edit-id: root.edit-id;
            title <=> root.edit-title;
            url <=> root.edit-url;
            username <=> root.edit-username;
            password <=> root.edit-password;
            notes <=> root.edit-notes;
            favorite <=> root.edit-favorite;
            needs-attention <=> root.edit-needs-attention;
            reminder-days <=> root.edit-reminder-days;
            reminder-label: root.edit-reminder-label;
            can-delete: root.edit-can-delete;
            reveal-password: root.gen-reveal-editor;
            section: root.editor-section;
            strength-score: root.edit-strength-score;
            strength-label: root.edit-strength-label;
            strength-bits: root.edit-strength-bits;
            strength-crack: root.edit-strength-crack;
            show-generator: root.gen-show;
            gen-revealed <=> root.gen-revealed;
            gen-mode: root.gen-mode;
            gen-length <=> root.gen-length;
            gen-words <=> root.gen-words;
            gen-length-label: root.gen-length-label;
            gen-words-label: root.gen-words-label;
            gen-lower <=> root.gen-lower;
            gen-upper <=> root.gen-upper;
            gen-digits <=> root.gen-digits;
            gen-symbols <=> root.gen-symbols;
            gen-avoid <=> root.gen-avoid;
            generated: root.gen-value;
            gen-mask: root.gen-mask;
            generated-score: root.gen-strength-score;
            generated-label: root.gen-strength-label;
            generated-bits: root.gen-strength-bits;
            generated-crack: root.gen-strength-crack;
            busy: root.busy;
            error-text: root.error-text;
            notice-text: root.notice-text;
            confirm-delete: root.editor-confirm-delete;
            accent-hue <=> root.edit-accent-hue;
            hue-slider <=> root.edit-hue-slider;
            hue-readout: root.edit-hue-readout;
            blur-readout: root.edit-blur-readout;
            preview-from: root.edit-preview-from;
            preview-to: root.edit-preview-to;
            preview-initial: root.edit-preview-initial;
            hue-swatches: root.edit-hue-swatches;
            bg-image <=> root.edit-bg-image;
            bg-blur <=> root.edit-bg-blur;
            avatar-image <=> root.edit-avatar-image;
            show-mail <=> root.edit-show-mail;
            mail-filter: root.edit-mail-filter;
            mail-filter-label: root.edit-mail-filter-label;
            tag-rows: root.edit-tag-rows;
            tag-can-add: root.edit-tag-can-add;
            tag-input <=> root.edit-tag-input;
            pw-date <=> root.edit-pw-date;
            email-date <=> root.edit-email-date;
            pw-date-hint: root.edit-pw-date-hint;
            email-date-hint: root.edit-email-date-hint;
            sec-level: root.edit-sec-level;
            sec-questions-note: root.edit-sec-questions-note;
            sec-totp: root.edit-sec-totp;
            sec-totp-staged: root.edit-sec-totp-staged;
            sec-totp-note: root.edit-sec-totp-note;
            sec-otpauth: root.edit-sec-otpauth;
            qr-size: root.edit-qr-size;
            qr-cells: root.edit-qr-cells;
            sec-passcode: root.edit-sec-passcode;
            sec-passcode-error: root.edit-sec-passcode-error;
            sec-questions: root.edit-sec-questions;
            sec-answer-error: root.edit-sec-answer-error;
            sec-new-prompt: root.edit-sec-new-prompt;
            sec-totp-seed <=> root.edit-sec-totp-seed;
            sec-totp-code <=> root.edit-sec-totp-code;
            sec-passcode-new <=> root.edit-sec-passcode-new;
            sec-passcode-confirm <=> root.edit-sec-passcode-confirm;
            sec-passcode-input <=> root.edit-sec-passcode-input;
            sec-checking-id <=> root.edit-sec-checking-id;
            sec-check-input <=> root.edit-sec-check-input;
            sec-new-answer <=> root.edit-sec-new-answer;

            cancel-clicked => { root.editor-cancel(); }
            save-clicked => { root.editor-save(); }
            delete-asked => { root.editor-delete-asked(); }
            delete-confirmed => { root.editor-delete-confirmed(); }
            confirm-cancelled => { root.editor-confirm-cancelled(); }
            reveal-clicked => { root.editor-reveal(); }
            password-edited => { root.editor-password-edited(); }
            section-selected(id) => { root.editor-section-selected(id); }
            generator-toggled => { root.editor-generator-toggled(); }
            regenerate => { root.editor-regenerate(); }
            gen-mode-picked(i) => { root.editor-gen-mode-picked(i); }
            use-generated => { root.editor-use-generated(); }
            copy-generated => { root.editor-copy-generated(); }
            reminder-picked(i) => { root.editor-reminder-picked(i); }
            hue-picked(hue) => { root.editor-hue-picked(hue); }
            title-edited => { root.editor-title-edited(); }
            bg-blur-changed(value) => { root.editor-bg-blur-changed(value); }
            mail-filter-picked(i) => { root.editor-mail-filter-picked(i); }
            tag-add => { root.editor-tag-add(); }
            tag-toggle(id) => { root.editor-tag-toggle(id); }
            tag-relayout(width) => { root.editor-tag-relayout(width); }
            tag-input-edited => { root.editor-tag-input-edited(); }
            date-edited(which) => { root.editor-date-edited(which); }
            sec-totp-attach => { root.editor-sec-totp-attach(); }
            sec-totp-generate => { root.editor-sec-totp-generate(); }
            sec-totp-check => { root.editor-sec-totp-check(); }
            sec-totp-discard => { root.editor-sec-totp-discard(); }
            sec-totp-remove => { root.editor-sec-totp-remove(); }
            sec-passcode-save => { root.editor-sec-passcode-save(); }
            sec-passcode-check => { root.editor-sec-passcode-check(); }
            sec-passcode-remove => { root.editor-sec-passcode-remove(); }
            sec-question-add => { root.editor-sec-question-add(); }
            sec-question-check(id) => { root.editor-sec-question-check(id); }
            sec-question-remove(id) => { root.editor-sec-question-remove(id); }
            sec-prompt-step(delta) => { root.editor-sec-prompt-step(delta); }
        }

        // -- Everything else: the centered card -------------------------------
        if (root.screen != Screen.Vault && root.screen != Screen.Editor) : Rectangle {
            vertical-stretch: 1;

            card := Rectangle {
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                width: 440px;
                height: inner.preferred-height;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.card;

                inner := VerticalLayout {
                    padding-top: 34px;
                    padding-bottom: 30px;
                    padding-left: 34px;
                    padding-right: 34px;
                    spacing: 14px;
                    property <string> title: root.screen == Screen.CreateChoose
                        ? "Set up your vault"
                        : root.screen == Screen.CreatePassword
                            ? "Add a vault password"
                            : root.screen == Screen.CreateConfirm
                                ? "Confirm your vault password"
                                : root.screen == Screen.ImportPassword
                                    ? "This backup is protected"
                                    : root.screen == Screen.Error
                                        ? "Something went wrong"
                                        : "Welcome back";

                    property <string> hint: root.screen == Screen.Error
                        ? root.error-text
                        : root.screen == Screen.CreateChoose
                            ? "Colax encrypts your logins on this device. Choose how this vault is protected - you can change it later in Settings."
                            : root.screen == Screen.CreatePassword
                                ? "This password encrypts your vault. It is never stored and cannot be recovered if you forget it."
                                : root.screen == Screen.CreateConfirm
                                    ? "Type the same password once more to confirm it."
                                    : root.screen == Screen.ImportPassword
                                        ? "Enter the password this backup was exported with to unlock and import it."
                                        : root.screen == Screen.UnlockDevice
                                            ? "This vault has no password, so it opens straight away."
                                            : "Enter your vault password to decrypt it.";

                    // Brand block: the same lock mark the lite lock screen wears.
                    HorizontalLayout {
                        spacing: 16px;

                        Rectangle {
                            width: 54px;
                            height: 54px;
                            border-radius: 14px;
                            background: @linear-gradient(120deg, Theme.grad-from, Theme.grad-to);

                            Rectangle {
                                x: (parent.width - 20px) / 2;
                                y: 11px;
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                border-width: 3.5px;
                                border-color: #ffffff;
                                background: #00000000;
                            }

                            Rectangle {
                                x: (parent.width - 26px) / 2;
                                y: 23px;
                                width: 26px;
                                height: 17px;
                                border-radius: 5px;
                                background: #ffffff;
                            }
                        }

                        VerticalLayout {
                            spacing: 5px;

                            Text {
                                text: inner.title;
                                color: Theme.text;
                                font-size: 21px;
                                font-weight: 700;
                            }

                            Text {
                                text: inner.hint;
                                color: Theme.muted;
                                font-size: 13.5px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // `persistent` in the TS frame: the browser warning, in
                    // this app's own terms. Storage is a file on disk rather
                    // than a quota, so the failure that ends the same way is
                    // a data folder that refuses a write.
                    if (!root.storage-persistent) : Alert {
                        warn: true;
                        message: "This device's storage is not writable, so anything saved here will be lost when Colax closes. Private or restricted sessions sometimes cause this.";
                    }

                    // On the error screen the message *is* the hint, so the
                    // strip would only repeat it.
                    if (root.error-text != "" && root.screen != Screen.Error) : Alert {
                        message: root.error-text;
                    }

                    if (root.notice-text != "") : Alert {
                        message: root.notice-text;
                        good: true;
                    }

                    if (root.screen == Screen.CreateChoose) : VerticalLayout {
                        spacing: 10px;

                        Btn {
                            label: root.busy ? "Working..." : "Continue without a password";
                            kind: 0;
                            enabled: !root.busy;
                            clicked => { root.create-no-password(); }
                        }

                        Btn {
                            label: "Add a vault password";
                            kind: 1;
                            enabled: !root.busy;
                            clicked => { root.create-with-password(); }
                        }

                        Btn {
                            label: "Import a backup";
                            kind: 1;
                            enabled: !root.busy;
                            clicked => { root.create-import(); }
                        }

                        Text {
                            text: "A device vault opens for anyone who can use this computer.";
                            color: Theme.faint;
                            font-size: 12.5px;
                            wrap: word-wrap;
                        }
                    }

                    if (root.screen == Screen.CreatePassword) : VerticalLayout {
                        spacing: 10px;

                        Text {
                            text: "Vault password";
                            color: Theme.muted;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        Field {
                            placeholder: "Enter a new vault password";
                            password: true;
                            enabled: !root.busy;
                            value <=> root.password-value;
                            edited => { root.password-edited(); }
                            accepted => { root.password-next(); }
                        }

                        // The meter the lite app shows while typing (L218-222):
                        // create only, never on unlock, where there is nothing
                        // left to judge. It replaces the old count floor --
                        // the refusal below is the estimate's, not a
                        // character's, and this is what explains it.
                        StrengthMeter {
                            score: root.lock-strength-score;
                            label: root.lock-strength-label;
                            bits: root.lock-strength-bits;
                            crack-time: root.lock-strength-crack;
                        }

                        Btn {
                            label: root.busy ? "Working..." : "Continue";
                            kind: 0;
                            // TS disables submit until the field has
                            // something in it (L227); Enter is not so
                            // polite, and gets the refusal instead.
                            enabled: !root.busy && root.password-value != "";
                            clicked => { root.password-next(); }
                        }

                        // L234-239: the suggestion fills both fields and lands
                        // on confirm. Offered only while the password is being
                        // chosen -- confirming it is not the time to change it.
                        Btn {
                            label: "Suggest a strong vault password";
                            kind: 2;
                            enabled: !root.busy;
                            clicked => { root.suggest-password(); }
                        }

                        Btn {
                            label: "Back";
                            kind: 2;
                            enabled: !root.busy;
                            clicked => { root.create-back(); }
                        }
                    }

                    if (root.screen == Screen.CreateConfirm) : VerticalLayout {
                        spacing: 10px;

                        Text {
                            text: "Confirm password";
                            color: Theme.muted;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        Field {
                            placeholder: "Type the same password again";
                            password: true;
                            enabled: !root.busy;
                            value <=> root.confirm-value;
                            accepted => { root.create-submit(); }
                        }

                        Btn {
                            label: root.busy ? "Working..." : "Create vault";
                            kind: 0;
                            // As the Continue button above: no password typed,
                            // no button to press.
                            enabled: !root.busy && root.confirm-value != "";
                            clicked => { root.create-submit(); }
                        }

                        Btn {
                            label: "Back";
                            kind: 2;
                            enabled: !root.busy;
                            clicked => { root.create-back(); }
                        }
                    }

                    if (root.screen == Screen.UnlockPassword) : VerticalLayout {
                        spacing: 10px;

                        Text {
                            text: "Vault password";
                            color: Theme.muted;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        Field {
                            placeholder: "Vault password";
                            password: true;
                            enabled: !root.busy;
                            value <=> root.password-value;
                            accepted => { root.unlock-submit(); }
                        }

                        Btn {
                            label: root.busy ? "Decrypting..." : "Unlock";
                            kind: 0;
                            enabled: !root.busy;
                            clicked => { root.unlock-submit(); }
                        }
                    }

                    if (root.screen == Screen.UnlockDevice) : VerticalLayout {
                        spacing: 10px;

                        Btn {
                            label: root.busy ? "Opening..." : "Open vault";
                            kind: 0;
                            enabled: !root.busy;
                            clicked => { root.open-device(); }
                        }

                        Text {
                            text: "Anyone with access to this device can open the vault. You can add a password later in Settings.";
                            color: Theme.faint;
                            font-size: 12.5px;
                            wrap: word-wrap;
                        }
                    }

                    if (root.screen == Screen.ImportPassword) : VerticalLayout {
                        spacing: 10px;

                        Text {
                            text: "Backup password";
                            color: Theme.muted;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        Field {
                            placeholder: "Password this backup was exported with";
                            password: true;
                            enabled: !root.busy;
                            value <=> root.password-value;
                            accepted => { root.import-submit(); }
                        }

                        Btn {
                            label: root.busy ? "Importing..." : "Import";
                            kind: 0;
                            enabled: !root.busy;
                            clicked => { root.import-submit(); }
                        }

                        Btn {
                            label: "Back";
                            kind: 2;
                            enabled: !root.busy;
                            clicked => { root.import-back(); }
                        }
                    }

                    if (root.screen == Screen.Error) : VerticalLayout {
                        spacing: 10px;

                        Btn {
                            label: "Quit";
                            kind: 1;
                            clicked => { root.quit-app(); }
                        }
                    }
                }

                // The Sun/Moon in the frame's corner (LockScreen.tsx L286-294):
                // absolute in the TS original, so a sibling of the layout here
                // that takes its place by hand -- a layout child would be
                // placed, and this has to float over the brand block's corner.
                // Sun is offered when dark is showing, exactly as in TS.
                Rectangle {
                    x: parent.width - 48px;
                    y: 14px;
                    width: 34px;
                    height: 34px;
                    border-radius: 9px;
                    background: theme-touch.has-hover ? #ffffff14 : #00000000;

                    Text {
                        text: Theme.resolved-theme == "dark" ? "☀" : "☾";
                        color: Theme.muted;
                        font-size: 15px;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    theme-touch := TouchArea {
                        clicked => { root.toggle-theme(); }
                    }
                }
            }
        }

    } // VerticalLayout

        // -- The SecurityGate ------------------------------------------------
        // One panel, whichever flow opened it: the vault's own factor the
        // moment it is unlocked, a secured login before its editor opens, the
        // reveal behind its second factor. A later sibling of the layout
        // above, so it draws over every screen in it, with a backdrop that
        // keeps the shell inert while it is up.
        if (root.gate-open) : SecurityGate {
            z: 50;
            title: root.gate-title;
            hint: root.gate-hint;
            has-passcode: root.gate-has-passcode;
            has-totp: root.gate-has-totp;
            has-questions: root.gate-has-questions;
            questions: root.gate-questions;
            error: root.gate-error;
            unlock(mode, value, question-id) => {
                root.gate-unlock(mode, value, question-id);
            }
            cancel => { root.gate-cancel(); }
        }

        // -- The Settings window (Phase 5) ----------------------------------
        // The topmost sheet: mounted while `settings-open` holds, `z` past
        // the gate's so a modal opened from anywhere lands above everything,
        // and dead while closed along with its FocusScope and key handling.
        if (root.settings-open) : Settings {
            z: 61;
            tab-index: root.settings-tab-index;
            frame-w: root.settings-w;
            frame-h: root.settings-h;
            panel-w: root.settings-panel-w;
            accent-chips: root.settings-accent-chips;
            ap-theme <=> root.settings-ap-theme;
            ap-accent <=> root.settings-ap-accent;
            ap-motion <=> root.settings-ap-motion;
            ap-motion-speed <=> root.settings-ap-motion-speed;
            ap-ambient <=> root.settings-ap-ambient;
            ap-text-scale <=> root.settings-ap-text-scale;
            ap-roundness <=> root.settings-ap-roundness;
            ap-card-depth <=> root.settings-ap-card-depth;
            ap-density <=> root.settings-ap-density;
            ap-reduce-transparency <=> root.settings-ap-reduce-transparency;
            ap-high-contrast <=> root.settings-ap-high-contrast;
            lay-view <=> root.settings-lay-view;
            lay-sort <=> root.settings-lay-sort;
            lay-sidebar-labels <=> root.settings-lay-sidebar-labels;
            lay-rail-position <=> root.settings-lay-rail-position;
            lay-letter-groups <=> root.settings-lay-letter-groups;
            lay-auto-tag-domain <=> root.settings-lay-auto-tag-domain;
            lay-unassigned-channel <=> root.settings-lay-unassigned-channel;
            lay-auto-tag-channel <=> root.settings-lay-auto-tag-channel;
            lay-orbit-labels <=> root.settings-lay-orbit-labels;
            lay-health-badges <=> root.settings-lay-health-badges;
            lay-shortcuts <=> root.settings-lay-shortcuts;
            lay-lock-button <=> root.settings-lay-lock-button;
            lay-new-channel-button <=> root.settings-lay-new-channel-button;
            lay-compact-button <=> root.settings-lay-compact-button;
            lay-new-login-button <=> root.settings-lay-new-login-button;
            lay-bulk-add-button <=> root.settings-lay-bulk-add-button;
            lay-settings-button <=> root.settings-lay-settings-button;
            lay-hide-sidebar-button <=> root.settings-lay-hide-sidebar-button;
            lay-show-sidebar <=> root.settings-lay-show-sidebar;
            lay-show-urls <=> root.settings-lay-show-urls;
            lay-pin-favorites <=> root.settings-lay-pin-favorites;
            lay-floating-chrome <=> root.settings-lay-floating-chrome;
            lay-hide-dividers <=> root.settings-lay-hide-dividers;
            hidden-rows: root.settings-hidden-rows;
            closed => { root.settings-closed(); }
            tab-picked(index) => { root.settings-tab-picked(index); }
            pref-string(key, value) => { root.settings-pref-string(key, value); }
            pref-float(key, value) => { root.settings-pref-float(key, value); }
            pref-bool(key, value) => { root.settings-pref-bool(key, value); }
            hidden-restore(key, id) => { root.settings-hidden-restore(key, id); }
            hidden-restore-all => { root.settings-hidden-restore-all(); }
        }
    }
}

// The tray is its own top-level component: Slint's SystemTrayIcon has no
// window, and a visible one is what keeps the event loop alive while the
// main window is hidden to it. Menu entries mirror the Tauri shell's four
// items one for one; the activated callbacks reach Rust through generated
// accessors instead of an IPC channel.
export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../assets/icon.png");
    tooltip: "Colax Lite";

    // Locked until a vault exists: a "Lock now" that does nothing is worse
    // than a grey one, and there is nothing to lock before first run.
    in property <bool> lock-enabled: false;

    callback show-requested();
    callback lock-requested();
    callback mute-requested();
    callback quit-requested();
    // The builtin `clicked` callback has no generated Rust accessor on a
    // top-level component, so forward it through one of ours.
    callback icon-clicked();
    clicked => { icon-clicked(); }

    Menu {
        MenuItem {
            title: "Show Colax";
            activated => { show-requested(); }
        }
        MenuItem {
            title: "Lock now";
            enabled: root.lock-enabled;
            activated => { lock-requested(); }
        }
        MenuItem {
            title: "Mute";
            // Sounds arrive in a later phase.
            enabled: false;
            activated => { mute-requested(); }
        }
        MenuItem {
            title: "Quit";
            activated => { quit-requested(); }
        }
    }
}
