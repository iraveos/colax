    in-out property <float> settings-gen-length: 20;
    in-out property <string> settings-gen-length-label;
    in-out property <bool> settings-gen-lower: true;
    in-out property <bool> settings-gen-upper: true;
    in-out property <bool> settings-gen-digits: true;
    in-out property <bool> settings-gen-symbols: true;
    in-out property <bool> settings-gen-avoid: true;
    // ---- The Settings window's Alarms tab (Task 5.5) ---------------------
