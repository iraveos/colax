    in property <[OptProfileRow]> settings-opt-profiles;
    in-out property <bool> settings-opt-can-save: true;
    in-out property <string> settings-opt-name: "";
    in-out property <string> settings-opt-renamer: "";
    in-out property <string> settings-opt-rename: "";
