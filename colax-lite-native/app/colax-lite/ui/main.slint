    // models; the imported sound's name and the card's own Label and Time
    // fields ride as strings. `settings-alarm-time` opens at 08:00, the
    // hour the TS's `useState('08:00')` starts on.
    in property <[AlarmRow]> settings-alarm-rows: [];
    in property <[DayChip]> settings-alarm-day-chips: [];
    in-out property <string> settings-alarm-sound;
    in-out property <string> settings-alarm-label;
    in-out property <string> settings-alarm-time: "08:00";
    // ---- The Settings window's Security tab (Task 5.7) -------------------
    // Fourteen simple rows (five pickers, nine switches) land here through the
    // `pref-*` callbacks; the vault's own second factor is a `SecurityForm`
    // instance bound to `prefs.vaultSecurity`, whose props and twelve
    // actions cross this boundary one for one.
    in-out property <int> settings-sec-group: 0;
    in-out property <string> settings-sec-auto-lock: "5";
    in-out property <string> settings-sec-clipboard: "30";
    in-out property <string> settings-sec-pw-age: "180";
    in-out property <string> settings-sec-email-age: "365";
    in-out property <string> settings-sec-email-check: "90";
    in-out property <bool> settings-sec-clear-on-lock: true;
    in-out property <bool> settings-sec-clip-capture: false;
    in-out property <bool> settings-sec-clip-autosave: false;
    in-out property <bool> settings-sec-warn-reuse: true;
    in-out property <bool> settings-sec-tag-reused: true;
    in-out property <bool> settings-sec-mask-emails: true;
    in-out property <bool> settings-sec-confirm-export: false;
    in-out property <bool> settings-sec-confirm-deletes: true;
    in-out property <bool> settings-sec-copy-toasts: true;
    in property <string> settings-sec-kdf;
    in property <string> settings-vsec-level: "none";
    in property <string> settings-vsec-questions-note: "Not set";
    in property <bool> settings-vsec-totp: false;
    in property <string> settings-vsec-otpauth;
    in property <int> settings-vsec-qr-size: 0;
    in property <[QrCell]> settings-vsec-qr-cells;
    in property <bool> settings-vsec-totp-staged: false;
    in property <string> settings-vsec-totp-note;
    in-out property <string> settings-vsec-totp-seed;
    in-out property <string> settings-vsec-totp-code;
    in property <bool> settings-vsec-passcode: false;
    in-out property <string> settings-vsec-passcode-new;
    in-out property <string> settings-vsec-passcode-confirm;
    in-out property <string> settings-vsec-passcode-input;
    in property <string> settings-vsec-passcode-error;
    in property <[QuestionRow]> settings-vsec-questions;
    in property <string> settings-vsec-answer-error;
    in-out property <string> settings-vsec-checking-id;
    in-out property <string> settings-vsec-check-input;
    in property <string> settings-vsec-new-prompt;
    in-out property <string> settings-vsec-new-answer;
    // ---- The Settings window's Data and Backup tabs (Task 5.8) ------------
    // The chips' text and the sheets' state. The fields a sheet owns are
    // in-out so a keystroke reaches Rust and Rust's answer (the password
    // score gates Export) comes back down the same chain.
    in property <string> settings-data-stored;
    in property <string> settings-data-version;
    in property <int> settings-data-count: 0;
    in property <bool> settings-data-protect-open: false;
    in-out property <string> settings-data-export-password;
    in property <int> settings-data-export-score: 0;
    in property <bool> settings-data-reset-open: false;
    in property <string> settings-data-reset-message;
    in property <string> settings-data-restore-name;
    in property <string> settings-data-restore-message;
    in property <string> settings-data-restore-error;
    in-out property <string> settings-data-restore-password;
    in-out property <bool> settings-data-restore-passwordless: false;
    in-out property <bool> settings-data-restore-rekey: false;
    in-out property <string> settings-data-restore-next;
    in property <bool> settings-data-restore-busy: false;
    in property <bool> settings-data-restore-ready: false;
    in property <string> settings-backup-hint;
    // Native-only: whether an export carries the app's settings too (Task
    // 5.10+). Bound to the Backup tab's switch.
    in-out property <bool> settings-backup-with-settings: true;
    // ---- The Settings window's Optimize tab (Task 5.11) -------------------
    // Same shape as the Backup block: pushed readings in, edits out. The
    // counter, the locked rows and the profile rows are derived from the
    // document on every refresh.
    in-out property <int> settings-opt-group: 0;
    in property <int> settings-opt-count-on: 0;
    in property <bool> settings-opt-snapshotted: false;
    in-out property <string> settings-opt-active-profile: "";
    in-out property <bool> settings-opt-motion-off: false;
    in-out property <bool> settings-opt-micro: true;
    in-out property <bool> settings-opt-ambient-off: false;
    in-out property <bool> settings-opt-transparency: false;
    in property <bool> settings-opt-compact: false;
    in-out property <bool> settings-opt-flat: false;
    in-out property <bool> settings-opt-no-picture: true;
    in-out property <bool> settings-opt-mail-on: true;
    in-out property <bool> settings-opt-mail-locked: false;
