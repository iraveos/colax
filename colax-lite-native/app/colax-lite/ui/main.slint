            data-restore-submit => { root.settings-data-restore-submit(); }
            bg-url-edited => { root.settings-bg-url-edited(); }
            bg-upload => { root.settings-bg-upload(); }
            bg-remove => { root.settings-bg-remove(); }
            chan-edit(id) => { root.settings-chan-edit(id); }
            chan-toggle-hidden(id) => { root.settings-chan-toggle-hidden(id); }
            chan-hide-all => { root.settings-chan-hide-all(); }
            chan-show-all => { root.settings-chan-show-all(); }
            chan-tag-edited => { root.settings-chan-tag-edited(); }
            chan-tag-add => { root.settings-chan-tag-add(); }
            chan-tag-rename-start(id) => { root.settings-chan-tag-rename-start(id); }
            chan-tag-renamed(id, name) => { root.settings-chan-tag-renamed(id, name); }
            chan-tag-rename-done(id) => { root.settings-chan-tag-rename-done(id); }
            chan-tag-hue-toggle(id) => { root.settings-chan-tag-hue-toggle(id); }
