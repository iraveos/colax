            chan-tag-delete(id) => { root.settings-chan-tag-delete(id); }
        }

        // The shared channel editor (Task 5.10), over everything including
        // Settings: the Channels panel opens it, and so will the rail.
        if (root.channel-ed-open) : ChannelEditor {
            z: 62;
            title: root.channel-ed-title;
            is-new: root.channel-ed-is-new;
            can-delete: root.channel-ed-can-delete;
            can-save: root.channel-ed-can-save;
            name <=> root.channel-ed-name;
            error: root.channel-ed-error;
            dot-color: root.channel-ed-dot;
            preview-name: root.channel-ed-preview-name;
            preview-count: root.channel-ed-count;
            kind-index: root.channel-ed-kind-index;
            kind-options: root.channel-ed-kind-options;
            kind-hint: root.channel-ed-kind-hint;
            tag-rows: root.channel-ed-tag-rows;
            has-tags: root.channel-ed-has-tags;
            tag-hint: root.channel-ed-tag-hint;
            icons: root.channel-ed-icons;
            icon-key: root.channel-ed-icon;
            hue-value <=> root.channel-ed-hue;
            hue-label: root.channel-ed-hue-label;
            accent-chips: root.channel-ed-accents;
            accent: root.channel-ed-accent;
            image-url <=> root.channel-ed-image-url;
            has-image: root.channel-ed-has-image;
            image-opacity <=> root.channel-ed-image-opacity;
            image-blur <=> root.channel-ed-image-blur;
            image-dim <=> root.channel-ed-image-dim;
            show-mail <=> root.channel-ed-show-mail;
            has-accounts: root.channel-ed-has-accounts;
            account-labels: root.channel-ed-account-labels;
            account-ids: root.channel-ed-account-ids;
            mail-account: root.channel-ed-mail-account;
            scroll-y <=> root.channel-ed-scroll-y;
            closed => { root.channel-ed-closed(); }
            save => { root.channel-ed-save(); }
            deleted => { root.channel-ed-deleted(); }
            name-edited => { root.channel-ed-name-edited(); }
            kind-picked(index) => { root.channel-ed-kind-picked(index); }
            tag-toggled(id) => { root.channel-ed-tag-toggled(id); }
            tag-relayout(width) => { root.channel-ed-tag-relayout(width); }
            icon-picked(key) => { root.channel-ed-icon-picked(key); }
            hue-changed(value) => { root.channel-ed-hue-changed(value); }
            accent-picked(id) => { root.channel-ed-accent-picked(id); }
            image-edited => { root.channel-ed-image-edited(); }
            image-upload => { root.channel-ed-image-upload(); }
            image-remove => { root.channel-ed-image-remove(); }
            image-float(key, value) => { root.channel-ed-image-float(key, value); }
            show-mail-toggled(value) => { root.channel-ed-show-mail-toggled(value); }
            mail-account-picked(id) => { root.channel-ed-mail-account-picked(id); }
        }

        // The appearance tuner (Task 8.4): a translucent slide-over, *not* a
        // modal -- the cards stay visible down the left so a drag can be
        // judged as it happens. Mounted above the shell but below the sheet,
        // which is the one overlay that outranks it.
        if (root.show-tuner) : AppearanceTuner {
            z: 60;
            view: root.tuner-view;
            view-label: root.tuner-view-label;
            orbit: root.tuner-orbit;
            scale <=> root.tuner-scale;
            width-value <=> root.tuner-width;
            min-height-value <=> root.tuner-min-height;
            aspect-value <=> root.tuner-aspect;
            radius-value <=> root.tuner-radius;
            accent: root.tuner-accent;
            accents: root.tuner-accents;
            size-changed(field, value) => { root.tuner-size-changed(field, value); }
            accent-picked(id) => { root.tuner-accent-picked(id); }
            reset => { root.tuner-reset(); }
            closed => { root.tuner-closed(); }
        }

        // The shortcuts sheet (Task 8.2), the last overlay so `?` can be
        // answered from anywhere: Escape closes it through the window's key
        // scope below it.
        if (root.show-shortcuts) : ShortcutsSheet {
            z: 70;
            rows: root.shortcut-rows;
            closed => { root.shortcuts-closed(); }
        }
    }

    // Re-arm the global key scope after anything that took focus away from it.
    // Switching to the vault lands the scope (a locked screen's password field
    // autofocuses instead, and must keep it -- hence the `Screen.Vault` test);
    // a menu, gate, Settings or the channel editor closing destroys the
    // FocusScope that had focus a moment ago, leaving the window with no
    // focused item, which would drop every later key on the floor.
    changed screen => { if (root.screen == Screen.Vault) { shortcut-scope.focus(); } }
    changed menu-open => { if (!root.menu-open) { shortcut-scope.focus(); } }
    changed settings-open => { if (!root.settings-open) { shortcut-scope.focus(); } }
    changed gate-open => { if (!root.gate-open) { shortcut-scope.focus(); } }
    changed channel-ed-open => { if (!root.channel-ed-open) { shortcut-scope.focus(); } }
    changed show-shortcuts => { if (!root.show-shortcuts) { shortcut-scope.focus(); } }
    changed show-tuner => { if (!root.show-tuner) { shortcut-scope.focus(); } }
}

// The tray is its own top-level component: Slint's SystemTrayIcon has no
// window, and a visible one is what keeps the event loop alive while the
// main window is hidden to it. Menu entries mirror the Tauri shell's four
// items one for one; the activated callbacks reach Rust through generated
// accessors instead of an IPC channel.
export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../assets/icon.png");
    // The muted state is in the tooltip as well as the menu title
    // (main.ts L454) -- the menu is a click away, the tooltip a hover.
    tooltip: root.muted ? "Colax Lite (muted)" : "Colax Lite";

    // Locked until a vault exists: a "Lock now" that does nothing is worse
    // than a grey one, and there is nothing to lock before first run.
    in property <bool> lock-enabled: false;
    // Sounds are Rust's (`alarms.rs` rings through rodio), so the item is live
    // and its title is the current state, not a command (main.ts L433).
    in property <bool> muted: false;

    callback show-requested();
    callback lock-requested();
    callback mute-requested();
    callback restart-requested();
    callback quit-requested();
    // The builtin `clicked` callback has no generated Rust accessor on a
    // top-level component, so forward it through one of ours.
    callback icon-clicked();
    clicked => { icon-clicked(); }

    Menu {
        MenuItem {
            title: "Show Colax";
            activated => { show-requested(); }
        }
        MenuItem {
            title: "Lock vault now";
            enabled: root.lock-enabled;
            activated => { lock-requested(); }
        }
        MenuItem {
            title: root.muted ? "Unmute sounds" : "Mute sounds";
            activated => { mute-requested(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Restart";
            activated => { restart-requested(); }
        }
        MenuItem {
            title: "Quit Colax";
            activated => { quit-requested(); }
        }
    }
}
