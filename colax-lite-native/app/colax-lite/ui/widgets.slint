// Reusable components. Styled from Theme only so the look stays theme-free.
import { Theme } from "theme.slint";

// A button shaped like the lite app's: accent-filled for the main action,
// outlined for alternatives, text-only for Back. Self-contained (TouchArea on
// top) so it works anywhere without std-widgets' styling.
export component Btn inherits Rectangle {
    in property <string> label;
    // 0 = primary, 1 = secondary (outline), 2 = ghost (text only),
    // 3 = danger -- the TS's `.btn--danger` (soft fill, solid on hover).
    in property <int> kind;
    in property <bool> enabled: true;
    in property <length> h: 40px;
    callback clicked();

    height: root.h;
    border-radius: 10px;
    border-width: root.kind == 1 ? 1px : 0px;
    // `.btn` transitions background, border, colour and shadow over `--fast`
    // (app.css L631) -- and it is one of the selectors in the micro block
    // (L1682), so a disabled micro switch makes it instant again.
    animate background { duration: Theme.fast; }
    animate border-color { duration: Theme.fast; }

    background: !root.enabled
        ? #ffffff08
        : root.kind == 0
            ? (touch.pressed ? Theme.accent-press : touch.has-hover ? Theme.accent-strong : Theme.accent)
            : root.kind == 1
                ? (touch.pressed ? #ffffff0d : touch.has-hover ? #ffffff1f : #ffffff14)
                : root.kind == 3
                    ? (touch.pressed ? Theme.danger : touch.has-hover ? Theme.danger : Theme.danger-soft)
                    : (touch.pressed ? #ffffff0d : touch.has-hover ? #ffffff14 : #00000000);
    border-color: root.kind == 1
        ? (root.enabled ? Theme.border-strong : #ffffff12)
        : #00000000;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        alignment: center;

        Text {
            text: root.label;
            color: !root.enabled
                ? Theme.faint
                : root.kind == 3
                    ? (touch.pressed || touch.has-hover ? #ffffff : Theme.danger)
                    : root.kind == 0
                        ? #10182a
                        : root.kind == 2
                            ? Theme.muted
                            : Theme.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            animate color { duration: Theme.fast; }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A text field with lite-app chrome: dark inset, accent focus ring,
// placeholder, optional password masking. `init` focuses it the moment it is
// created, so each stage's field is live without the window having to know
// element ids.
export component Field inherits Rectangle {
    in-out property <string> value;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> enabled: true;
    // Take focus the moment this field is built. On by default because every
    // one of these screens has exactly one field and should land on it. A
    // screen with *several* fields switches it off everywhere but the first:
    // `init` fires per element, so all of them would fight and the last one
    // in the layout order would win.
    in property <bool> autofocus: true;
    // Asked to take focus after the fact -- the `/` shortcut (Task 8.2). A
    // Field is a Rectangle, so it has no `focus()` of its own to call from
    // outside; the caller bumps this number and the field focuses its own
    // TextInput. Only ever fired by a change, so building a field does not
    // steal focus through it (that is `autofocus`'s job).
    in property <int> focus-tick: 0;
    callback accepted();
    callback edited();

    height: 44px;
    border-radius: 10px;
    border-width: 1px;
    border-color: !root.enabled
        ? #ffffff10
        : input.has-focus
            ? Theme.accent
            : Theme.border;
    background: !root.enabled
        ? #ffffff08
        : input.has-focus
            ? Theme.field-focus
            : Theme.field;
    // `.input` / `.search__input`: border and background over `--fast`
    // (app.css L666, L164), which is what makes the focus ring arrive
    // instead of appear.
    animate border-color { duration: Theme.fast; }
    animate background { duration: Theme.fast; }
    clip: true;

    init => { if (root.autofocus) { input.focus(); } }
    changed focus-tick => { input.focus(); }

    Text {
        visible: root.value == "" && !input.has-focus;
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.faint;
        font-size: 14px;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 14px;
        y: 0;
        width: parent.width;
        height: parent.height;
        text <=> root.value;
        input-type: root.password ? InputType.password : InputType.text;
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
        selection-background-color: Theme.accent-soft;
        selection-foreground-color: #0d1420;
        enabled: root.enabled;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
        // Keep the caret inside the field: the TextInput does not scroll
        // itself, so nudge x when the cursor walks past either edge.
        //
        // The width guard is load-bearing. This fires while the field is
        // still being laid out, and with a zero width the right-edge branch
        // computes a large negative x, hides every character behind the clip,
        // and -- because writing x destroys its `14px` binding -- never
        // recovers.
        cursor-position-changed(position) => {
            if (root.width > 40px) {
                if (position.x + self.x < 14px) {
                    self.x = 14px - position.x;
                } else if (position.x + self.x > root.width - 14px - self.text-cursor-width) {
                    self.x = root.width - 14px - self.text-cursor-width - position.x;
                }
            }
        }
    }
}

// The red/green message strip. Lives in both branches of the screen switch
// so errors are visible on the vault screen too (clipboard failures, ...).
export component Alert inherits Rectangle {
    in property <string> message;
    in property <bool> good: false;
    // The amber one: worth reading, not a failure -- storage that will not
    // outlive the process, a clipboard the OS refused (LockScreen.tsx's
    // `tone="warn"`).
    in property <bool> warn: false;
    // The neutral one: `.alert--info` (app.css L681) -- a glass fill on the
    // plain border with muted text. The "Protect this backup" explainer
    // wears it.
    in property <bool> info: false;

    border-radius: 9px;
    border-width: 1px;
    background: root.good ? Theme.good-soft : root.warn ? Theme.warn-soft : root.info ? Theme.glass : Theme.danger-soft;
    border-color: root.good ? #7dd3a055 : root.warn ? #e6b87855 : root.info ? Theme.border : #e07b8055;

    VerticalLayout {
        padding-top: 9px;
        padding-bottom: 9px;
        padding-left: 14px;
        padding-right: 14px;

        Text {
            text: root.message;
            color: root.good ? #9fe3bd : root.warn ? #f2dcac : root.info ? Theme.muted : #f0a5a8;
            font-size: 13px;
            wrap: word-wrap;
        }
    }
}

// ---- Phase 0 additions: the Colax widget vocabulary ---------------------

// Toggle switch.
export component Toggle inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();

    height: root.hint == "" ? 28px : 46px;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if root.enabled {
                root.checked = !root.checked;
                root.toggled();
            }
        }
    }
    VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Rectangle { horizontal-stretch: 1;
                Text {
                    // Full size, or the same rule as `Label` applies and the
                    // caption is centred in whatever room the row left it.
                    width: parent.width;
                    height: parent.height;
                    text: root.label; color: root.enabled ? Theme.text : Theme.faint; font-size: 14px;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                width: 44px;
                height: 24px;
                border-radius: 12px;
                background: root.checked
                    ? (touch.has-hover ? Theme.accent-strong : Theme.accent)
                    : (touch.has-hover ? #ffffff1f : #ffffff14);
                // `.toggle` and its knob: background and translate over
                // `--normal` (app.css L748-749).
                animate background { duration: Theme.normal; }
                Rectangle {
                    x: root.checked ? parent.width - 22px : 2px;
                    y: 2px;
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: root.checked ? #10182a : Theme.muted;
                    animate x { duration: Theme.normal; easing: ease-out; }
                }
            }
        }
        if root.hint != "" : Text {
            text: root.hint; color: Theme.faint; font-size: 12px;
            wrap: word-wrap; width: parent.width;
        }
    }
}

export component Checkbox inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();

    height: 24px;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if root.enabled {
                root.checked = !root.checked;
                root.toggled();
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        width: parent.width;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : Theme.border-strong;
            background: root.checked ? Theme.accent-soft : #00000000;
            if root.checked : Text {
                text: "✓"; color: Theme.accent;
                font-size: 12px; font-weight: 700;
                width: parent.width; height: parent.height;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        Text { text: root.label; color: Theme.text; font-size: 14px;
               vertical-alignment: center; }
    }
}

export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in-out property <float> value;
    in property <string> label;
    in property <string> formatted: "";
    callback changed(float);

    height: 44px;
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            if root.label != "" : Text { text: root.label; color: Theme.muted; font-size: 13px;
                                         vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.formatted != "" : Text { text: root.formatted; color: Theme.faint; font-size: 12px;
                                             vertical-alignment: center; }
        }
        track := Rectangle {
            height: 18px;
            touch := TouchArea {
                moved => {
                    let v0 = root.minimum + (touch.mouse-x / self.width) * (root.maximum - root.minimum);
                    let v1 = v0 < root.minimum ? root.minimum : v0;
                    let v2 = v1 > root.maximum ? root.maximum : v1;
                    root.value = v2;
                    root.changed(v2);
                }
            }
            Rectangle {
                // track bg
                y: 7px; height: 4px;
                border-radius: 2px;
                background: Theme.field;
            }
            Rectangle {
                // fill
                //
                // `x` looks redundant -- it is the origin already -- but it is
                // not: an element inside a `Rectangle` that sets its *width*
                // and leaves `x` alone is centred rather than pinned to the
                // left, so the fill used to render at (track - width) / 2
                // while the thumb above it was drawn from the same fraction.
                x: 0px;
                y: 7px; height: 4px;
                width: (root.value - root.minimum) / (root.maximum - root.minimum) * parent.width;
                border-radius: 2px;
                background: Theme.accent;
            }
            Rectangle {
                // thumb
                x: (root.value - root.minimum) / (root.maximum - root.minimum) * parent.width - 7px;
                y: 0;
                width: 14px; height: 18px;
                border-radius: 4px;
                background: touch.has-hover ? Theme.accent-strong : Theme.accent;
                animate x { duration: 60ms; }
            }
        }
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected: 0;
    callback changed(int);

    height: 36px;
    HorizontalLayout {
        spacing: 4px;
        Rectangle { horizontal-stretch: 1; }
        for opt[i] in root.options : Rectangle {
            width: 96px;
            border-radius: 8px;
            background: i == root.selected ? Theme.accent-soft : (touch.has-hover ? #ffffff1a : #ffffff0a);
            border-width: 1px;
            border-color: i == root.selected ? Theme.accent : #00000000;
            // `.segmented__option` (app.css L753).
            animate background { duration: Theme.fast; }
            animate border-color { duration: Theme.fast; }
            touch := TouchArea {
                clicked => { root.changed(i); }
            }
            Text {
                text: opt; color: i == root.selected ? Theme.accent : Theme.muted; font-size: 13px; font-weight: 600;
                width: parent.width; height: parent.height;
                horizontal-alignment: center; vertical-alignment: center;
                animate color { duration: Theme.fast; }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

export component Chip inherits Rectangle {
    in property <string> label;
    in property <color> hue: Theme.accent;
    in property <bool> selected: false;
    in property <bool> compact: false;
    in property <bool> removable: false;
    callback toggled();
    callback removed();

    height: root.compact ? 18px : 26px;
    // Hug the label. The pill is mostly a read-out (a stored reading, a day,
    // a tag), so it must not soak up a `space-between` row's leftover width
    // -- which is what clipped the Data tab's App version stamp. Measured
    // from the content layout, the way `Badge` measures its text.
    horizontal-stretch: 0;
    width: chip-content.preferred-width;
    touch := TouchArea {
        clicked => { root.toggled(); }
    }
    Rectangle {
        border-radius: root.compact ? 6px : 999px;
        background: root.selected ? Theme.accent-soft : #ffffff0a;
        border-width: 1px;
        border-color: root.selected ? Theme.accent-soft : Theme.border;
        // `.chip` (app.css L1690's micro list): background, border and colour.
        animate background { duration: Theme.fast; }
        animate border-color { duration: Theme.fast; }
        chip-content := HorizontalLayout {
            padding-left: root.compact ? 6px : 10px;
            padding-right: root.compact ? 6px : 10px;
            spacing: 4px;
            alignment: center;
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.hue; }
            Text { text: root.label; color: root.selected ? Theme.accent : Theme.muted;
                   font-size: root.compact ? 11px : 12px; font-weight: 600;
                   vertical-alignment: center; }
            if root.removable : Rectangle {
                width: 14px; height: 14px;
                cloze := TouchArea { clicked => { root.removed(); } }
                Text { text: "×"; color: Theme.faint; font-size: 12px; width: parent.width; height: parent.height;
                       horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
}

export component Badge inherits Rectangle {
    in property <string> label;
    in property <int> tone: 0; // 0 neutral, 1 warn, 2 danger, 3 good, 4 info

    height: 18px;
    // Sits at its text's own width. `horizontal-stretch: 0` on its own is
    // not enough: the parent row still hands the pill whatever width it has
    // spare, which is how a three-character "2FA" ends up a bar 110px across.
    horizontal-stretch: 0;
    // Measured from the text, which is a *direct* child with no width of its
    // own. Sizing the text from its parent instead would close the loop --
    // parent sized by text, text sized by parent -- and the pill would grow
    // to fill the card.
    width: badge-text.preferred-width + 16px;
    border-radius: 9px;
    background: root.tone == 2 ? Theme.danger-soft :
                root.tone == 1 ? #ffffff0d :
                root.tone == 3 ? Theme.good-soft :
                (root.tone == 4 ? Theme.accent-soft : #ffffff0a);

    badge-text := Text {
        x: 8px;
        height: parent.height;
        text: root.label;
        color: root.tone == 2 ? Theme.danger :
               root.tone == 1 ? Theme.danger :
               root.tone == 3 ? Theme.good :
               (root.tone == 4 ? Theme.accent : Theme.faint);
        font-size: 11px; font-weight: 600;
        vertical-alignment: center;
    }
}

export component StrengthMeter inherits Rectangle {
    // The score is computed in Rust, not here: `estimateStrength` reads a
    // word list and a common-password list that have no business living in
    // a .slint file, and every call site must get the same answer.
    in property <int> score: -1;   // -1 = no password typed yet
    in property <string> label;
    in property <string> bits;
    in property <string> crack-time;

    vertical-stretch: 0;
    VerticalLayout {
        spacing: 5px;

        HorizontalLayout {
            spacing: 3px;
            for i in 5 : Rectangle {
                horizontal-stretch: 1;
                height: 4px;
                border-radius: 2px;
                background: root.score >= 0 && i <= root.score
                    ? (root.score <= 1 ? Theme.danger :
                       root.score == 2 ? Theme.warn : Theme.accent)
                    : Theme.hairline;
                // `.strength__seg` lights over `--normal` (app.css L674), so
                // the meter climbs rather than jumps as a password is typed.
                animate background { duration: Theme.normal; }
            }
        }

        // Nothing to read out until something is typed: a meter that says
        // "very weak" about an empty field is judging a form, not a password.
        if (root.score >= 0) : HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.label;
                color: root.score <= 1 ? Theme.danger :
                       root.score == 2 ? Theme.warn : Theme.accent;
                font-size: 12px;
                font-weight: 600;
            }

            Text {
                text: "~" + root.bits + " bits · cracked in " + root.crack-time;
                color: Theme.faint;
                font-size: 11.5px;
                overflow: elide;
                horizontal-alignment: right;
            }
        }
    }
}

export component EmptyState inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <string> action: "";
    callback action-clicked();
    VerticalLayout {
        alignment: center; spacing: 6px;
        horizontal-stretch: 1; vertical-stretch: 1;
        if title != "" : Text { text: root.title; color: Theme.text; font-size: 16px;
                                font-weight: 600; horizontal-alignment: center; }
        if hint != "" : Text { text: root.hint; color: Theme.muted; font-size: 13.5px;
                                horizontal-alignment: center; wrap: word-wrap; }
        if root.action != "" : Btn {
            label: root.action; kind: 1; h: 36px;
            clicked => { root.action-clicked(); }
        }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px; height: 32px;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Rectangle {
        background: touch.has-hover ? #ffffff1a : #ffffff0a;
        border-radius: 8px;
        Text { text: root.icon; color: Theme.muted; font-size: 14px;
               width: parent.width; height: parent.height;
               horizontal-alignment: center; vertical-alignment: center; }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// The small caption above a field, as `.field__label` in the TS app.
export component Label inherits Rectangle {
    in property <string> text;
    height: 18px;
    vertical-stretch: 0;
    Text {
        // Pinned to the left on purpose. Without a width the Text is sized to
        // its own text, and an element that sets a size inside a `Rectangle`
        // is *centred* -- which is how a field label ended up in the middle
        // of the panel above its own input.
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.4px;
        vertical-alignment: bottom;
    }
}

// The quiet line under a field, as `.field__note`.
export component Note inherits Rectangle {
    in property <string> text;
    vertical-stretch: 0;
    height: note-text.preferred-height;
    note-text := Text {
        width: parent.width;
        text: root.text;
        color: Theme.faint;
        font-size: 12px;
        wrap: word-wrap;
    }
}

// A multi-line field. `single-line: false` is what makes the TextInput hold
// newlines at all -- by default it renders every one of them as a space.
export component Area inherits Rectangle {
    in-out property <string> value;
    in property <string> placeholder;
    in property <int> lines: 5;
    callback edited();

    // `lines` lines at the field's own line height, plus the padding.
    height: 22px * root.lines + 20px;
    vertical-stretch: 0;
    border-radius: 10px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: input.has-focus ? Theme.field-focus : Theme.field;
    clip: true;

    Text {
        visible: root.value == "" && !input.has-focus;
        x: 14px; y: 10px;
        width: parent.width - 28px;
        text: root.placeholder;
        color: Theme.faint;
        font-size: 14px;
        wrap: word-wrap;
    }

    input := TextInput {
        x: 14px; y: 10px;
        width: parent.width - 28px;
        height: parent.height - 20px;
        single-line: false;
        wrap: word-wrap;
        text <=> root.value;
        color: Theme.text;
        font-size: 14px;
        line-height-factor: 1.45;
        selection-background-color: Theme.accent-soft;
        selection-foreground-color: #0d1420;
        edited => { root.edited(); }
    }
}

// The overlay a dialog sits on: a dim wash over the whole window, a plate
// centred on it, a title with a close button, and the caller's rows as the
// body. `.overlay` (app.css L726) plus `.modal__header` / `.modal__body`.
//
// The body is `@children` -- one slot, so a dialog that needs a footer puts
// its own row last and the plate hugs it, since nothing here scrolls.
//
// Moved here from `settings.slint` when Settings › Channels' shared editor
// needed the same shell: one wash, one plate, one hairline, so the two
// cannot drift.
export component Modal inherits Rectangle {
    in property <string> title;
    // The editor's own plate is wider than a settings sheet's: 780px in
    // `ChannelEditor.tsx`'s `modal--wide`, against the sheets' 540px.
    in property <bool> wide: false;
    callback closed();

    // No width/height binding: a plain child fills its parent by default,
    // and `parent` is not an accessible id from a component's own root
    // anyway. The plate below does the centring off this root's size.

    // `.overlay`'s dim wash, on the root so every pixel the dialog does not
    // cover is dimmed: app.css L726's `#05060b9e`, or the light theme's
    // `#3d568f4d`. Slint rectangles have no `backdrop-filter`, so the 4px
    // blur the CSS puts behind the wash is the one part not drawn.
    background: Theme.resolved-theme == "light" ? #3d568f4d : #05060b9e;

    // In the TS a click closes only when it lands on the backdrop itself
    // (`e.target === e.currentTarget`); here the plate above intercepts
    // everything inside the dialog.
    backdrop := TouchArea {
        clicked => { root.closed(); }
    }

    plate := Rectangle {
        width: min(root.wide ? 780px : 540px, parent.width - 60px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        height: column.preferred-height;
        border-radius: Theme.radius-xl;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.bg;
        clip: true;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 14px;

        column := VerticalLayout {
            // `.modal__header`: title, close button.
            HorizontalLayout {
                padding-top: 16px;
                padding-bottom: 14px;
                padding-left: 22px;
                padding-right: 16px;
                spacing: 12px;

                Text {
                    horizontal-stretch: 1;
                    text: root.title;
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 600;
                    vertical-alignment: center;
                    min-height: 27px;
                }

                IconButton {
                    horizontal-stretch: 0;
                    icon: "×";
                    clicked => { root.closed(); }
                }
            }

            // `.modal__header`'s border-bottom.
            Rectangle {
                width: parent.width;
                height: 1px;
                background: Theme.hairline;
            }

            // `.modal__body`: the caller's rows.
            VerticalLayout {
                padding-top: 18px;
                padding-bottom: 6px;
                padding-left: 22px;
                padding-right: 22px;
                spacing: 14px;

                @children
            }
        }
    }
}

