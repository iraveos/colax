{
  "name": "colax",
  "private": true,
  "version": "1.0.42",
  "type": "module",
  "description": "Colax — a local-first, zero-knowledge password vault. Runs in the browser today, portable to a native app later.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test --test-timeout=40000 test/*.test.ts",
    "dev:electron": "node scripts/electron-dev.mjs",
    "build:electron": "npm run build && node scripts/electron-build.mjs",
    "check:render": "npm run build:electron && electron . --render-check",
    "check:memory": "npm run build:electron && electron . --memory-report",
    "dist:electron": "npm run build:electron && electron-builder --win && node scripts/copy-installer.mjs"
  },
  "build": {
    "appId": "app.colax.vault",
    "productName": "Colax",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/colax-icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Colax"
    }
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.16",
    "imapflow": "^2.2.11",
    "motion": "^12.43.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
